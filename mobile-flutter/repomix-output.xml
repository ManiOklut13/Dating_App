          ClipRRect(
            borderRadius: BorderRadius.circular(8),
            child: SizedBox(
              height: 14,
              child: Row(
                children: [
                  Flexible(
                    flex: proposerPct,
                    child: Container(
                      decoration: const BoxDecoration(
                        gradient: PDGradients.primary,
                      ),
                    ),
                  ),
                  Flexible(
                    flex: partnerPct,
                    child: Container(
                      color: PDColors.textViolet.withValues(alpha: 0.35),
                    ),
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 14),
          // ── Percentage labels ─────────────────────────────────────────────
