<file path="lib/features/plan_date/data/memory_storage_service.dart">
import 'dart:async';
import 'dart:typed_data';

import 'package:flutter/foundation.dart';

// ─────────────────────────────────────────────────────────────────────────────
// Memory photo storage — abstraction first so the UI stays backend-free.
//
// The mock simulates compression and streams upload progress 0..1 for each
// photo slot. Swap the provider for a real implementation (S3/GCS/Firebase)
// without touching the screens.
// ─────────────────────────────────────────────────────────────────────────────

abstract class MemoryStorageService {
  /// Compresses and uploads the photo; reports progress 0..1. Returns the
  /// uploaded reference (url/id) to store on the [Memory].
  Future<String> uploadMemoryPhoto(
    Uint8List bytes,
    String fileName, {
    void Function(double progress)? onProgress,
  });
}

/// Mock: simulates compression latency and progress ticks, and returns a
/// deterministic local reference. In debug builds it also keeps the bytes in
/// memory so previews survive.
class MockMemoryStorageService implements MemoryStorageService {
  @override
  Future<String> uploadMemoryPhoto(
    Uint8List bytes,
    String fileName, {
    void Function(double progress)? onProgress,
  }) async {
    // Simulated compression step (real impl: flutter_image_compress / server).
    await Future<void>.delayed(const Duration(milliseconds: 250));

    // Simulated chunked upload with progress.
    const chunks = 8;
    for (var i = 1; i <= chunks; i++) {
      await Future<void>.delayed(const Duration(milliseconds: 60));
      onProgress?.call(i / chunks);
    }
    if (kDebugMode) {
      debugPrint('MockMemoryStorageService: uploaded $fileName '
          '(${bytes.lengthInBytes} bytes, simulated compression)');
    }
    return 'mock-photo-$fileName-${bytes.lengthInBytes}';
  }
}
</file>

<file path="lib/features/plan_date/data/place_search_service.dart">
import 'package:dio/dio.dart';

import 'plan_date_repository.dart';

// ─────────────────────────────────────────────────────────────────────────────
// Place search — Photon (primary) with Nominatim fallback.
//
// Public services: respect usage limits (debounce lives in the provider,
// limit=5 results, a single request per keystroke settled) and send a proper
// User-Agent identifying the app.
// ─────────────────────────────────────────────────────────────────────────────

/// Interface so the UI can swap providers or mock it in tests.
abstract class PlaceSearchService {
  Future<List<SearchedPlace>> search(String query);
}

class OpenPlaceSearchService implements PlaceSearchService {
  OpenPlaceSearchService({required PlanDateConfig config})
      : _userAgent = config.osmUserAgent;

  final String _userAgent;

  Dio get _dio => Dio(BaseOptions(
        connectTimeout: const Duration(seconds: 6),
        receiveTimeout: const Duration(seconds: 8),
        headers: {'User-Agent': _userAgent},
      ));

  @override
  Future<List<SearchedPlace>> search(String query) async {
    final q = query.trim();
    if (q.length < 3) return const [];
    // Photon first, Nominatim as fallback.
    try {
      return await _photon(q);
    } on Exception {
      return _nominatim(q);
    }
  }

  Future<List<SearchedPlace>> _photon(String q) async {
    final res = await _dio.get<Map<String, dynamic>>(
      'https://photon.komoot.io/api/',
      queryParameters: {'q': q, 'limit': 5},
    );
    final features = (res.data?['features'] as List<dynamic>? ?? const [])
        .whereType<Map<String, dynamic>>();
    return features.map(_fromPhotonFeature).whereType<SearchedPlace>().toList();
  }

  SearchedPlace? _fromPhotonFeature(Map<String, dynamic> feature) {
    final geometry = feature['geometry'] as Map<String, dynamic>?;
    final coords = geometry?['coordinates'] as List<dynamic>?;
    final props = (feature['properties'] as Map<String, dynamic>? ?? const {});
    if (coords == null || coords.length < 2) return null;
    final fallback =
        props['city'] as String? ?? props['country'] as String? ?? '';
    final name = (props['name'] as String?) ?? fallback;
    if (name.isEmpty) return null;
    final kind =
        (props['osm_value'] as String?) ?? (props['kind'] as String?) ?? 'place';
    final address = [
      props['street'],
      props['district'],
      props['city'],
      props['country'],
    ].whereType<String>().where((s) => s.isNotEmpty).join(', ');
    return SearchedPlace(
      name: name,
      kind: kind,
      lat: (coords[1] as num).toDouble(),
      lng: (coords[0] as num).toDouble(),
      address: address,
    );
  }

  Future<List<SearchedPlace>> _nominatim(String q) async {
    final res = await _dio.get<List<dynamic>>(
      'https://nominatim.openstreetmap.org/search',
      queryParameters: {'q': q, 'format': 'jsonv2', 'limit': 5},
      options: Options(headers: {'User-Agent': _userAgent}),
    );
    return (res.data ?? const [])
        .whereType<Map<String, dynamic>>()
        .map((row) {
          final display = row['display_name'] as String? ?? '';
          final parts = display.split(', ');
          final name = row['name'] as String? ??
              (parts.isNotEmpty ? parts.first : '');
          if (name.isEmpty) return null;
          return SearchedPlace(
            name: name,
            kind: row['type'] as String? ?? row['category'] as String? ?? 'place',
            lat: double.tryParse(row['lat'].toString()) ?? 0,
            lng: double.tryParse(row['lon'].toString()) ?? 0,
            address: parts.skip(1).join(', '),
          );
        })
        .whereType<SearchedPlace>()
        .toList();
  }
}
