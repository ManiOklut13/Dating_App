      id: 'msg-${DateTime.now().millisecondsSinceEpoch}',
      senderId: 'me',
      body: text.trim(),
      timestamp: 'Just now',
      isMe: true,
      type: type,
      mediaUrl: mediaUrl,
    );

    _conversations = _conversations.map((c) {
      if (c.id == conversationId) {
        final updatedMsgs = List<ChatMessageModel>.from(c.messages)..add(newMsg);
