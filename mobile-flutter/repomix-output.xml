                  style: TextStyle(fontSize: 24, fontWeight: FontWeight.w900, color: Colors.white),
                ),
                const SizedBox(height: 6),
                Text(
                  '${widget.isVideo ? 'Video' : 'Audio'} session with ${widget.userName}',
