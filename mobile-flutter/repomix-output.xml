                  fontStyle: FontStyle.italic,
                  height: 1.4,
                ),
              ),
            ),
            const SizedBox(height: 40),

            GestureDetector(
              onTap: (_isRecording || _isVerified) ? null : _startVoiceCheck,
              child: Container(
                width: 96,
                height: 96,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: _isVerified
                      ? Colors.green
                      : (_isRecording
                          ? Colors.amber[700]
                          : const Color(0xFFFF2E55)),
                  boxShadow: [
                    BoxShadow(
                      color: const Color(0xFFFF2E55).withOpacity(0.45),
                      blurRadius: 24,
                    ),
                  ],
                ),
                child: Icon(
                  _isVerified ? Icons.check_rounded : Icons.mic_rounded,
                  color: Colors.white,
                  size: 44,
                ),
              ),
            ),
            const SizedBox(height: 16),
            Text(
              _isRecording
                  ? 'Listening... Speak clearly'
                  : (_isVerified
                      ? 'Voice Verified Successfully!'
                      : 'Tap Mic to Start'),
              style: TextStyle(
                color: _isVerified ? Colors.greenAccent : Colors.white70,
                fontWeight: FontWeight.bold,
                fontSize: 15,
              ),
            ),
            const Spacer(),

            SizedBox(
              width: double.infinity,
              height: 56,
              child: ElevatedButton(
                style: ElevatedButton.styleFrom(
                  backgroundColor: _isVerified
                      ? const Color(0xFFFF2E55)
                      : Colors.grey[850],
                  foregroundColor: Colors.white,
                  shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(16)),
                ),
                onPressed: _isVerified
                    ? () {
                        Navigator.pushNamedAndRemoveUntil(
                            context, '/home', (route) => false);
                      }
