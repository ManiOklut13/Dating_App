import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../models/plan_date_models.dart';
import '../providers/plan_date_providers.dart';
import '../theme/plan_date_tokens.dart';

// ─────────────────────────────────────────────────────────────────────────────
// Date Type — horizontally scrollable 104x92 cards, single select, scroll
// snap, no visible scrollbar, "Swipe for more" hint. Loaded from the repo.
// ─────────────────────────────────────────────────────────────────────────────

const double _cardW = 104;
const double _cardH = 92;

class DateTypeSelector extends ConsumerWidget {
  const DateTypeSelector({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final draft = ref.watch(planDraftProvider);
    final catalogAsync = ref.watch(dateTypeCatalogProvider);

    return PlanCard(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const PlanSectionHeaderWrap(title: 'Date Type'),
          const SizedBox(height: 12),
          catalogAsync.when(
            loading: () => const SizedBox(
              height: _cardH,
              child: Center(
                child: CircularProgressIndicator(
                  color: PlanColors.accent,
                  strokeWidth: 2,
                ),
              ),
            ),
            error: (e, _) => _TypesError(onRetry: () {
              ref.invalidate(dateTypeCatalogProvider);
            }),
            data: (catalog) {
              final types = catalog.where((t) => t.vMode == draft.mode).toList();
              // Keep selection valid when the catalog for this mode lacks the
              // previously picked type (cross-mode types keep the selection).
              final selectedId = draft.typeOption?.id;
              return Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  _TypeCardRow(types: types, selectedId: selectedId),
                  const SizedBox(height: 8),
                  Center(
                    child: Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Icon(Icons.swipe_left_rounded,
                            size: 14, color: PlanColors.muted),
                        const SizedBox(width: 4),
                        Text('Swipe for more', style: PlanText.t(11, color: PlanColors.muted)),
                        const SizedBox(width: 4),
                        Icon(Icons.swipe_right_rounded,
                            size: 14, color: PlanColors.muted),
                      ],
                    ),
                  ),
                ],
              );
            },
          ),
        ],
      ),
    );
  }
}

class PlanSectionHeaderWrap extends StatelessWidget {
  const PlanSectionHeaderWrap({required this.title, super.key});

  final String title;

  @override
  Widget build(BuildContext context) =>
      Text(title, style: PlanText.sectionLabel);
}

class _TypeCardRow extends ConsumerStatefulWidget {
  const _TypeCardRow({required this.types, required this.selectedId});

  final List<DateTypeOption> types;
  final String? selectedId;

  @override
  ConsumerState<_TypeCardRow> createState() => _TypeCardRowState();
}

class _TypeCardRowState extends ConsumerState<_TypeCardRow> {
  final _controller = ScrollController();

  /// Card pitch = width + spacing; used to snap after scroll ends.
  static const double _pitch = _cardW + 10;

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  void _snap() {
    if (!_controller.hasClients) return;
    final target = (_controller.offset / _pitch).round() * _pitch;
    _controller.animateTo(
      target.clamp(0.0, _controller.position.maxScrollExtent),
      duration: const Duration(milliseconds: 220),
      curve: Curves.easeOutCubic,
    );
  }

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      height: _cardH,
      child: NotificationListener<ScrollEndNotification>(
        onNotification: (_) {
          _snap();
          return false;
        },
        child: ListView.separated(
          controller: _controller,
          scrollDirection: Axis.horizontal,
          itemCount: widget.types.length,
          separatorBuilder: (_, _) => const SizedBox(width: 10),
          itemBuilder: (context, i) => _TypeCard(
            type: widget.types[i],
            selected: widget.types[i].id == widget.selectedId,
          ),
        ),
      ),
    );
  }
}

class _TypeCard extends ConsumerWidget {
  const _TypeCard({required this.type, required this.selected});

  final DateTypeOption type;
  final bool selected;

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    return Semantics(
      label: 'Date type ${type.label}',
      button: true,
      selected: selected,
      child: GestureDetector(
        onTap: () => ref.read(planDraftProvider.notifier).setType(type),
        child: AnimatedContainer(
          width: _cardW,
          height: _cardH,
          duration: const Duration(milliseconds: 180),
          decoration: BoxDecoration(
            gradient: selected ? PlanColors.gradient : null,
            color: selected ? null : PlanColors.bg,
            borderRadius: BorderRadius.circular(PlanDims.ctrlRadiusLg),
            border: Border.all(
              color: selected ? Colors.transparent : PlanColors.border,
            ),
            boxShadow: selected ? PlanColors.pinkGlowSmall : null,
          ),
          padding: const EdgeInsets.symmetric(horizontal: 8),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(type.emoji, style: const TextStyle(fontSize: 26)),
              const SizedBox(height: 6),
              Text(
                type.label,
                textAlign: TextAlign.center,
                maxLines: 2,
                overflow: TextOverflow.ellipsis,
                style: PlanText.t(
                  11,
                  w: selected ? FontWeight.w700 : FontWeight.w600,
                  color: selected ? Colors.white : PlanColors.muted,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _TypesError extends StatelessWidget {
  const _TypesError({required this.onRetry});

  final VoidCallback onRetry;

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      height: _cardH,
      child: Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Text('Could not load date types.', style: PlanText.bodyMuted),
            const SizedBox(height: 8),
