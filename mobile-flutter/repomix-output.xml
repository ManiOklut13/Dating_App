              onPressed: onRetry,
              style: TextButton.styleFrom(
                foregroundColor: PlanColors.accent,
                minimumSize: const Size(PlanDims.minTouch, PlanDims.minTouch),
              ),
              child: const Text('Retry'),
            ),
          ],
        ),
      ),
    );
  }
}
