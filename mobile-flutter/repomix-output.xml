/// Read-only product config for the feature.
class PlanDateConfig {
  const PlanDateConfig({
    required this.coinCost,
    required this.osmTileUrl,
    required this.osmUserAgent,
  });

  /// Coins charged for proposing a date.
  final int coinCost;

  /// Public OSM tile server is light-use only — make it configurable for a
  /// production tile provider.
  final String osmTileUrl;

  /// Respect OSM tile policy: a describable User-Agent.
  final String osmUserAgent;
}

/// Interface for plan persistence.
abstract class PlanDateRepository {
  PlanDateConfig get config;

  /// Date-type catalog and partner list come from the "backend", not literals
  /// sprinkled through the UI.
  Future<List<DateTypeOption>> fetchDateTypeCatalog();
  Future<List<Partner>> fetchPartners();

  /// Charges coins and creates the proposal; the returned plan is then
  /// observable through [watchPlan] (mock: partner auto-accepts shortly).
  Future<PlanDate> proposePlan(PlanDate plan);
  Stream<PlanDate> watchPlan(String planId);
  Future<List<PlanDate>> fetchMyPlans();

  Future<void> saveMemory(Memory memory);
}

/// Mock implementation — deterministic, in-memory, light delays.
class MockPlanDateRepository implements PlanDateRepository {
  MockPlanDateRepository();

  final Map<String, PlanDate> _plans = {};
  final Map<String, List<StreamController<PlanDate>>> _watchers = {};
  final List<Memory> _memories = [];

  static PlanDateConfig _config = const PlanDateConfig(
    coinCost: 150,
    osmTileUrl: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
    osmUserAgent: 'YoUnMeMobile/3.2 (plan-a-date demo; contact dev@younme.app)',
  );

  // For tests: allow deterministic configs.
  void overrideConfig(PlanDateConfig cfg) => _config = cfg;

  @override
  PlanDateConfig get config => _config;

  @override
  Future<List<DateTypeOption>> fetchDateTypeCatalog() async {
    await Future<void>.delayed(const Duration(milliseconds: 350));
    // Virtual types.
    const virtual = [
      ('dt-movie', 'Movie Night', '🎬'),
      ('dt-dinner', 'Dinner', '🍽️'),
      ('dt-coffee', 'Coffee', '☕'),
      ('dt-game', 'Game Night', '🎮'),
      ('dt-stars', 'Stargazing', '✨'),
      ('dt-music', 'Music Jam', '🎸'),
      ('dt-cook', 'Cook Together', '👩‍🍳'),
      ('dt-park', 'Park Walk', '🌳'),
      ('dt-karaoke', 'Karaoke', '🎤'),
      ('dt-dessert', 'Dessert', '🍰'),
      ('dt-art', 'Art & Paint', '🎨'),
      ('dt-book', 'Book Chat', '📚'),
    ];
    // Offline types.
    const offline = [
      ('dt-dinner', 'Dinner', '🍽️'),
      ('dt-coffee', 'Coffee', '☕'),
      ('dt-movie', 'Movie Night', '🎬'),
      ('dt-park', 'Park Walk', '🌳'),
      ('dt-dessert', 'Dessert', '🍰'),
      ('dt-live', 'Live Music', '🎶'),
      ('dt-bowling', 'Bowling', '🎳'),
      ('dt-art', 'Art & Paint', '🎨'),
      ('dt-picnic', 'Picnic', '🧺'),
    ];
    return [
      for (final vt in virtual)
        DateTypeOption(id: vt.$1, label: vt.$2, emoji: vt.$3, vMode: DateMode.virtual),
      for (final ot in offline)
        DateTypeOption(id: ot.$1, label: ot.$2, emoji: ot.$3, vMode: DateMode.offline),
    ];
  }

  @override
  Future<List<Partner>> fetchPartners() async {
    await Future<void>.delayed(const Duration(milliseconds: 250));
    return const [
      Partner(
        id: 'partner-ananya',
        name: 'Ananya Sharma',
        avatarAsset: 'assets/images/ananya.jpg',
        isOnline: true,
        city: 'Bandra West',
      ),
      Partner(
        id: 'partner-riya',
        name: 'Riya Kapoor',
        avatarAsset: 'assets/images/riya.jpg',
        isOnline: true,
        city: 'Lower Parel',
      ),
      Partner(
        id: 'partner-rohit',
        name: 'Rohit Verma',
        avatarAsset: 'assets/images/rohit.jpg',
        isOnline: false,
        city: 'Andheri East',
      ),
      Partner(
        id: 'partner-aditya',
        name: 'Aditya Rao',
        avatarAsset: 'assets/images/aditya.jpg',
        isOnline: true,
        city: 'Khar Road',
      ),
    ];
  }

  @override
  Future<PlanDate> proposePlan(PlanDate plan) async {
    await Future<void>.delayed(const Duration(milliseconds: 600));
    _plans[plan.id] = plan;

    // Mock: partner auto-accepts shortly after proposal.
    Timer(const Duration(seconds: 4), () {
      final accepted = _plans[plan.id]?.copyWith(status: PlanStatus.accepted);
      if (accepted == null) return;
      _plans[plan.id] = accepted;
      _push(plan.id, accepted);
    });
    _push(plan.id, plan);
    return plan;
  }

  void _push(String planId, PlanDate plan) {
    for (final c in _watchers[planId] ?? const []) {
      if (!c.isClosed) c.add(plan);
    }
  }

  @override
  Stream<PlanDate> watchPlan(String planId) {
    final controller = StreamController<PlanDate>.broadcast();
    _watchers.putIfAbsent(planId, () => []).add(controller);
    final cached = _plans[planId];
    if (cached != null) {
      scheduleMicrotask(() => controller.add(cached));
    }
    controller.onCancel = () => _watchers[planId]?.remove(controller);
    return controller.stream;
  }

  @override
  Future<List<PlanDate>> fetchMyPlans() async {
    await Future<void>.delayed(const Duration(milliseconds: 250));
    return _plans.values.toList(growable: false);
  }

  @override
  Future<void> saveMemory(Memory memory) async {
    await Future<void>.delayed(const Duration(milliseconds: 400));
    _memories.add(memory);
  }

  List<Memory> get savedMemories => List.unmodifiable(_memories);
}

/// Mock partners' representative coordinates (Bengaluru-ish) for the offline
/// map. "Me" is derived in the providers from these until a real location is
/// granted.
const double kMockCenterLat = 12.9716;
const double kMockCenterLng = 77.5946;

class MockLocations {
  static ({double lat, double lng}) forPartner(String partnerId) {
    // Spread pins deterministically around the mock center.
    final seed = partnerId.hashCode.abs() % 1000 / 1000.0;
    return (
      lat: kMockCenterLat + (seed - 0.5) * 0.02,
      lng: kMockCenterLng + ((partnerId.hashCode % 977) / 977.0 - 0.5) * 0.02,
    );
  }

  static ({double lat, double lng}) get me => (
        lat: kMockCenterLat - 0.008,
        lng: kMockCenterLng + 0.006,
      );

  static List<String> get suggestedSpotNames => const [
        'Cubbon Park',
        'Subko Coffee, Church Street',
        'Trifecta Dance Museum',
        'Lalbagh Botanical Garden',
      ];

  /// Deterministic mock spot coordinates for the suggestion chips.
  static ({double lat, double lng}) forSuggestion(String name) {
    final h = name.hashCode.abs();
    return (
      lat: kMockCenterLat + ((h % 641) / 641.0 - 0.5) * 0.03,
      lng: kMockCenterLng + ((h % 733) / 733.0 - 0.5) * 0.03,
    );
  }

  static double distanceBetween({
    required double lat1,
    required double lng1,
    required double lat2,
    required double lng2,
  }) {
    // Haversine, kilometers.
    const r = 6371.0;
    double rad(double d) => d * pi / 180;
    final dLat = rad(lat2 - lat1);
    final dLng = rad(lng2 - lng1);
    final a = sin(dLat / 2) * sin(dLat / 2) +
        cos(rad(lat1)) * cos(rad(lat2)) * sin(dLng / 2) * sin(dLng / 2);
    return 2 * r * asin(sqrt(a));
  }
}
