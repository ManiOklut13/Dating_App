                    Icon(
                      Icons.send_outlined,
                      color: widget.enabled ? Colors.white : const Color(0xFF8E88A3),
                      size: 20,
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: Text(
                        label,
                        style: TextStyle(
                          fontFamily: 'Inter',
                          fontSize: 15,
                          fontWeight: FontWeight.w700,
                          color: widget.enabled ? Colors.white : const Color(0xFF8E88A3),
