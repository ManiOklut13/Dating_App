class _HistoryTile extends StatelessWidget {
  final CallHistoryEntry entry;

  const _HistoryTile({required this.entry});

  String _formatDate(DateTime dt) {
    final now = DateTime.now();
    final diff = now.difference(dt);
    if (diff.inDays == 0) {
      final h = dt.hour.toString().padLeft(2, '0');
      final m = dt.minute.toString().padLeft(2, '0');
      return 'Today $h:$m';
    } else if (diff.inDays == 1) {
      final h = dt.hour.toString().padLeft(2, '0');
      final m = dt.minute.toString().padLeft(2, '0');
      return 'Yesterday $h:$m';
    } else {
      return '${dt.day}/${dt.month}/${dt.year}';
    }
  }

  @override
  Widget build(BuildContext context) {
    final isMissed = entry.direction == CallDirection.missed;

    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 5),
      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
      decoration: BoxDecoration(
        color: const Color(0xFF111318),
        borderRadius: BorderRadius.circular(16),
        border: Border.all(
          color: isMissed
              ? const Color(0xFFFF4757).withOpacity(0.3)
              : Colors.white.withOpacity(0.07),
        ),
      ),
      child: Row(
        children: [
          // Avatar
          _AvatarWidget(user: entry.user, size: 48),
          const SizedBox(width: 14),

          // Info
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Flexible(
                      child: Text(
                        entry.user.name,
                        style: TextStyle(
                          fontSize: 15,
                          fontWeight: FontWeight.w700,
                          color: isMissed
                              ? const Color(0xFFFF4757)
                              : Colors.white,
                        ),
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                    if (entry.user.isVerified) ...[
                      const SizedBox(width: 5),
                      const Icon(Icons.verified,
                          color: Color(0xFF3B82F6), size: 14),
                    ],
                  ],
                ),
                const SizedBox(height: 4),
                Row(
                  children: [
                    Icon(entry.directionIcon,
                        color: entry.directionColor, size: 14),
                    const SizedBox(width: 4),
                    Icon(
                      entry.type == CallType.audio
                          ? Icons.phone
                          : Icons.videocam,
                      color: Colors.white38,
                      size: 14,
                    ),
                    const SizedBox(width: 4),
                    Text(
                      entry.type == CallType.audio ? 'Audio' : 'Video',
                      style: const TextStyle(
                          fontSize: 12, color: Colors.white38),
                    ),
                    if (!isMissed) ...[
                      const SizedBox(width: 8),
                      Text(
                        '· ${entry.durationLabel}',
                        style: const TextStyle(
                            fontSize: 12, color: Colors.white38),
                      ),
                    ],
                    if (entry.isDemo) ...[
                      const SizedBox(width: 8),
                      Container(
                        padding: const EdgeInsets.symmetric(
                            horizontal: 6, vertical: 1),
                        decoration: BoxDecoration(
                          color: Colors.white.withOpacity(0.06),
                          borderRadius: BorderRadius.circular(6),
                        ),
                        child: const Text(
                          'DEMO',
                          style: TextStyle(
                            fontSize: 9,
                            color: Colors.white30,
                            fontWeight: FontWeight.bold,
                            letterSpacing: 0.8,
                          ),
                        ),
                      ),
                    ],
                  ],
                ),
              ],
            ),
          ),

          // Date
          Text(
            _formatDate(entry.timestamp),
            style: const TextStyle(fontSize: 11, color: Colors.white30),
          ),
        ],
      ),
    );
  }
}

