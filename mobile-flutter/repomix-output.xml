import 'package:flutter/material.dart';
import '../models/discovery_connect_models.dart';

/// Safe image loader that gracefully falls back to a working portrait if an asset or URL fails
class SafeProfileImage extends StatelessWidget {
  final String imageUrl;
  final double? width;
  final double? height;
  final BoxFit fit;
  final BorderRadius? borderRadius;

  const SafeProfileImage({
    super.key,
    required this.imageUrl,
    this.width,
    this.height,
    this.fit = BoxFit.cover,
    this.borderRadius,
  });

  static const String _fallbackUrl =
      'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80';

  @override
  Widget build(BuildContext context) {
    Widget img;
    if (imageUrl.startsWith('http')) {
      img = Image.network(
        imageUrl,
        width: width,
        height: height,
        fit: fit,
        errorBuilder: (_, __, ___) => Image.network(
          _fallbackUrl,
          width: width,
          height: height,
          fit: fit,
          errorBuilder: (_, __, ___) => Container(
            width: width,
            height: height,
            color: const Color(0xFF2B091C),
            alignment: Alignment.center,
            child: const Icon(Icons.person, color: Color(0xFFFF8DA1), size: 28),
          ),
        ),
      );
    } else {
      final cleanPath = imageUrl.startsWith('/')
          ? 'assets/images$imageUrl'
          : imageUrl;
      img = Image.asset(
        cleanPath,
        width: width,
        height: height,
        fit: fit,
        errorBuilder: (_, __, ___) => Image.network(
          _fallbackUrl,
          width: width,
          height: height,
          fit: fit,
        ),
      );
    }

    if (borderRadius != null) {
      return ClipRRect(borderRadius: borderRadius!, child: img);
    }
    return img;
  }
}

