import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../models/plan_date_models.dart';
import '../providers/plan_date_providers.dart';
import '../theme/plan_date_tokens.dart';
import '../utils/format.dart';

// ─────────────────────────────────────────────────────────────────────────────
// Date & Time card: 7-day week strip (past disabled, today default), steppers
// for hour (1-12), minutes (0/15/30/45), AM/PM; plus the Duration card with
// 15-min steps and quick chips.
// ─────────────────────────────────────────────────────────────────────────────

class DateTimeSection extends ConsumerWidget {
  const DateTimeSection({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final draft = ref.watch(planDraftProvider);
    final notifier = ref.read(planDraftProvider.notifier);

    return PlanCard(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const PlanSectionHeaderWrap(title: 'Date & Time'),
          const SizedBox(height: 12),
          _WeekStrip(
            selectedDay: draft.day,
            onSelected: notifier.setDay,
          ),
          const SizedBox(height: 12),
          Row(
            children: [
              Expanded(
                child: _Stepper(
                  label: 'Hour',
                  value: draft.hour.toString().padLeft(2, '0'),
                  onMinus: () => notifier.bumpHour(-1),
                  onPlus: () => notifier.bumpHour(1),
                ),
              ),
              const SizedBox(width: 8),
              Expanded(
                child: _Stepper(
                  label: 'Minute',
                  value: draft.minute.toString().padLeft(2, '0'),
                  onMinus: () => notifier.bumpMinute(-15),
                  onPlus: () => notifier.bumpMinute(15),
                ),
              ),
              const SizedBox(width: 8),
              Expanded(
                child: _Stepper(
                  label: 'AM/PM',
                  value: draft.isPm ? 'PM' : 'AM',
                  onMinus: notifier.togglePeriod,
                  onPlus: notifier.togglePeriod,
                  compactTap: true,
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),
          Container(
            width: double.infinity,
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
            decoration: BoxDecoration(
              color: PlanColors.gradStart.withValues(alpha: 0.10),
              borderRadius: BorderRadius.circular(PlanDims.ctrlRadius),
              border: Border.all(color: PlanColors.gradStart.withValues(alpha: 0.35)),
            ),
            child: Text(
              planSummaryLine(
                day: draft.day ?? DateTime.now(),
                hour: draft.hour,
                minute: draft.minute,
                isPm: draft.isPm,
                durationMin: draft.durationMin,
              ),
              style: PlanText.t(13, w: FontWeight.w700, color: PlanColors.accent),
            ),
          ),
        ],
      ),
    );
  }
}

/// 7-day strip: 3 past days + today + 3 upcoming; past disabled, tap ≥44px.
class _WeekStrip extends StatelessWidget {
  const _WeekStrip({required this.selectedDay, required this.onSelected});

  final DateTime? selectedDay;
  final ValueChanged<DateTime> onSelected;

  @override
  Widget build(BuildContext context) {
    final today = DateTime.now();
    final today0 = DateTime(today.year, today.month, today.day);
    final days = List.generate(7, (i) => today0.add(Duration(days: i - 3)));

    return SizedBox(
      height: 76,
      child: Row(
        children: [
          for (final day in days)
            Expanded(
              child: _DayCell(
                day: day,
                isPast: day.isBefore(today0),
                isToday: day == today0,
                selected: _sameDay(day, selectedDay),
                onTap: () => onSelected(day),
              ),
            ),
        ],
      ),
    );
  }

  bool _sameDay(DateTime a, DateTime? b) =>
      b != null && a.year == b.year && a.month == b.month && a.day == b.day;
}

class _DayCell extends StatelessWidget {
  const _DayCell({
    required this.day,
    required this.isPast,
    required this.isToday,
    required this.selected,
    required this.onTap,
  });

  final DateTime day;
  final bool isPast;
  final bool isToday;
  final bool selected;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    final color = isPast ? PlanColors.muted.withValues(alpha: 0.45) : PlanColors.muted;

    final cell = AnimatedContainer(
      duration: const Duration(milliseconds: 160),
      margin: const EdgeInsets.symmetric(horizontal: 3),
      decoration: BoxDecoration(
        gradient: selected ? PlanColors.gradient : null,
        color: selected ? null : PlanColors.bg,
        borderRadius: BorderRadius.circular(PlanDims.ctrlRadius),
        border: Border.all(
          color: selected
              ? Colors.transparent
              : isToday
                  ? PlanColors.gradStart.withValues(alpha: 0.55)
                  : PlanColors.border,
        ),
      ),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Text(weekdayShort(day),
              style: PlanText.t(10, w: FontWeight.w600, color: color)),
          const SizedBox(height: 4),
          Text(
            '${day.day}',
            style: PlanText.t(
              15,
              w: selected ? FontWeight.w800 : FontWeight.w600,
              color: isPast
                  ? PlanColors.muted.withValues(alpha: 0.45)
                  : selected
                      ? Colors.white
                      : PlanColors.text,
            ),
          ),
        ],
      ),
    );

    if (isPast) return Opacity(opacity: 0.55, child: IgnorePointer(child: cell));

    return Semantics(
      label: 'Pick ${weekdayLong(day)}, ${monthShort(day)} ${day.day}',
      button: true,
      selected: selected,
      child: GestureDetector(
        onTap: onTap,
        behavior: HitTestBehavior.opaque,
        child: cell,
      ),
    );
  }
}

/// Generic +/- stepper with 44px-plus targets and value in the middle.
class _Stepper extends StatelessWidget {
  const _Stepper({
    required this.label,
    required this.value,
    required this.onMinus,
    required this.onPlus,
    this.compactTap = false,
  });

  final String label;
  final String value;
  final VoidCallback onMinus;
  final VoidCallback onPlus;

  /// For AM/PM the minus/plus just toggle — single semantic target.
  final bool compactTap;

  @override
  Widget build(BuildContext context) {
    final step = compactTap
        ? StepperButton(
            icon: Icons.swap_vert_rounded,
            onTap: onPlus,
            semanticLabel: 'Toggle AM or PM',
          )
        : null;

    return Column(
      children: [
        Text(label, style: PlanText.t(11, w: FontWeight.w600, color: PlanColors.muted)),
        const SizedBox(height: 6),
        Container(
          decoration: BoxDecoration(
            color: PlanColors.bg,
            borderRadius: BorderRadius.circular(PlanDims.ctrlRadius),
            border: Border.all(color: PlanColors.border),
          ),
          padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 4),
          child: Row(
            children: [
              if (!compactTap)
                StepperButton(
                  icon: Icons.remove_rounded,
                  onTap: onMinus,
                  semanticLabel: 'Decrease $label',
                ),
              if (!compactTap) const Spacer(),
              Expanded(
                child: Center(
                  child: Text(value,
                      style: PlanText.t(15, w: FontWeight.w800)),
                ),
              ),
              if (!compactTap) const Spacer(),
              if (compactTap)
                step!
              else
                StepperButton(
                  icon: Icons.add_rounded,
                  onTap: onPlus,
                  semanticLabel: 'Increase $label',
                ),
            ],
          ),
        ),
      ],
    );
  }
}

class StepperButton extends StatelessWidget {
  const StepperButton({
    required this.icon,
    required this.onTap,
    required this.semanticLabel,
    super.key,
  });

  final IconData icon;
  final VoidCallback onTap;
  final String semanticLabel;

  @override
  Widget build(BuildContext context) {
    return Semantics(
      label: semanticLabel,
      button: true,
      child: InkWell(
        onTap: onTap,
        customBorder: BorderRadius.circular(10),
        child: Container(
          width: 36,
          height: PlanDims.minTouch - 8,
          alignment: Alignment.center,
          child: Icon(icon, size: 20, color: PlanColors.accent),
        ),
      ),
    );
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Duration card.
// ─────────────────────────────────────────────────────────────────────────────

class DurationSection extends ConsumerWidget {
  const DurationSection({super.key});

  static const _virtualChips = [30, 60, 90, 120];
  static const _offlineChips = [60, 90, 120, 180];

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final draft = ref.watch(planDraftProvider);
    final notifier = ref.read(planDraftProvider.notifier);
    final chips = draft.mode == DateMode.virtual ? _virtualChips : _offlineChips;

    return PlanCard(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const PlanSectionHeaderWrap(title: 'Duration'),
          const SizedBox(height: 12),
          Row(
            children: [
              Semantics(
                label: 'Decrease duration by 15 minutes',
                button: true,
                child: _RoundBtn(
                  icon: Icons.remove_rounded,
                  onTap: () => notifier.setDuration(draft.durationMin - 15),
                ),
              ),
              Expanded(
                child: Center(
                  child: Text(
                    '${draft.durationMin} min',
                    style: PlanText.t(17, w: FontWeight.w800),
                  ),
                ),
              ),
              Semantics(
                label: 'Increase duration by 15 minutes',
                button: true,
                child: _RoundBtn(
                  icon: Icons.add_rounded,
                  onTap: () => notifier.setDuration(draft.durationMin + 15),
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),
          Row(
            children: [
              for (final c in chips) ...[
                Expanded(
                  child: _Chip(
                    label: '$c',
                    selected: draft.durationMin == c,
                    onTap: () => notifier.setDuration(c),
                  ),
                ),
                if (c != chips.last) const SizedBox(width: 8),
              ],
            ],
          ),
        ],
      ),
    );
  }
}

class _RoundBtn extends StatelessWidget {
  const _RoundBtn({required this.icon, required this.onTap});

  final IconData icon;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTap: onTap,
      customBorder: const CircleBorder(),
      child: Container(
        width: PlanDims.minTouch,
        height: PlanDims.minTouch,
        decoration: BoxDecoration(
          shape: BoxShape.circle,
          gradient: PlanColors.gradient,
          boxShadow: PlanColors.pinkGlowSmall,
        ),
        child: Icon(icon, color: Colors.white, size: 22),
      ),
    );
  }
}

class _Chip extends StatelessWidget {
  const _Chip({required this.label, required this.selected, required this.onTap});

  final String label;
  final bool selected;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return Semantics(
      label: 'Set duration $label minutes',
      button: true,
      selected: selected,
      child: GestureDetector(
        onTap: onTap,
        child: AnimatedContainer(
          height: PlanDims.minTouch,
          duration: const Duration(milliseconds: 160),
          decoration: BoxDecoration(
            gradient: selected ? PlanColors.gradient : null,
            color: selected ? null : PlanColors.bg,
            borderRadius: BorderRadius.circular(PlanDims.ctrlRadius),
            border: Border.all(
              color: selected ? Colors.transparent : PlanColors.border,
            ),
          ),
          alignment: Alignment.center,
          child: Text(
            label,
            style: PlanText.t(
              13,
              w: FontWeight.w700,
              color: selected ? Colors.white : PlanColors.muted,
            ),
          ),
        ),
      ),
    );
  }
}
