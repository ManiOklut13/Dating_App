/// Avatar widget — shows profile photo if [user.avatarUrl] is set, otherwise
/// a coloured circle with the user's initials.
class _UserAvatar extends StatelessWidget {
  final CallUser user;
  final double size;

  const _UserAvatar({required this.user, required this.size});

  String get _initials {
    final parts = user.name.trim().split(' ');
    if (parts.length >= 2) {
      return '${parts[0][0]}${parts[1][0]}'.toUpperCase();
    }
    return parts[0][0].toUpperCase();
  }

  // Deterministic colour from user id
  Color get _bgColor {
    final colors = [
      const Color(0xFF9B51E0),
      const Color(0xFFFF2D55),
      const Color(0xFF00E5FF),
      const Color(0xFFFF6B35),
      const Color(0xFF00E676),
    ];
    final idx = user.id.codeUnits.fold(0, (a, b) => a + b) % colors.length;
    return colors[idx];
  }

  @override
  Widget build(BuildContext context) {
    if (user.avatarUrl != null) {
      return Image.network(
        user.avatarUrl!,
        width: size,
        height: size,
        fit: BoxFit.cover,
        errorBuilder: (_, __, ___) => _buildInitials(),
      );
    }
    return _buildInitials();
  }

  Widget _buildInitials() {
    return Container(
      width: size,
      height: size,
      color: _bgColor,
      alignment: Alignment.center,
      child: Text(
        _initials,
        style: TextStyle(
          fontSize: size * 0.35,
          color: Colors.white,
          fontWeight: FontWeight.w800,
        ),
      ),
    );
  }
}
