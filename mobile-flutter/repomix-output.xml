/// The live draft being edited on PlanDateScreen. Shared across mode switches.
@immutable
class PlanDraft {
  const PlanDraft({
    this.partner,
    this.mode = DateMode.virtual,
    this.typeOption,
    this.day,
    this.hour = 7,
    this.minute = 30,
    this.isPm = true,
    this.durationMin = 60,
    this.todos = const [],
    this.notes = const PlanNotes(),
    this.dressCode,
    this.dressNotesMe = '',
    this.dressNotesPartner = '',
    this.splitProposerPct = 50,
    this.spot,
  });

  final Partner? partner;
  final DateMode mode;
  final DateTypeOption? typeOption;
  final DateTime? day;
  final int hour; // 1..12
  final int minute; // 0|15|30|45
  final bool isPm;
  final int durationMin;
  final List<TodoItem> todos;
  final PlanNotes notes;
  final String? dressCode;
  final String dressNotesMe;
  final String dressNotesPartner;
  final int splitProposerPct;

  /// Selected meetup spot (offline only).
  final PlanSpot? spot;

  int get partnerPct => 100 - splitProposerPct;

  /// The composed start instant (draft-local, no timezone math needed here).
  DateTime get startAt {
    final d = day ?? DateTime.now();
    final hour24 = (isPm ? (hour == 12 ? 12 : hour + 12) : (hour == 12 ? 0 : hour));
    return DateTime(d.year, d.month, d.day, hour24, minute);
  }

  /// True when the composed time is in the future.
  bool get isFuture => startAt.isAfter(DateTime.now());

  PlanDraft copyWith({
    Partner? partner,
    bool clearSpot = false,
    DateMode? mode,
    DateTypeOption? typeOption,
    DateTime? day,
    int? hour,
    int? minute,
    bool? isPm,
    int? durationMin,
    List<TodoItem>? todos,
    PlanNotes? notes,
    String? dressCode,
    String? dressNotesMe,
    String? dressNotesPartner,
    int? splitProposerPct,
    PlanSpot? spot,
  }) {
    return PlanDraft(
      partner: partner ?? this.partner,
      mode: mode ?? this.mode,
      typeOption: typeOption ?? this.typeOption,
      day: day ?? this.day,
      hour: hour ?? this.hour,
      minute: minute ?? this.minute,
      isPm: isPm ?? this.isPm,
      durationMin: durationMin ?? this.durationMin,
      todos: todos ?? this.todos,
      notes: notes ?? this.notes,
      dressCode: dressCode ?? this.dressCode,
      dressNotesMe: dressNotesMe ?? this.dressNotesMe,
      dressNotesPartner: dressNotesPartner ?? this.dressNotesPartner,
      splitProposerPct: splitProposerPct ?? this.splitProposerPct,
      spot: clearSpot ? null : (spot ?? this.spot),
    );
  }
}

