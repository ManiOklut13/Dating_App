/// Date mode. The plan screen shares every field between the two layouts.
enum DateMode { virtual, offline }

/// Lifecycle of a proposed date.
enum PlanStatus { proposed, accepted, declined, completed }

/// The person being dated.
@immutable
class Partner {
  const Partner({
    required this.id,
    required this.name,
    required this.isOnline,
