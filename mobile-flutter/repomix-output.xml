// ─────────────────────────────────────────────────────────────────────────────
// Small date/time/text formatting helpers (no intl dependency).
// ─────────────────────────────────────────────────────────────────────────────

const _weekdays = [
  'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday',
];
const _weekdaysShort = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const _monthsShort = [
  'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
];

String weekdayShort(DateTime d) => _weekdaysShort[d.weekday - 1];
String weekdayLong(DateTime d) => _weekdays[d.weekday - 1];
String monthShort(DateTime d) => _monthsShort[d.month - 1];

/// "Thursday, Oct 29 · 07:30 PM · 60 min"
String planSummaryLine({
  required DateTime day,
  required int hour,
  required int minute,
  required bool isPm,
  required int durationMin,
}) {
  final h = hour.toString().padLeft(2, '0');
  final m = minute.toString().padLeft(2, '0');
  return '${weekdayLong(day)}, ${monthShort(day)} ${day.day} · '
      '$h:$m ${isPm ? 'PM' : 'AM'} · $durationMin min';
}

/// "07:30 PM"
String clockLabel(int hour, int minute, bool isPm) =>
    '${hour.toString().padLeft(2, '0')}:'
    '${minute.toString().padLeft(2, '0')} ${isPm ? 'PM' : 'AM'}';

/// "1.2 km" / "430 m"
String distanceLabel(double km) {
  if (km < 1) return '${(km * 1000).round()} m';
  return '${km.toStringAsFixed(1)} km';
}
