import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';

// ─────────────────────────────────────────────────────────────────────────────
// Plan a Date — design tokens.
//
// Every color, radius, shadow and text style used by the feature lives here,
// so no widget hardcodes visual values. All body text meets ≥4.5:1 contrast
// on the tokens' backgrounds.
// ─────────────────────────────────────────────────────────────────────────────

/// Colors from the YoUnMe Plan-a-Date spec.
abstract final class PlanColors {
  /// Screen background.
  static const Color bg = Color(0xFF0A0610);

  /// Card surface.
  static const Color card = Color(0xFF15101C);

  /// Card border (1px).
  static const Color border = Color(0xFF2B2236);

  /// Primary text (≥12:1 on card).
  static const Color text = Color(0xFFF6F1FA);

  /// Muted secondary text (≥5.4:1 on card).
  static const Color muted = Color(0xFFB9ADC9);

  /// Pink accent text.
  static const Color accent = Color(0xFFFF7FAE);

  /// Violet accent text.
  static const Color violet = Color(0xFFC9A4FF);

  /// Success / online.
  static const Color success = Color(0xFF34D399);

  /// Gradient start.
  static const Color gradStart = Color(0xFFE8226F);

  /// Gradient end.
  static const Color gradEnd = Color(0xFFA8189B);

  /// Primary gradient (135°: top-left → bottom-right).
  static const LinearGradient gradient = LinearGradient(
    begin: Alignment.topLeft,
    end: Alignment.bottomRight,
    colors: [gradStart, gradEnd],
  );

  /// Soft pink glow used behind selected states and the CTA.
  static const List<BoxShadow> pinkGlow = [
    BoxShadow(color: Color(0x59E8226F), blurRadius: 24, offset: Offset(0, 8)),
  ];

  /// Softer glow for smaller selected controls.
  static const List<BoxShadow> pinkGlowSmall = [
    BoxShadow(color: Color(0x40E8226F), blurRadius: 12, offset: Offset(0, 4)),
  ];
}

/// Radii and spacing.
abstract final class PlanDims {
  /// Card radius.
  static const double cardRadius = 24;

  /// Radius for larger controls (buttons, big chips).
  static const double ctrlRadiusLg = 18;

  /// Radius for standard controls (fields, chips, steppers).
  static const double ctrlRadius = 14;

  /// Card horizontal padding.
  static const double cardPadding = 16;

  /// Screen horizontal padding.
  static const double screenPadding = 16;

  /// Minimum touch target per spec.
  static const double minTouch = 44;
}

/// Plus Jakarta Sans text styles (weights 500–800).
abstract final class PlanText {
  /// Base style factory.
  static TextStyle t(
    double size, {
    FontWeight w = FontWeight.w500,
    Color color = PlanColors.text,
    double? height,
    double? letterSpacing,
  }) {
    return GoogleFonts.plusJakartaSans(
      fontSize: size,
      fontWeight: w,
      color: color,
      height: height,
      letterSpacing: letterSpacing,
    );
  }

  /// 26px w800 — screen titles.
  static TextStyle get title => t(26, w: FontWeight.w800, letterSpacing: -0.5);

  /// 17px w800 — card titles.
  static TextStyle get cardTitle => t(17, w: FontWeight.w800);

  /// 14px w600 — body emphasis.
  static TextStyle get bodyEmph => t(14, w: FontWeight.w600);

  /// 13px w500 — body.
  static TextStyle get body => t(13, w: FontWeight.w500);

  /// 13px w500 muted — secondary body.
  static TextStyle get bodyMuted => t(13, w: FontWeight.w500, color: PlanColors.muted);

  /// 11px w700 — brand gradient text (header "Date").
  static TextStyle get gradientWord => t(26, w: FontWeight.w800, letterSpacing: -0.5);

  /// 12px w700 — uppercase section labels.
  static TextStyle get sectionLabel =>
      t(12, w: FontWeight.w700, color: PlanColors.muted, letterSpacing: 0.6);
}

/// Decorative background: near-black with soft pink and violet radial glows
/// at the top, per spec.
class PlanBackground extends StatelessWidget {
  const PlanBackground({required this.child, super.key});

  final Widget child;

  @override
  Widget build(BuildContext context) {
    return Container(
      color: PlanColors.bg,
      child: Stack(
        children: [
          Positioned(
            top: -120,
            left: -80,
            child: _glowCircle(280, PlanColors.gradStart.withValues(alpha: 0.16)),
          ),
          Positioned(
            top: -140,
            right: -90,
            child: _glowCircle(300, const Color(0xFFA8189B).withValues(alpha: 0.18)),
          ),
          Positioned(
            top: 90,
            right: 40,
            child: _glowCircle(140, const Color(0xFFC9A4FF).withValues(alpha: 0.07)),
          ),
          Positioned.fill(child: child),
        ],
      ),
    );
  }

  Widget _glowCircle(double size, Color color) => IgnorePointer(
        child: Container(
          width: size,
          height: size,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            gradient: RadialGradient(colors: [color, color.withValues(alpha: 0)]),
          ),
        ),
      );
}

/// Standard card container: #15101C, 1px #2B2236 border, radius 24.
class PlanCard extends StatelessWidget {
  const PlanCard({
    required this.child,
    this.padding = const EdgeInsets.all(PlanDims.cardPadding),
    this.margin,
    super.key,
  });

  final Widget child;
  final EdgeInsetsGeometry padding;
  final EdgeInsetsGeometry? margin;

  @override
  Widget build(BuildContext context) {
    return Container(
      margin: margin,
      padding: padding,
      decoration: BoxDecoration(
        color: PlanColors.card,
        borderRadius: BorderRadius.circular(PlanDims.cardRadius),
        border: Border.all(color: PlanColors.border),
      ),
      child: child,
    );
  }
}

/// Section header row inside cards: title + optional trailing widget.
class PlanSectionHeader extends StatelessWidget {
  const PlanSectionHeader({required this.title, this.trailing, super.key});

  final String title;
  final Widget? trailing;

  @override
  Widget build(BuildContext context) {
    return Row(
      children: [
        Expanded(
          child: Text(
            title,
            style: PlanText.sectionLabel,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
          ),
        ),
        if (trailing != null) trailing!,
      ],
    );
  }
}
