            display: 'flex',
            gap: '10px',
          }}
        >
          <button
            type="button"
            onClick={() => setIsEditProfileOpen(false)}
            style={{
              flex: 1,
              height: '52px',
              borderRadius: '16px',
              background: '#1a141f',
              border: '1px solid #2a2030',
              color: '#ffffff',
