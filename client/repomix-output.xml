      {/* Bottom Action Bar */}
      <div
        style={{
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          gap: '12px',
          zIndex: 10,
        }}
        onClick={(e) => e.stopPropagation()}
      >
        {!viewingPhoto.isPrimary && (
          <button
            onClick={() => {
              setPrimaryPhoto(viewingPhoto.id);
              setViewingPhoto({ ...viewingPhoto, isPrimary: true });
            }}
            className="btn-primary"
            style={{ padding: '10px 20px', fontSize: '13px', gap: '6px' }}
          >
            <Star size={15} />
            Set as Primary
          </button>
        )}

        <button
          onClick={() => {
            removePhoto(viewingPhoto.id);
            setViewingPhoto(null);
          }}
          className="btn-ghost"
          style={{ padding: '10px 18px', fontSize: '13px', gap: '6px', color: '#ff4757', borderColor: 'rgba(255, 71, 87, 0.4)' }}
        >
          <Trash2 size={15} />
          Remove Photo
        </button>
      </div>
    </div>
  );
};
</file>

<file path="src/modules/profile/components/PreferencesSection.tsx">
import React, { useState } from 'react';
import { Compass, Check, Edit3, X } from 'lucide-react';
import { useProfile } from '../ProfileContext';
import { DEFAULT_ACTIVITY_OPTIONS } from '../mockProfile';

const LOOKING_FOR_OPTIONS: Array<
  'Dating' | 'Friendship' | 'New Friends' | 'Both Dating and Friendship'
> = ['Dating', 'Friendship', 'New Friends', 'Both Dating and Friendship'];

const INTERESTED_IN_OPTIONS: Array<
  'Men' | 'Women' | 'Non-binary people' | 'Everyone'
> = ['Men', 'Women', 'Non-binary people', 'Everyone'];

export const PreferencesSection: React.FC = () => {
  const { profile, updatePreferences } = useProfile();

  const [isEditing, setIsEditing] = useState(false);
  const [lookingFor, setLookingFor] = useState(profile.preferences.lookingFor);
  const [interestedIn, setInterestedIn] = useState(profile.preferences.interestedIn);
  const [minAge, setMinAge] = useState(profile.preferences.ageRange[0]);
  const [maxAge, setMaxAge] = useState(profile.preferences.ageRange[1]);
  const [distanceKm, setDistanceKm] = useState(profile.preferences.distanceRangeKm);
  const [activities, setActivities] = useState<string[]>(profile.preferences.activities);

  const toggleActivity = (act: string) => {
    setActivities((prev) =>
      prev.includes(act) ? prev.filter((a) => a !== act) : [...prev, act]
    );
  };

  const handleSave = (e: React.FormEvent) => {
    e.preventDefault();
    updatePreferences({
      lookingFor,
      interestedIn,
      ageRange: [Number(minAge), Number(maxAge)],
      distanceRangeKm: Number(distanceKm),
      activities,
    });
    setIsEditing(false);
  };

  const handleCancel = () => {
    setLookingFor(profile.preferences.lookingFor);
    setInterestedIn(profile.preferences.interestedIn);
    setMinAge(profile.preferences.ageRange[0]);
    setMaxAge(profile.preferences.ageRange[1]);
    setDistanceKm(profile.preferences.distanceRangeKm);
    setActivities(profile.preferences.activities);
    setIsEditing(false);
  };

  return (
    <div
      id="section-preferences"
      style={{
        borderRadius: '22px',
        padding: '16px',
        border: '1px solid #262030',
        background: 'linear-gradient(180deg, #18121e 0%, #120d17 100%)',
      }}
    >
      {/* Header */}
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '14px' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
          <div
            style={{
              width: '34px',
              height: '34px',
              borderRadius: '10px',
              background: 'rgba(168, 85, 247, 0.18)',
              color: '#a855f7',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              border: '1px solid rgba(168, 85, 247, 0.5)',
              flexShrink: 0,
            }}
          >
            <Compass size={18} />
          </div>
          <div>
            <h3 style={{ fontSize: '17px', fontWeight: 800, color: '#ffffff', margin: 0 }}>Dating & Discovery Preferences</h3>
            <p style={{ fontSize: '11.5px', color: 'rgba(255, 255, 255, 0.65)', margin: '2px 0 0 0' }}>Who you want to meet</p>
          </div>
        </div>

        {!isEditing ? (
          <button
            onClick={() => setIsEditing(true)}
            style={{
              width: '36px',
              height: '36px',
              borderRadius: '10px',
              background: '#1a141f',
              border: '1px solid #2a2030',
              color: '#ffffff',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              cursor: 'pointer',
            }}
            aria-label="Edit dating and discovery preferences"
            title="Edit dating and discovery preferences"
          >
            <Edit3 size={16} />
          </button>
        ) : (
          <div style={{ display: 'flex', gap: '6px' }}>
            <button
              onClick={handleCancel}
              style={{
                padding: '8px 12px',
                borderRadius: '10px',
                background: '#1a141f',
                border: '1px solid #2a2030',
                color: '#ffffff',
                fontSize: '12px',
                display: 'flex',
                alignItems: 'center',
                gap: '4px',
                cursor: 'pointer',
              }}
            >
              <X size={14} />
              Cancel
            </button>
            <button
              onClick={handleSave}
              style={{
                padding: '8px 14px',
                borderRadius: '10px',
                background: 'linear-gradient(90deg, #ff4d7e 0%, #e0264f 100%)',
                border: 'none',
                color: '#ffffff',
                fontSize: '12px',
                display: 'flex',
                alignItems: 'center',
                gap: '4px',
                cursor: 'pointer',
              }}
            >
              <Check size={14} />
              Save
            </button>
          </div>
        )}
      </div>

      {!isEditing ? (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
            <div style={{ padding: '12px', borderRadius: '14px', background: '#14101a', border: '1px solid #2a2030' }}>
              <div style={{ fontSize: '11px', color: 'rgba(255,255,255,0.5)', textTransform: 'uppercase', letterSpacing: '0.6px', marginBottom: '6px' }}>Looking For</div>
              <div style={{ fontSize: '16px', fontWeight: 800, color: '#ff4d7e' }}>{profile.preferences.lookingFor}</div>
            </div>
            <div style={{ padding: '12px', borderRadius: '14px', background: '#14101a', border: '1px solid #2a2030' }}>
              <div style={{ fontSize: '11px', color: 'rgba(255,255,255,0.5)', textTransform: 'uppercase', letterSpacing: '0.6px', marginBottom: '6px' }}>Interested In</div>
              <div style={{ fontSize: '16px', fontWeight: 800, color: '#22d3ee' }}>{profile.preferences.interestedIn}</div>
            </div>
          </div>

          <div style={{ padding: '12px', borderRadius: '14px', background: '#14101a', border: '1px solid #2a2030' }}>
            <div style={{ fontSize: '11px', color: 'rgba(255,255,255,0.5)', textTransform: 'uppercase', letterSpacing: '0.6px', marginBottom: '6px' }}>Age Range</div>
            <div style={{ fontSize: '16px', fontWeight: 800, color: '#ffd24a' }}>{profile.preferences.ageRange[0]} – {profile.preferences.ageRange[1]} years old</div>
          </div>

          <div style={{ padding: '12px', borderRadius: '14px', background: '#14101a', border: '1px solid #2a2030' }}>
            <div style={{ fontSize: '11px', color: 'rgba(255,255,255,0.5)', textTransform: 'uppercase', letterSpacing: '0.6px', marginBottom: '6px' }}>Max Distance</div>
            <div style={{ fontSize: '16px', fontWeight: 800, color: '#2ed47a' }}>Within {profile.preferences.distanceRangeKm} km</div>
          </div>

          {profile.preferences.activities.length > 0 && (
            <div>
              <div style={{ fontSize: '12px', color: 'rgba(255,255,255,0.7)', marginBottom: '8px' }}>Activities To Do Together</div>
              <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px' }}>
                {profile.preferences.activities.map((act) => (
                  <span
                    key={act}
                    style={{
                      padding: '4px 10px',
                      borderRadius: '999px',
                      background: '#1a141f',
                      border: '1px solid #2a2030',
                      fontSize: '12px',
                      color: '#ffffff',
                      fontWeight: 600,
                    }}
                  >
                    {act}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      ) : (
        <form onSubmit={handleSave} style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          <div>
            <label style={{ fontSize: '12px', fontWeight: 700, color: 'rgba(255,255,255,0.7)', display: 'block', marginBottom: '8px' }}>I am Looking For</label>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: '8px' }}>
              {LOOKING_FOR_OPTIONS.map((opt) => (
                <button
                  type="button"
                  key={opt}
                  onClick={() => setLookingFor(opt)}
                  style={{
                    padding: '8px 12px',
                    borderRadius: '999px',
                    border: lookingFor === opt ? '1px solid #ff4d7e' : '1px solid #2a2030',
                    background: lookingFor === opt ? 'rgba(255, 77, 126, 0.2)' : '#14101a',
                    color: '#ffffff',
                    fontSize: '12.5px',
                    fontWeight: lookingFor === opt ? 700 : 500,
                    cursor: 'pointer',
                  }}
                >
                  {opt}
                </button>
              ))}
            </div>
          </div>

          <div>
            <label style={{ fontSize: '12px', fontWeight: 700, color: 'rgba(255,255,255,0.7)', display: 'block', marginBottom: '8px' }}>Interested In Meeting</label>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: '8px' }}>
              {INTERESTED_IN_OPTIONS.map((opt) => (
                <button
                  type="button"
                  key={opt}
                  onClick={() => setInterestedIn(opt)}
                  style={{
                    padding: '8px 12px',
                    borderRadius: '999px',
                    border: interestedIn === opt ? '1px solid #22d3ee' : '1px solid #2a2030',
                    background: interestedIn === opt ? 'rgba(34, 211, 238, 0.2)' : '#14101a',
                    color: '#ffffff',
                    fontSize: '12.5px',
                    fontWeight: interestedIn === opt ? 700 : 500,
                    cursor: 'pointer',
                  }}
                >
                  {opt}
                </button>
              ))}
            </div>
          </div>

          <div>
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '6px' }}>
              <label style={{ fontSize: '12px', fontWeight: 700, color: 'rgba(255,255,255,0.7)' }}>Age Range</label>
              <span style={{ fontSize: '13px', fontWeight: 700, color: '#ffd24a' }}>{minAge} – {maxAge} years</span>
            </div>
            <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
              <input type="range" min="18" max="60" value={minAge} onChange={(e) => setMinAge(Math.min(Number(e.target.value), maxAge - 1))} style={{ flex: 1, accentColor: '#ff4d7e' }} />
              <span style={{ color: 'rgba(255,255,255,0.5)' }}>to</span>
              <input type="range" min="18" max="60" value={maxAge} onChange={(e) => setMaxAge(Math.max(Number(e.target.value), minAge + 1))} style={{ flex: 1, accentColor: '#ff4d7e' }} />
            </div>
          </div>

          <div>
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '6px' }}>
              <label style={{ fontSize: '12px', fontWeight: 700, color: 'rgba(255,255,255,0.7)' }}>Discovery Distance</label>
              <span style={{ fontSize: '13px', fontWeight: 700, color: '#2ed47a' }}>Up to {distanceKm} km</span>
            </div>
            <input type="range" min="5" max="100" value={distanceKm} onChange={(e) => setDistanceKm(Number(e.target.value))} style={{ width: '100%', accentColor: '#2ed47a' }} />
          </div>

          <div>
            <label style={{ fontSize: '12px', fontWeight: 700, color: 'rgba(255,255,255,0.7)', display: 'block', marginBottom: '8px' }}>Activities To Do Together</label>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: '8px' }}>
              {DEFAULT_ACTIVITY_OPTIONS.map((act) => {
                const isSelected = activities.includes(act);
                return (
                  <button
                    type="button"
                    key={act}
                    onClick={() => toggleActivity(act)}
                    style={{
                      padding: '6px 12px',
                      borderRadius: '999px',
                      border: isSelected ? '1px solid #2ed47a' : '1px solid #2a2030',
                      background: isSelected ? 'rgba(46, 212, 122, 0.2)' : '#14101a',
                      color: isSelected ? '#2ed47a' : '#ffffff',
                      fontSize: '12px',
                      fontWeight: isSelected ? 700 : 500,
                      cursor: 'pointer',
                    }}
                  >
                    {act}
                  </button>
                );
              })}
            </div>
          </div>
        </form>
      )}
    </div>
  );
};
</file>

<file path="src/modules/profile/components/ProfileCompletionCard.tsx">
import React, { useState } from 'react';
import { CheckCircle2, ArrowRight, Zap, ChevronDown } from 'lucide-react';
import { useProfile } from '../ProfileContext';

export const ProfileCompletionCard: React.FC = () => {
  const {
    profileCompletion,
    completionChecklist,
    setIsVerificationModalOpen,
  } = useProfile();

  const [detailsOpen, setDetailsOpen] = useState(false);

  const handleItemClick = (targetSection: string) => {
    if (targetSection === 'verification') {
      setIsVerificationModalOpen(true);
    } else {
      const elem = document.getElementById(`section-${targetSection}`);
      if (elem) {
        elem.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  };

  const handleCardClick = (e: React.MouseEvent) => {
    const target = e.target as HTMLElement;
    if (target.closest('button[data-step-item="true"]')) {
      return;
    }
    e.preventDefault();
    setDetailsOpen((prev) => !prev);
  };

  return (
    <div
      role="button"
      tabIndex={0}
      aria-expanded={detailsOpen}
      style={{
        borderRadius: '22px',
        padding: '16px',
        border: '1px solid rgba(34, 211, 238, 0.4)',
        background: 'linear-gradient(90deg, rgba(34, 211, 238, 0.18) 0%, rgba(20, 16, 26, 0.98) 100%)',
        cursor: 'pointer',
        userSelect: 'none',
        boxShadow: '0 10px 40px rgba(0, 0, 0, 0.4)',
      }}
      onClick={handleCardClick}
      onKeyDown={(e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setDetailsOpen((prev) => !prev);
        }
      }}
    >
      {/* Top Header */}
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '12px' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
          <div
            style={{
              width: '34px',
              height: '34px',
              borderRadius: '10px',
              background: 'rgba(34, 211, 238, 0.2)',
              color: '#22d3ee',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              border: '1px solid rgba(34, 211, 238, 0.5)',
              flexShrink: 0,
            }}
          >
            <Zap size={18} />
          </div>
          <div>
            <h3 style={{ fontSize: '17px', fontWeight: 800, color: '#ffffff', margin: 0 }}>
              Profile Progress
            </h3>
            <p style={{ fontSize: '11.5px', color: 'rgba(255, 255, 255, 0.65)', margin: '2px 0 0 0' }}>
              Complete your profile to improve connection matches & visibility
            </p>
          </div>
        </div>

        <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
          <div style={{ fontSize: '22px', fontWeight: 900, color: '#22d3ee', letterSpacing: '-0.5px' }}>
            {profileCompletion}%
          </div>
          <button
            onClick={(e) => {
              e.stopPropagation();
              setDetailsOpen((prev) => !prev);
            }}
            aria-label="Toggle completion details"
            style={{
              background: '#1a141f',
              border: '1px solid #2a2030',
              borderRadius: '50%',
              color: '#ffffff',
              cursor: 'pointer',
              width: '36px',
              height: '36px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              transform: detailsOpen ? 'rotate(180deg)' : 'rotate(0deg)',
              transition: 'transform var(--transition-fast)',
            }}
          >
            <ChevronDown size={18} />
          </button>
        </div>
      </div>

      {/* Progress Bar & Step Indicators */}
      <div style={{ marginBottom: detailsOpen ? '16px' : '0px' }}>
        <div
          style={{
            width: '100%',
            height: '8px',
            borderRadius: '999px',
            background: 'rgba(255, 255, 255, 0.12)',
            overflow: 'hidden',
            marginBottom: '10px',
          }}
        >
          <div
            style={{
              width: `${profileCompletion}%`,
              height: '100%',
              background: 'linear-gradient(90deg, #2ed47a 0%, #22d3ee 100%)',
              borderRadius: '999px',
              transition: 'width 0.5s cubic-bezier(0.4, 0, 0.2, 1)',
              boxShadow: '0 0 12px rgba(34, 211, 238, 0.4)',
            }}
          />
        </div>

        {/* 5-step visual track line */}
        <div style={{ display: 'flex', alignItems: 'center', gap: '6px', padding: '0 2px' }}>
          {completionChecklist.map((item, idx) => {
            const isCompleted = item.completed;
            const nextNotCompleted = completionChecklist.findIndex((c) => !c.completed) === idx;
            return (
              <div
                key={`bar-step-${item.id}`}
                style={{
                  flex: 1,
                  height: '6px',
                  borderRadius: '999px',
                  background: isCompleted
                    ? 'linear-gradient(90deg, #2ed47a 0%, #22d3ee 100%)'
                    : nextNotCompleted
                    ? 'rgba(34, 211, 238, 0.5)'
                    : 'rgba(255, 255, 255, 0.18)',
                  boxShadow: isCompleted ? '0 0 8px rgba(46, 212, 122, 0.4)' : undefined,
                  transition: 'background 0.3s ease',
                }}
                title={`Step ${idx + 1}: ${item.title}`}
              />
            );
          })}
        </div>
      </div>

      {/* Checklist */}
      {detailsOpen && (
        <div
          style={{
            display: 'grid',
            gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))',
            gap: '10px',
            marginTop: '16px',
            paddingTop: '14px',
            borderTop: '1px solid rgba(255, 255, 255, 0.12)',
          }}
        >
          {completionChecklist.map((item, index) => (
            <button
              key={item.id}
              data-step-item="true"
              onClick={(e) => {
                e.stopPropagation();
                handleItemClick(item.targetSection);
              }}
              style={{
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'space-between',
                padding: '11px 13px',
                borderRadius: '14px',
                background: item.completed
                  ? 'rgba(46, 212, 122, 0.12)'
                  : '#14101a',
                border: item.completed
                  ? '1px solid rgba(46, 212, 122, 0.5)'
                  : '1px solid #2a2030',
                cursor: 'pointer',
                textAlign: 'left',
                transition: 'all var(--transition-fast)',
              }}
            >
              <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
                <div
                  style={{
                    width: '24px',
                    height: '24px',
                    borderRadius: '50%',
                    background: item.completed ? '#2ed47a' : 'rgba(255, 255, 255, 0.12)',
                    color: item.completed ? '#000000' : '#ffffff',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    fontSize: '11.5px',
                    fontWeight: 800,
                    flexShrink: 0,
                  }}
                >
                  {item.completed ? <CheckCircle2 size={16} color="#000000" /> : index + 1}
                </div>

                <div style={{ display: 'flex', flexDirection: 'column' }}>
                  <span
                    style={{
                      fontSize: '12.5px',
                      fontWeight: 700,
                      color: '#ffffff',
                    }}
                  >
                    {item.title}
                  </span>
                  <span
                    style={{
                      fontSize: '10.5px',
                      fontWeight: 600,
                      color: item.completed ? '#2ed47a' : 'rgba(255, 255, 255, 0.65)',
                      marginTop: '2px',
                    }}
                  >
                    {item.completed ? 'Completed' : 'Pending step'}
                  </span>
                </div>
              </div>

              {!item.completed && (
                <ArrowRight size={15} color="#22d3ee" style={{ flexShrink: 0, marginLeft: '6px' }} />
              )}
            </button>
          ))}
        </div>
      )}
    </div>
  );
};
</file>

<file path="src/modules/profile/components/ProfileHeaderCard.tsx">
