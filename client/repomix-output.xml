                </div>
                <div className="settings-inline-hint">
                  {privacy.showOnlineStatus
                    ? 'On — others can see when you are active in the app.'
                    : 'Hide Online Status — you appear offline to everyone.'}
                </div>
              </div>
              <Switch
                checked={privacy.showOnlineStatus}
