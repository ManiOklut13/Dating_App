import React from 'react';
import { Shield, ShieldAlert, AlertTriangle, X, Edit3 } from 'lucide-react';
import { useChat } from './ChatContext';

export const SafetyModals: React.FC = () => {
  const {
    isScreenshotModalOpen,
    setIsScreenshotModalOpen,
    profanityAlert,
    setProfanityAlert,
    toast,
    clearToast,
  } = useChat();

  return (
    <>
      {/* Toast Banner */}
      {toast && (
        <div
          style={{
            position: 'fixed',
            top: '80px',
            left: '50%',
            transform: 'translateX(-50%)',
            zIndex: 9999,
            minWidth: '320px',
            maxWidth: '92vw',
            padding: '12px 18px',
            borderRadius: 'var(--radius-md)',
            background:
              toast.type === 'warning'
                ? 'rgba(255, 71, 87, 0.95)'
                : toast.type === 'success'
                ? 'rgba(0, 230, 118, 0.95)'
                : 'var(--bg-card)',
            color: 'var(--text-primary)',
            boxShadow: 'var(--shadow-lg)',
            border: '1px solid rgba(255, 255, 255, 0.2)',
            backdropFilter: 'blur(16px)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            gap: '12px',
            animation: 'pulseGlow 2s infinite ease-in-out',
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
            {toast.type === 'warning' && <ShieldAlert size={20} />}
            {toast.type === 'success' && <Shield size={20} />}
            <span style={{ fontSize: '13.5px', fontWeight: 600 }}>{toast.text}</span>
          </div>

          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
            {toast.actionText && (
              <button
                onClick={() => {
                  toast.onAction?.();
                  clearToast();
                }}
                style={{
                  background: 'rgba(255, 255, 255, 0.2)',
                  border: 'none',
                  color: 'var(--text-primary)',
                  padding: '4px 10px',
                  borderRadius: 'var(--radius-sm)',
                  fontSize: '12px',
                  fontWeight: 700,
                  cursor: 'pointer',
                }}
              >
                {toast.actionText}
              </button>
            )}
            <button
              onClick={clearToast}
              style={{
                background: 'transparent',
                border: 'none',
                color: 'rgba(255, 255, 255, 0.8)',
                cursor: 'pointer',
                display: 'flex',
                alignItems: 'center',
              }}
            >
              <X size={16} />
            </button>
          </div>
        </div>
      )}

      {/* Screenshot Warning Modal */}
      {isScreenshotModalOpen && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            zIndex: 99999,
