            </div>
          </div>
        </div>

        {/* Profile Content */}
        <div style={{ flex: 1, minHeight: 0, overflowY: 'auto', padding: '20px 24px', display: 'flex', flexDirection: 'column', gap: '18px' }}>

          {/* Vibe Score Card */}
