            <button
              onClick={() => adjustMinute(-1)}
              aria-label="Decrease minute"
              style={{
                width: '44px',
                height: '36px',
                backgroundColor: 'transparent',
                border: 'none',
                color: planDateTheme.colors.accentText,
                cursor: 'pointer',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                padding: 0,
                minWidth: `${planDateTheme.sizes.minTouchTarget}px`,
