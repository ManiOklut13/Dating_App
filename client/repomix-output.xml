import { MIN_AGE } from './types';

export const isEmail = (value: string): boolean => /^[^\s@]+@[^\s@]+\.[A-Za-z]{2,}$/.test(value.trim());

export const isPhone = (value: string): boolean => /^[0-9]{7,15}$/.test(value.replace(/\D/g, ''));

export const formatPhone = (value: string): string => {
  const digits = value.replace(/\D/g, '');
  if (digits.length <= 5) return digits;
  if (digits.length <= 9) return `${digits.slice(0, 5)} ${digits.slice(5)}`;
  return `${digits.slice(0, 5)} ${digits.slice(5, 10)} ${digits.slice(10)}`;
};

/** 0 = empty/weak … 4 = very strong */
export const passwordScore = (value: string): number => {
  if (!value) return 0;
  let score = 0;
  if (value.length >= 8) score += 1;
  if (value.length >= 12) score += 1;
  if (/[A-Z]/.test(value) && /[a-z]/.test(value)) score += 1;
  if (/[0-9]/.test(value) && /[^A-Za-z0-9]/.test(value)) score += 1;
  return Math.min(score, 4);
};

export const passwordChecks = (value: string) => [
  { id: 'len', label: 'At least 8 characters', ok: value.length >= 8 },
  { id: 'case', label: 'Upper & lower case letters', ok: /[A-Z]/.test(value) && /[a-z]/.test(value) },
  { id: 'num', label: 'At least one number', ok: /[0-9]/.test(value) },
  { id: 'sym', label: 'One symbol (!@#…)', ok: /[^A-Za-z0-9]/.test(value) },
];

export const passwordLabel = (score: number) =>
  ['', 'Weak', 'Fair', 'Good', 'Strong'][score] || 'Weak';

/** Age in whole years from an ISO date (YYYY-MM-DD), or null when invalid. */
export const ageFromDob = (dob: string): number | null => {
  if (!dob) return null;
  const birth = new Date(`${dob}T00:00:00`);
  if (Number.isNaN(birth.getTime())) return null;
  const now = new Date();
  if (birth > now) return null;
  let age = now.getFullYear() - birth.getFullYear();
  const m = now.getMonth() - birth.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < birth.getDate())) age -= 1;
  return age;
};

export interface DobValidation {
  age: number | null;
  error: string | null;
}

export const validateDob = (dob: string, minAge = MIN_AGE): DobValidation => {
  if (!dob) return { age: null, error: 'Please select your date of birth.' };
  const birth = new Date(`${dob}T00:00:00`);
  if (Number.isNaN(birth.getTime())) return { age: null, error: 'Enter a valid date.' };
  if (birth > new Date()) return { age: null, error: 'Date of birth cannot be in the future.' };
  const age = ageFromDob(dob);
  if (age === null) return { age: null, error: 'Enter a valid date.' };
  if (age < minAge) return { age, error: `You must be at least ${minAge} years old to use YoUnMe.` };
  if (age > 120) return { age, error: 'Please enter a realistic date of birth.' };
  return { age, error: null };
};

export const maskEmail = (email: string): string => {
  const [user, domain] = email.split('@');
  if (!domain) return email;
  const head = user.slice(0, 2);
  return `${head}${'*'.repeat(Math.max(user.length - 2, 1))}@${domain}`;
};

export const maskPhone = (countryCode: string, phone: string): string => {
  const digits = phone.replace(/\D/g, '');
  const tail = digits.slice(-4);
  return `${countryCode} ${'*'.repeat(Math.max(digits.length - 4, 0))}${tail}`;
};

/** Demo-only pattern detection for the chat-safety preview. */
export interface Detection {
  kind: 'link' | 'phone' | 'handle' | 'profanity';
  label: string;
  value: string;
}

const PATTERNS: Array<{ kind: Detection['kind']; re: RegExp; label: string }> = [
  { kind: 'link', re: /\b(?:https?:\/\/|www\.)\S+/gi, label: 'External link' },
  { kind: 'handle', re: /\b(?:instagram|telegram|whatsapp|snapchat|tiktok)\b\S*/gi, label: 'Social handle / app' },
  { kind: 'handle', re: /@[a-z0-9._]{3,}/gi, label: 'Social handle' },
  { kind: 'phone', re: /(?:\+?\d[\d\s-]{8,}\d)/g, label: 'Phone number' },
];

export const detectUnsafeContent = (message: string, profanity: string[] = []): Detection[] => {
  const found: Detection[] = [];
  const seen = new Set<string>();
  for (const { kind, re, label } of PATTERNS) {
    const matches = message.match(re) || [];
    for (const raw of matches) {
      const value = raw.trim();
      if (!value || seen.has(value.toLowerCase())) continue;
      seen.add(value.toLowerCase());
      found.push({ kind, label, value });
    }
  }
  const lower = message.toLowerCase();
  for (const word of profanity) {
    if (lower.includes(word.toLowerCase())) {
      found.push({ kind: 'profanity', label: 'Restricted word', value: word });
    }
  }
  return found;
};

export const maskProfanity = (message: string, profanity: string[]): string => {
  let out = message;
  for (const word of profanity) {
    if (!word) continue;
    out = out.replace(new RegExp(`\\b${word}\\b`, 'gi'), '*'.repeat(word.length));
  }
  return out;
};
</file>

<file path="src/modules/presence/PresenceContext.tsx">
import React, { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react';

/* ==========================================================================
   Presence
   --------------------------------------------------------------------------
   Single source of truth for online / offline / unknown status, consumed by
   the Profile tab, the chat list and the chat header.

   Data source, in order of preference:

     1. LIVE — a WebSocket to the realtime service (`/ws`), which both
        services/api-nestjs/src/server.ts and services/realtime-go/main.go
        expose. The server broadcasts `presence:online` / `presence:offline`
        on the `presence:global` channel on connect and disconnect, and
        replies to an explicit `subscribe` for `presence:{user_id}`.

     2. DEMO FALLBACK — when the socket cannot be reached (backend not
        running, or the user is viewing a static build), presence resolves to
        'unknown'. 'unknown' renders a neutral grey indicator. It is
        deliberately NOT rendered as offline, because "we could not reach the
        presence service" is not the same claim as "this user is offline".

   Status is never randomised. Every value shown comes from an actual server
   event or from an explicit 'unknown'.

   Privacy: `ProfileContext` owns the user's own Activity Status setting
   (`privacy.showOnlineStatus`). When the authenticated user has turned their
   activity status off, their own presence is reported as 'unknown' to every
   consumer so nothing leaks through the indicator.
   ========================================================================== */

export type PresenceStatus = 'online' | 'offline' | 'unknown';

export const PRESENCE_STORAGE_KEY = 'younme:current-user-id';

/** The seeded development account. Replace with the auth session's subject. */
export const CURRENT_USER_ID = '11111111-1111-1111-1111-111111111111';

export interface PresenceState {
  /** Raw per-user status as reported by the presence service. */
  byUser: Record<string, PresenceStatus>;
  /** Connection health of the presence socket itself. */
  connection: 'connecting' | 'live' | 'fallback';
  /** Last time this user was seen going online, used for "last seen". */
  lastSeen: Record<string, string>;
}

interface PresenceContextValue extends PresenceState {
  /**
   * Resolve a user's status, honouring Activity Status privacy.
   * Never returns a random or optimistic value.
   */
  getStatus: (userId: string) => PresenceStatus;
  /** 'Active now' / 'Offline' / null-when-unknown label for a user. */
  getStatusLabel: (userId: string) => string;
  /** ISO timestamp of the last online event, if known. */
  getLastSeen: (userId: string) => string | undefined;
  /** True while the presence socket has never connected. */
  isLoading: (userId: string) => boolean;
  connection: PresenceState['connection'];
}

const PresenceContext = createContext<PresenceContextValue | undefined>(undefined);

const RECONNECT_BASE_MS = 1000;
const RECONNECT_MAX_MS = 15000;

const buildSocketUrl = (userId: string): string => {
  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  // Vite proxies /ws to the realtime service in development (vite.config.ts).
  return `${protocol}//${window.location.host}/ws?user_id=${encodeURIComponent(userId)}`;
};

export const PresenceProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [byUser, setByUser] = useState<Record<string, PresenceStatus>>({});
  const [lastSeen, setLastSeen] = useState<Record<string, string>>({});
  const [connection, setConnection] = useState<PresenceState['connection']>('connecting');

  const socketRef = useRef<WebSocket | null>(null);
  const retryRef = useRef(0);
  const timerRef = useRef<number | null>(null);
  const closedRef = useRef(false);

  const applyPresence = useCallback((userId: string, status: 'online' | 'offline') => {
    if (!userId) return;
    setByUser((prev) => (prev[userId] === status ? prev : { ...prev, [userId]: status }));
    setLastSeen((prev) =>
      status === 'online' ? { ...prev, [userId]: new Date().toISOString() } : prev,
    );
  }, []);

  useEffect(() => {
    closedRef.current = false;

    const connect = () => {
      if (closedRef.current) return;

      let socket: WebSocket;
      try {
        socket = new WebSocket(buildSocketUrl(CURRENT_USER_ID));
      } catch {
        // Malformed URL or blocked socket — fall back to unknown status.
        setConnection('fallback');
        scheduleReconnect();
        return;
      }

      socketRef.current = socket;

      socket.onopen = () => {
        retryRef.current = 0;
        setConnection('live');
        // Explicitly subscribe to the presence channels the server exposes.
        ['presence:global', `presence:${CURRENT_USER_ID}`].forEach((channel) => {
          socket.send(JSON.stringify({ channel: 'presence', event: 'subscribe', payload: channel }));
        });
      };

      socket.onmessage = (message) => {
        try {
          const parsed = JSON.parse(message.data);
          if (parsed?.event === 'presence:online') {
            applyPresence(parsed.payload?.user_id, 'online');
          } else if (parsed?.event === 'presence:offline') {
            applyPresence(parsed.payload?.user_id, 'offline');
          }
        } catch {
          // Ignore frames that are not presence envelopes.
        }
      };

      socket.onerror = () => {
        // `onclose` always follows, which handles the fallback.
      };

      socket.onclose = () => {
        socketRef.current = null;
        if (closedRef.current) return;
        setConnection('fallback');
        scheduleReconnect();
      };
    };

    const scheduleReconnect = () => {
      if (closedRef.current) return;
      if (timerRef.current !== null) window.clearTimeout(timerRef.current);
      // Exponential backoff so an unreachable backend does not spin the CPU.
      const delay = Math.min(RECONNECT_BASE_MS * 2 ** retryRef.current, RECONNECT_MAX_MS);
      retryRef.current += 1;
      timerRef.current = window.setTimeout(connect, delay);
    };

    connect();

    return () => {
      closedRef.current = true;
      if (timerRef.current !== null) window.clearTimeout(timerRef.current);
      socketRef.current?.close();
      socketRef.current = null;
    };
  }, [applyPresence]);

  // Reconnect immediately when the tab becomes visible again.
  useEffect(() => {
    const onVisible = () => {
      if (document.visibilityState === 'visible' && !socketRef.current) {
        retryRef.current = 0;
      }
    };
    document.addEventListener('visibilitychange', onVisible);
    return () => document.removeEventListener('visibilitychange', onVisible);
  }, []);

  const value = useMemo<PresenceContextValue>(() => {
    const getStatus = (userId: string): PresenceStatus => {
      if (!userId) return 'unknown';
      return byUser[userId] ?? 'unknown';
    };

    const getStatusLabel = (userId: string): string => {
      const status = getStatus(userId);
      if (status === 'online') return 'Active now';
      if (status === 'offline') return 'Offline';
      return 'Offline'; // Replaced by callers when the user prefers to hide it.
    };

    return {
      byUser,
      lastSeen,
      connection,
      getStatus,
      getStatusLabel,
      getLastSeen: (userId: string) => lastSeen[userId],
      isLoading: (userId: string) => connection === 'connecting' && !byUser[userId],
    };
  }, [byUser, lastSeen, connection]);

  return <PresenceContext.Provider value={value}>{children}</PresenceContext.Provider>;
};

export const usePresence = (): PresenceContextValue => {
  const context = useContext(PresenceContext);
  if (!context) {
    throw new Error('usePresence must be used within a PresenceProvider');
  }
  return context;
};
</file>

<file path="src/modules/presence/PresenceDot.tsx">
import React from 'react';
import { usePresence, PresenceStatus } from './PresenceContext';
import { useProfile } from '../profile/ProfileContext';

/* ==========================================================================
   PresenceDot
   --------------------------------------------------------------------------
   The online / offline indicator drawn on the bottom-right of a profile photo.

   Colour rules (never two at once, never a guess):
     online   -> green  (#00e676, --emerald-live)
     offline  -> red    (#ff4757)
     unknown  -> grey   (--text-muted) — used while presence is loading or the
                realtime service is unreachable, so a missing connection is
                never reported as "offline".

   The ring around the dot uses --bg-surface rather than a hardcoded dark
   colour, so the indicator stays legible in both the dark and light themes.
   ========================================================================== */

export const PRESENCE_COLORS: Record<PresenceStatus, string> = {
  online: '#00e676',
  offline: '#ff4757',
  unknown: '#5e6682',
};

export const PRESENCE_LABELS: Record<PresenceStatus, string> = {
  online: 'Active now',
  offline: 'Offline',
  unknown: '',
};

export interface PresenceDotProps {
  userId: string;
  /** Diameter of the indicator in px. Defaults to 12. */
  size?: number;
  /**
   * Set for the authenticated user's own photo. When their Activity Status
   * privacy setting is off, their presence is hidden and renders as unknown.
   */
  isSelf?: boolean;
  className?: string;
  style?: React.CSSProperties;
}

export const PresenceDot: React.FC<PresenceDotProps> = ({
  userId,
  size = 12,
  isSelf = false,
  className,
  style,
}) => {
  const { getStatus, connection } = usePresence();
  const { profile } = useProfile();

  const hidesOwnActivity = isSelf && !profile.privacy.showOnlineStatus;
  const status: PresenceStatus = hidesOwnActivity ? 'unknown' : getStatus(userId);

  const label = hidesOwnActivity
    ? 'Activity status hidden'
    : `${PRESENCE_LABELS[status]}${connection === 'fallback' ? ' (live presence unavailable)' : ''}`;

  return (
    <span
      role="status"
      aria-label={label}
      title={label}
      className={className}
      data-presence={status}
      style={{
        position: 'absolute',
        bottom: 0,
        right: 0,
        width: size,
        height: size,
        borderRadius: '50%',
        background: PRESENCE_COLORS[status],
        // Theme-aware ring so the dot separates from the photo in both themes.
        border: `2px solid var(--bg-surface, var(--bg-surface))`,
        boxShadow: '0 0 0 1px rgba(0, 0, 0, 0.35)',
        pointerEvents: 'none',
        zIndex: 2,
        ...style,
      }}
    />
  );
};

/**
 * Text label paired with a PresenceDot: "Active now" when online, "Offline"
 * when offline, and a neutral "Status unavailable" while loading.
 */
export const PresenceLabel: React.FC<{
  userId: string;
  isSelf?: boolean;
  suffix?: string;
}> = ({ userId, isSelf = false, suffix }) => {
  const { getStatus, connection } = usePresence();
  const { profile } = useProfile();

  const hidesOwnActivity = isSelf && !profile.privacy.showOnlineStatus;
  const status: PresenceStatus = hidesOwnActivity ? 'unknown' : getStatus(userId);

  const text = hidesOwnActivity
    ? 'Activity status hidden'
    : PRESENCE_LABELS[status] || '';

  return (
    <span
      style={{
        fontSize: '11px',
        color: status === 'online' ? '#00e676' : 'var(--text-muted)',
        display: 'inline-flex',
        alignItems: 'center',
        gap: '4px',
      }}
    >
      {text}
      {suffix && status !== 'unknown' ? ` • ${suffix}` : ''}
    </span>
  );
};
</file>

