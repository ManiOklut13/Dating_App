          onClick={() => setIsLogoutConfirmOpen(true)}
        />
      </SettingsSection>
    </SettingsPage>
  );
};

export default SettingsActivityPage;
</file>

<file path="src/modules/settings/SettingsContext.tsx">
import React, { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react';

/* ==========================================================================
   Settings router
   --------------------------------------------------------------------------
   The app has no router library; onboarding already uses a hash-based
   pseudo-routing pattern (window.location.hash + popstate). The settings
   screens follow the same approach so every navigation is a real history
   entry and the browser back / forward buttons work correctly.

   Routes (mirrored in the URL as #/...):
     settings                            -> Settings and Activity (hub)
     settings/privacy                    -> Privacy and Safety
     settings/privacy/blocked            -> Blocked Accounts
     settings/privacy/restricted         -> Restricted Accounts
     settings/privacy/hidden-words       -> Hidden Words
     settings/activity-status            -> Activity Status
     settings/messaging                  -> Who Can Message Me
     settings/notifications              -> Notifications
     settings/theme-language             -> Themes and Languages
     settings/security                   -> Security
     settings/security/login-activity    -> Login Activity (history)
     settings/security/devices           -> Where You're Logged In
     settings/security/account-management -> Account Management
     settings/help                       -> Help and Support
     settings/help/support-requests      -> Support Requests
     settings/help/faq                   -> Frequently Asked Questions
   ========================================================================== */

export const SETTINGS_ROUTES = [
  'settings',
  'settings/privacy',
  'settings/privacy/blocked',
  'settings/privacy/restricted',
  'settings/privacy/hidden-words',
  'settings/activity-status',
  'settings/messaging',
  'settings/notifications',
  'settings/theme-language',
  'settings/security',
  'settings/security/login-activity',
  'settings/security/devices',
  'settings/security/account-management',
  'settings/help',
  'settings/help/support-requests',
  'settings/help/faq',
] as const;

export type SettingsRoute = (typeof SETTINGS_ROUTES)[number];

const routeFromHash = (): SettingsRoute | null => {
  try {
    const hash = window.location.hash.replace(/^#\/?/, '');
    if (!hash) return null;
    if (hash === 'settings' || hash.startsWith('settings/')) {
      return (SETTINGS_ROUTES as readonly string[]).includes(hash)
        ? (hash as SettingsRoute)
        : 'settings';
    }
    return null;
  } catch {
    return null;
  }
};

interface SettingsContextType {
  /** Current settings route, or null when the settings screens are closed. */
  route: SettingsRoute | null;
  /** True while any settings screen is open. */
  isActive: boolean;
  /** Push a new history entry (e.g. navigate('settings/privacy')). */
  navigate: (route: SettingsRoute) => void;
  /** Programmatic back: pops real history when we have entries, otherwise walks up. */
  back: () => void;
}

const SettingsContext = createContext<SettingsContextType | undefined>(undefined);

export const SettingsProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [route, setRoute] = useState<SettingsRoute | null>(() => routeFromHash());

  // History entries pushed by navigate() — lets back() decide between
  // history.back() (normal flow) and replaceState (deep link / fresh load).
  const pushedByApp = useRef(0);
  const pendingPush = useRef(false);
  const routeRef = useRef(route);
  routeRef.current = route;

  useEffect(() => {
    const sync = () => {
      if (pendingPush.current) {
        pendingPush.current = false;
        pushedByApp.current += 1;
      } else if (pushedByApp.current > 0) {
        // A back / forward traversal brought us here.
        pushedByApp.current -= 1;
      }
      setRoute(routeFromHash());
    };
    window.addEventListener('hashchange', sync);
    window.addEventListener('popstate', sync);
    return () => {
      window.removeEventListener('hashchange', sync);
      window.removeEventListener('popstate', sync);
    };
  }, []);

  const navigate = useCallback((next: SettingsRoute) => {
    const target = `#/${next}`;
    if (window.location.hash === target) return;
    pendingPush.current = true;
    window.location.hash = target; // fires hashchange -> sync()
  }, []);

  const back = useCallback(() => {
    const current = routeRef.current;
    if (pushedByApp.current > 0) {
      window.history.back();
      return;
    }
    // Deep link / first entry: walk up the settings tree without stacking history.
    if (current && current !== 'settings') {
      const segments = current.split('/');
      segments.pop();
      const parent = segments.join('/') as SettingsRoute;
      window.history.replaceState(null, '', `#/${parent}`);
      setRoute(parent);
      return;
    }
    window.history.replaceState(null, '', window.location.pathname + window.location.search);
    setRoute(null);
  }, []);

  const value = useMemo<SettingsContextType>(
    () => ({ route, isActive: route !== null, navigate, back }),
    [route, navigate, back],
  );

  return <SettingsContext.Provider value={value}>{children}</SettingsContext.Provider>;
};

export const useSettings = (): SettingsContextType => {
  const context = useContext(SettingsContext);
  if (!context) {
    throw new Error('useSettings must be used within a SettingsProvider');
  }
  return context;
};
</file>

<file path="src/modules/settings/SettingsRouter.tsx">
import React, { useEffect } from 'react';
import { useSettings, SettingsRoute } from './SettingsContext';
import { SettingsActivityPage } from './SettingsActivityPage';
import { PrivacySafetyPage, BlockedAccountsPage, RestrictedAccountsPage, HiddenWordsPage } from './PrivacySafetyPage';
import { ActivityStatusPage } from './ActivityStatusPage';
import { MessagingPrivacyPage } from './MessagingPrivacyPage';
import { NotificationsPage } from './NotificationsPage';
import { ThemeLanguagePage } from './ThemeLanguagePage';
import { SecurityPage, LoginActivityPage, DevicesPage } from './SecurityPage';
import { AccountManagementPage } from './AccountManagementPage';
import { HelpSupportPage, SupportRequestsPage, FaqPage } from './HelpSupportPage';

/* ==========================================================================
   Maps the current settings route (see SettingsContext) to its page.
   Returns null when the settings screens are closed, so it can be mounted
   permanently inside the app shell.
   ========================================================================== */

const PAGES: Record<SettingsRoute, React.FC> = {
  settings: SettingsActivityPage,
  'settings/privacy': PrivacySafetyPage,
  'settings/privacy/blocked': BlockedAccountsPage,
  'settings/privacy/restricted': RestrictedAccountsPage,
  'settings/privacy/hidden-words': HiddenWordsPage,
  'settings/activity-status': ActivityStatusPage,
  'settings/messaging': MessagingPrivacyPage,
  'settings/notifications': NotificationsPage,
  'settings/theme-language': ThemeLanguagePage,
  'settings/security': SecurityPage,
  'settings/security/login-activity': LoginActivityPage,
  'settings/security/devices': DevicesPage,
  'settings/security/account-management': AccountManagementPage,
  'settings/help': HelpSupportPage,
  'settings/help/support-requests': SupportRequestsPage,
  'settings/help/faq': FaqPage,
};

export const SettingsRouter: React.FC = () => {
  const { route, isActive } = useSettings();

  // Lock body scroll while a settings page is open (they scroll internally).
  useEffect(() => {
    if (!isActive) return;
    const previous = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    return () => {
      document.body.style.overflow = previous;
    };
  }, [isActive]);

  if (!route) return null;
  const Page = PAGES[route] ?? SettingsActivityPage;
  return <Page />;
};

export default SettingsRouter;
</file>

<file path="src/modules/settings/SettingsUI.tsx">
import React, { useEffect, useRef } from 'react';
import { ArrowLeft, ChevronRight, X } from 'lucide-react';
import { useSettings } from './SettingsContext';

/* ==========================================================================
   Reusable building blocks for the Instagram-style Settings screens.
   All primitives reuse the design-system classes already defined in
   styles/index.css (.settings-row, .switch, .radio-option, ...) so the new
   pages stay visually consistent with the rest of the app and inherit the
   existing light/dark theme support for free.
   ========================================================================== */

/* --------------------------------------------------------------------------
   Page shell — sticky header with a back arrow at the top-left, centered
   title, and a scrollable content column. Responsive: full width on mobile,
   max 720px centered column on desktop.
   -------------------------------------------------------------------------- */
export const SettingsPage: React.FC<{
  title: string;
  subtitle?: string;
  children: React.ReactNode;
  /** Rendered on the right side of the header (e.g. an action button). */
  headerAction?: React.ReactNode;
}> = ({ title, subtitle, children, headerAction }) => {
  const { back } = useSettings();
  const scrollRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    scrollRef.current?.scrollTo({ top: 0 });
  }, [title]);

  return (
    <div className="settings-page" role="region" aria-label={title}>
      <header className="settings-page-header">
        <button type="button" className="settings-back-btn" onClick={back} aria-label="Go back">
          <ArrowLeft size={20} />
        </button>
        <div className="settings-page-heading">
          <h1 className="settings-page-title">{title}</h1>
          {subtitle && <p className="settings-page-subtitle">{subtitle}</p>}
        </div>
        <div className="settings-page-action">{headerAction}</div>
      </header>
      <div className="settings-page-scroll" ref={scrollRef}>
        <div className="settings-page-body">{children}</div>
      </div>
    </div>
  );
};

/* --------------------------------------------------------------------------
   Section — Instagram-style grouped card with an optional uppercase label.
   -------------------------------------------------------------------------- */
export const SettingsSection: React.FC<{
  label?: string;
  note?: React.ReactNode;
  children: React.ReactNode;
}> = ({ label, note, children }) => (
  <section className="settings-group-wrap">
    {label && <h2 className="settings-group-label">{label}</h2>}
    <div className="settings-group">{children}</div>
    {note && <p className="settings-group-note">{note}</p>}
  </section>
);

/* --------------------------------------------------------------------------
   Divider between rows inside a group.
   -------------------------------------------------------------------------- */
export const SettingsDivider: React.FC = () => <div className="settings-row-divider" role="separator" />;

/* --------------------------------------------------------------------------
   Nav row — icon, label, optional hint/value, chevron. Whole row clickable.
   -------------------------------------------------------------------------- */
export const SettingsNavRow: React.FC<{
  icon: React.ReactNode;
  label: string;
  hint?: string;
  value?: string;
  onClick: () => void;
  danger?: boolean;
  showChevron?: boolean;
}> = ({ icon, label, hint, value, onClick, danger, showChevron = true }) => (
  <button
    type="button"
    className="settings-row settings-nav-row"
    onClick={onClick}
    data-testid={`row-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
  >
    <span className="settings-row-icon" style={danger ? { color: '#ff4757' } : undefined} aria-hidden="true">
      {icon}
    </span>
    <span className="settings-row-text">
      <span className="settings-row-label" style={danger ? { color: '#ff4757' } : undefined}>
        {label}
      </span>
      {hint && <span className="settings-row-hint">{hint}</span>}
    </span>
    {value && <span className="settings-row-value">{value}</span>}
    {showChevron && <ChevronRight size={16} className="settings-row-chevron" aria-hidden="true" />}
  </button>
);

/* --------------------------------------------------------------------------
   Toggle row — label + description on the left, rounded switch on the right.
   -------------------------------------------------------------------------- */
export const ToggleRow: React.FC<{
  label: string;
  description?: string;
  icon?: React.ReactNode;
  checked: boolean;
  onChange: (value: boolean) => void;
  disabled?: boolean;
}> = ({ label, description, icon, checked, onChange, disabled }) => (
  <div className={`settings-inline settings-toggle-row${disabled ? ' disabled' : ''}`}>
    <div className="settings-toggle-text">
      <div className="settings-inline-label">
        {icon}
        {label}
      </div>
      {description && <div className="settings-inline-hint">{description}</div>}
    </div>
    <button
      type="button"
      role="switch"
      aria-checked={checked}
      aria-label={label}
      disabled={disabled}
      className={`switch${checked ? ' on' : ''}`}
      onClick={() => onChange(!checked)}
    >
      <span className="switch-knob" />
    </button>
  </div>
);

/* --------------------------------------------------------------------------
   Radio group — mutually exclusive selectable options with descriptions.
   -------------------------------------------------------------------------- */
export interface SettingsRadioOption {
  value: string;
  label: string;
  description?: string;
}

export const RadioGroup: React.FC<{
  label: string;
  value: string;
  options: SettingsRadioOption[];
  onChange: (value: string) => void;
}> = ({ label, value, options, onChange }) => (
  <div role="radiogroup" aria-label={label} className="settings-radio-group">
    {options.map((opt) => {
      const isActive = value === opt.value;
      return (
        <button
          key={opt.value}
          type="button"
          role="radio"
          aria-checked={isActive}
          className={`radio-option${isActive ? ' active' : ''}`}
          onClick={() => onChange(opt.value)}
        >
          <span className="radio-dot" aria-hidden="true" />
          <span className="radio-text">
            <span>{opt.label}</span>
            {opt.description && <span className="radio-desc">{opt.description}</span>}
          </span>
        </button>
      );
    })}
  </div>
);

/* --------------------------------------------------------------------------
   Empty state — used for blocked accounts, login activity, support requests.
   -------------------------------------------------------------------------- */
export const EmptyState: React.FC<{
  icon: React.ReactNode;
  title: string;
  description: string;
  action?: React.ReactNode;
}> = ({ icon, title, description, action }) => (
  <div className="settings-empty-state">
    <div className="settings-empty-icon" aria-hidden="true">
      {icon}
    </div>
    <p className="settings-empty-title">{title}</p>
    <p className="settings-empty-desc">{description}</p>
    {action && <div className="settings-empty-action">{action}</div>}
  </div>
);

/* --------------------------------------------------------------------------
   Confirmation dialog — required for sensitive actions.
   -------------------------------------------------------------------------- */
export const ConfirmDialog: React.FC<{
  open: boolean;
  icon?: React.ReactNode;
  title: string;
  message: string;
  confirmLabel?: string;
  cancelLabel?: string;
  danger?: boolean;
  onConfirm: () => void;
  onCancel: () => void;
}> = ({
  open,
  icon,
  title,
  message,
  confirmLabel = 'Confirm',
  cancelLabel = 'Cancel',
  danger,
  onConfirm,
  onCancel,
}) => {
  const confirmRef = useRef<HTMLButtonElement>(null);

  useEffect(() => {
    if (!open) return;
    confirmRef.current?.focus();
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') onCancel();
    };
    window.addEventListener('keydown', onKeyDown);
    return () => window.removeEventListener('keydown', onKeyDown);
  }, [open, onCancel]);

  if (!open) return null;

  return (
    <div className="settings-dialog-backdrop" onClick={onCancel} role="presentation">
      <div
        className="settings-dialog glass-panel"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="settings-dialog-title"
        onClick={(e) => e.stopPropagation()}
      >
        <button type="button" className="settings-icon-btn settings-dialog-close" onClick={onCancel} aria-label="Close dialog">
          <X size={16} />
        </button>
        {icon && <div className="settings-dialog-icon" aria-hidden="true">{icon}</div>}
        <h3 id="settings-dialog-title" className="settings-dialog-title">
          {title}
        </h3>
        <p className="settings-dialog-message">{message}</p>
        <div className="settings-dialog-actions">
          <button type="button" className="btn-ghost settings-dialog-btn" onClick={onCancel}>
            {cancelLabel}
          </button>
          <button
            ref={confirmRef}
            type="button"
            className={`settings-dialog-btn ${danger ? 'danger' : 'primary'}`}
            onClick={onConfirm}
          >
            {confirmLabel}
          </button>
        </div>
      </div>
    </div>
  );
};

/* --------------------------------------------------------------------------
   Info banner used across the settings screens.
   -------------------------------------------------------------------------- */
export const SettingsBanner: React.FC<{ children: React.ReactNode; tone?: 'info' | 'warning' }> = ({
  children,
  tone = 'info',
}) => <div className={`settings-banner settings-banner-${tone}`}>{children}</div>;
</file>

<file path="src/modules/settings/ThemeLanguagePage.tsx">
import React from 'react';
import {
  SettingsPage,
  SettingsSection,
  RadioGroup,
} from './SettingsUI';
import { useProfile } from '../profile/ProfileContext';
import { LANGUAGES } from '../profile/mockProfile';

/* ==========================================================================
   Themes and Languages — appearance (light / dark) and app language.
   Both preferences live on the profile account settings, so every change is
   applied immediately and remembered on this device.
   ========================================================================== */

export const ThemeLanguagePage: React.FC = () => {
  const { profile, updateAccountSettings, showToast } = useProfile();
  const settings = profile.settings;

  return (
    <SettingsPage title="Themes and Languages" subtitle="Look and language of the app">
      <SettingsSection
        label="Appearance"
        note="The theme is applied the moment you pick it — there is nothing to save."
      >
        <RadioGroup
          label="App theme"
          value={settings.appTheme}
          onChange={(value) => {
            if (value === settings.appTheme) return;
            updateAccountSettings({ appTheme: value as 'dark' | 'light' });
            showToast(`Switched to ${value === 'dark' ? 'Dark' : 'Light'} theme`, 'info');
          }}
          options={[
            {
              value: 'dark',
              label: 'Dark',
              description: 'Cyber Luxe dark theme — easier on the eyes at night',
            },
            {
              value: 'light',
              label: 'Light',
              description: 'Clean light mode — best in bright surroundings',
            },
          ]}
        />
      </SettingsSection>

      <SettingsSection
        label="Language"
        note="Applies to menus, buttons and system messages on this device."
      >
        <RadioGroup
          label="App language"
          value={settings.language}
          onChange={(value) => {
            if (value === settings.language) return;
            updateAccountSettings({ language: value });
            showToast(`Language set to ${value}`, 'info');
          }}
          options={LANGUAGES.map((lang) => ({ value: lang, label: lang }))}
        />
      </SettingsSection>
    </SettingsPage>
  );
};

export default ThemeLanguagePage;
</file>

<file path="src/pages/CallsTab.tsx">
import React, { useState, useEffect } from 'react';
import { PhoneCall, Video, UserX, Mic, MicOff, PhoneOff, Zap, ShieldCheck, Star } from 'lucide-react';

interface CallsTabProps {
  currentBalance: number;
  onCoinsDeducted: (newBalance: number) => void;
  directCallTarget?: { calleeId: string; name: string; avatar: string } | null;
}

export const CallsTab: React.FC<CallsTabProps> = ({
  currentBalance,
  onCoinsDeducted,
  directCallTarget,
}) => {
  const [inCall, setInCall] = useState(false);
  const [callKind, setCallKind] = useState<'audio' | 'video'>('audio');
  const [anonymousAvatar, setAnonymousAvatar] = useState(true);
  const [callDuration, setCallDuration] = useState(0);
  const [callId, setCallId] = useState<string | null>(null);
  const [micMuted, setMicMuted] = useState(false);
  const [billingToast, setBillingToast] = useState<string | null>(null);
  const [miniGameQuestion, setMiniGameQuestion] = useState('If you could teleport right now, where in Mumbai would we go?');
  const [callEndedRating, setCallEndedRating] = useState(false);

  const calleeName = directCallTarget?.name || 'Ananya';
  const calleeAvatar = directCallTarget?.avatar || '/ananya.jpg';

  // Timer & 60s Billing Tick
  useEffect(() => {
    let timer: any;
    if (inCall) {
      timer = setInterval(() => {
        setCallDuration((prev) => {
          const next = prev + 1;
          // Check for 60-second billing interval
          if (next > 0 && next % 60 === 0 && callId) {
            triggerBillingHeartbeat(callId, next);
          }
          return next;
        });
      }, 1000);
    }
    return () => clearInterval(timer);
  }, [inCall, callId]);

  const triggerBillingHeartbeat = async (activeCallId: string, seconds: number) => {
    try {
      const res = await fetch(`/v1/calls/${activeCallId}/heartbeat`, {
        method: 'POST',
      });
      const data = await res.json();
      if (data.success) {
        onCoinsDeducted(data.caller_balance);
        setBillingToast(`🪙 60s Heartbeat: -${data.rate_per_min} Coins billed. New Balance: ${data.caller_balance}`);
        setTimeout(() => setBillingToast(null), 4000);
      } else if (data.call_status === 'dropped') {
        endCall();
        setBillingToast('⚠️ Call terminated due to insufficient coin balance.');
      }
    } catch (err) {
      console.error('Heartbeat error', err);
    }
  };

  const startCall = async (kind: 'audio' | 'video') => {
    setCallKind(kind);
    setCallEndedRating(false);
    try {
      const res = await fetch('/v1/calls/token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          caller_id: '11111111-1111-1111-1111-111111111111',
          callee_id: directCallTarget?.calleeId || '22222222-2222-2222-2222-222222222222',
          kind,
          anonymous_avatar: anonymousAvatar,
        }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'Failed to start call');
        return;
      }

      setCallId(data.call_id);
      setCallDuration(0);
      setInCall(true);
      setBillingToast(`LiveKit SFU Connected. Billing rate: ${data.rates.spend} coins/min.`);
      setTimeout(() => setBillingToast(null), 4000);
    } catch (err) {
      alert('Network error initiating call.');
    }
  };

  const endCall = async () => {
    if (callId) {
      try {
        await fetch(`/v1/calls/${callId}/end`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating: 5 }),
        });
      } catch (err) {
        console.error(err);
      }
    }
    setInCall(false);
    setCallEndedRating(true);
  };

  const formatTime = (secs: number) => {
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  };

  const nextMiniGame = () => {
    const questions = [
      "Subko or Blue Tokai: Which one wins your vote?",
      "Would you rather never have coffee again or never listen to music?",
      "What is your ultimate go-to guilty pleasure Bollywood track?",
      "If we planned a spontaneous road trip this weekend, where to?",
    ];
    setMiniGameQuestion(questions[Math.floor(Math.random() * questions.length)]);
  };

  return (
    <div style={{ maxWidth: '680px', margin: '20px auto', padding: '0 16px' }}>
      
      {/* Toast Alert */}
      {billingToast && (
        <div style={{ background: 'rgba(255, 45, 85, 0.95)', border: '1px solid #ffffff', borderRadius: 'var(--radius-full)', padding: '10px 20px', fontSize: '13px', fontWeight: 700, color: 'var(--text-primary)', textAlign: 'center', marginBottom: '16px', boxShadow: 'var(--shadow-glow)' }}>
          {billingToast}
        </div>
      )}

      {/* Screen 1: Active LiveKit Call Screen */}
      {inCall ? (
        <div className="glass-panel" style={{ height: '600px', borderRadius: 'var(--radius-lg)', position: 'relative', overflow: 'hidden', display: 'flex', flexDirection: 'column', justifyContent: 'space-between', padding: '24px', background: 'radial-gradient(circle at 50% 30%, rgba(255, 45, 85, 0.15) 0%, var(--bg-dark) 80%)' }}>
          
          {/* Call Header */}
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', background: 'rgba(0, 0, 0, 0.5)', padding: '6px 14px', borderRadius: 'var(--radius-full)', border: '1px solid var(--border-glass)' }}>
              <div style={{ width: '8px', height: '8px', borderRadius: '50%', background: '#00e676', animation: 'pulseGlow 1.5s infinite' }} />
              <span style={{ fontSize: '12px', fontWeight: 700, color: '#00e676' }}>LIVEKIT SFU ENCRYPTED</span>
            </div>

            <div style={{ fontSize: '15px', fontWeight: 800, color: 'var(--text-primary)', background: 'var(--surface-hover)', padding: '6px 14px', borderRadius: 'var(--radius-full)' }}>
              {formatTime(callDuration)}
            </div>
          </div>

          {/* Callee Center Display */}
          <div style={{ textAlign: 'center' }}>
            <div style={{ width: '140px', height: '140px', margin: '0 auto 16px', borderRadius: '50%', padding: '4px', background: anonymousAvatar ? 'var(--gradient-cyan)' : 'var(--gradient-flame)', boxShadow: 'var(--shadow-glow)' }}>
              <img
                src={anonymousAvatar ? '/aditya.jpg' : calleeAvatar}
                alt="Callee"
                style={{ width: '100%', height: '100%', borderRadius: '50%', objectFit: 'cover' }}
              />
            </div>

            <h2 style={{ fontSize: '24px', fontWeight: 800 }}>
              {anonymousAvatar ? 'Anonymous Call Mask' : calleeName}
            </h2>
