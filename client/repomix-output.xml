              <Phone size={16} />
              <span>Audio</span>
            </button>

            <button
              onClick={() => {
                setProfilePreviewUser(null);
                setVideoCallTarget(targetConv);
              }}
              aria-label="Video call"
              style={{
                ...ACTION_BUTTON_STYLE,
                background: 'rgba(155, 81, 224, 0.16)',
                border: '1px solid rgba(155, 81, 224, 0.45)',
                color: '#c084fc',
              }}
            >
              <Video size={16} />
              <span>Video</span>
            </button>
          </div>
        )}

      </div>
    </div>
  );
};
</file>

