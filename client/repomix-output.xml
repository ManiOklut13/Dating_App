            <h3 style={{ fontSize: '17px', fontWeight: 800 }}>Activity Notifications</h3>
          </div>
          <button
            onClick={() => setIsNotificationsOpen(false)}
            style={{ background: 'transparent', border: 'none', color: 'var(--text-secondary)', cursor: 'pointer' }}
          >
            <X size={18} />
          </button>
