        />
      </SettingsSection>

      <SettingsSection label="Something looks wrong">
        <SettingsNavRow
          icon={<Flag size={17} color="#ff4757" />}
          label="Report a Problem"
          hint="Tell us about spam, bugs or anything that feels off"
