              </div>
              <input type="text" value={languagesStr} onChange={(e) => setLanguagesStr(e.target.value)} style={inputBase} />
            </div>
          </div>
        </form>

        {/* Footer */}
        <div
          style={{
            flexShrink: 0,
            padding: '12px 18px calc(12px + env(safe-area-inset-bottom, 0px))',
            borderTop: '1px solid #2a2230',
