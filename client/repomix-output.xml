                    fontWeight: 600,
                    cursor: 'pointer',
                    whiteSpace: 'nowrap',
                    flexShrink: 0,
                  }}
                >
                  {chip.label}
                </button>
              ))}
            </div>

            {/* Chat list */}
            <div style={{ padding: '0 16px' }}>
              {filteredConversations.map((conv) => {
                const isUnread = conv.unread_count > 0;
                const lastMsg = conv.last_message;
                return (
                  <div
                    key={conv.id}
                    onClick={() => onSelectConversation(conv.id)}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '12px',
                      padding: '12px 0',
                      borderBottom: '1px solid #1f1825',
                      cursor: 'pointer',
                      background: conv.is_pinned ? 'linear-gradient(90deg, rgba(255,77,126,0.08) 0%, transparent 100%)' : 'transparent',
                    }}
                  >
                    <div style={{ position: 'relative', flexShrink: 0 }}>
                      <div
                        style={{
                          width: '56px',
                          height: '56px',
                          borderRadius: '50%',
                          background: conv.is_pinned ? 'linear-gradient(135deg, #ff4d7e 0%, #a855f7 100%)' : 'transparent',
                          padding: conv.is_pinned ? '2px' : '0',
                        }}
                      >
                        <img
                          src={conv.counterpart.avatar}
                          alt={conv.counterpart.nickname}
                          style={{ width: '100%', height: '100%', borderRadius: '50%', objectFit: 'cover' }}
                        />
                      </div>
                      {conv.counterpart.is_online && (
                        <span
                          style={{
                            position: 'absolute',
                            bottom: '2px',
                            right: '2px',
                            width: '12px',
                            height: '12px',
                            borderRadius: '50%',
                            background: '#2ed47a',
                            border: '2px solid #0c080e',
                          }}
                        />
                      )}
                    </div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ display: 'flex', alignItems: 'center', gap: '6px', marginBottom: '4px' }}>
                        <span style={{ fontSize: '15px', fontWeight: 700, color: '#fff', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                          {conv.counterpart.nickname}
                        </span>
                        {conv.counterpart.is_verified && (
                          <Check size={14} color="#1d9bf0" fill="#1d9bf0" />
                        )}
                        {conv.is_pinned && <Pin size={12} color="#ff4d7e" style={{ transform: 'rotate(45deg)' }} />}
                      </div>
                      <div
                        style={{
                          fontSize: '13px',
                          color: isUnread ? '#fff' : '#9ca3af',
                          fontWeight: isUnread ? 600 : 400,
                          overflow: 'hidden',
                          textOverflow: 'ellipsis',
                          whiteSpace: 'nowrap',
                          display: 'flex',
                          alignItems: 'center',
                          gap: '4px',
                        }}
                      >
                        {getPreviewText(conv)}
                        {lastMsg?.sender_id === 'me' && (
                          <span style={{ marginLeft: '4px' }}>
                            {lastMsg.status === 'read' ? <CheckCheck size={12} color="#1d9bf0" /> : <Check size={12} color="#9ca3af" />}
                          </span>
                        )}
                      </div>
                    </div>
                    <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: '6px' }}>
                      <span style={{ fontSize: '11px', color: isUnread ? '#ff4d7e' : '#6b7280' }}>
                        {lastMsg ? formatRelativeTime(lastMsg.created_at) : ''}
                      </span>
                      {isUnread && conv.unread_count > 0 && (
                        <span
                          style={{
                            width: '20px',
                            height: '20px',
                            borderRadius: '50%',
                            background: 'linear-gradient(135deg, #ff4d7e 0%, #e0264f 100%)',
                            color: '#fff',
                            fontSize: '11px',
                            fontWeight: 700,
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                          }}
                        >
                          {conv.unread_count}
                        </span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </>
        ) : (
          <div style={{ padding: '16px' }}>
            <div style={{ display: 'flex', gap: '8px', marginBottom: '16px' }}>
              {[
                { key: 'received', label: `Received · ${receivedRequests.length}` },
                { key: 'sent', label: `Sent · ${sentRequests.length}` },
                { key: 'date', label: 'Date invites · 0' },
              ].map((chip) => (
                <button
                  key={chip.key}
                  style={{
                    padding: '8px 16px',
                    borderRadius: '20px',
                    border: '1px solid #2a2030',
                    background: '#14101a',
                    color: '#9ca3af',
                    fontSize: '13px',
                    fontWeight: 600,
                    cursor: 'pointer',
                    whiteSpace: 'nowrap',
                  }}
                >
                  {chip.label}
                </button>
              ))}
            </div>
            {receivedRequests.map((req) => (
              <div
                key={req.id}
                style={{
                  background: '#14101a',
                  border: '1px solid #2a2030',
                  borderRadius: '20px',
                  padding: '16px',
                  marginBottom: '12px',
                }}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: '12px', marginBottom: '12px' }}>
                  <img
                    src={req.avatar}
                    alt={req.nickname}
                    style={{ width: '52px', height: '52px', borderRadius: '50%', objectFit: 'cover' }}
                  />
                  <div style={{ flex: 1 }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: '6px', marginBottom: '2px' }}>
                      <span style={{ fontSize: '16px', fontWeight: 700, color: '#fff' }}>{req.nickname}</span>
                      {req.is_verified && <Check size={14} color="#1d9bf0" fill="#1d9bf0" />}
                      <span
                        style={{
                          padding: '2px 8px',
                          borderRadius: '10px',
                          background: 'rgba(168,85,247,0.2)',
                          color: '#c39bff',
                          fontSize: '11px',
                          fontWeight: 600,
                        }}
                      >
                        {req.vibe_score || 95}% match
                      </span>
                      <span style={{ fontSize: '12px', color: '#9ca3af' }}>· {req.city || '2 km away'}</span>
                    </div>
                    <span style={{ fontSize: '12px', color: '#6b7280' }}>{req.created_at}</span>
                  </div>
                </div>
                <div
                  style={{
                    background: '#0c080e',
                    borderRadius: '12px',
                    padding: '12px',
                    marginBottom: '12px',
                    color: '#d1d5db',
                    fontSize: '14px',
                  }}
                >
                  "{req.message}"
                </div>
                <div style={{ display: 'flex', gap: '8px' }}>
                  <button
                    onClick={() => declineRequest(req.id)}
                    style={{
                      flex: 1,
                      padding: '12px',
                      borderRadius: '12px',
                      background: '#14101a',
                      border: '1px solid #2a2030',
                      color: '#fff',
                      fontSize: '14px',
                      fontWeight: 600,
                      cursor: 'pointer',
                    }}
                  >
                    ✕ Decline
                  </button>
                  <button
                    onClick={() => acceptRequest(req.id)}
                    style={{
                      flex: 1,
                      padding: '12px',
                      borderRadius: '12px',
                      background: 'linear-gradient(135deg, #ff4d7e 0%, #e0264f 100%)',
                      border: 'none',
                      color: '#fff',
                      fontSize: '14px',
                      fontWeight: 600,
                      cursor: 'pointer',
                      boxShadow: '0 4px 16px rgba(255,77,126,0.4)',
                    }}
                  >
                    ♥ Accept
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* Plan a Date picker */}
      {isDateChatPickerOpen && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            zIndex: 9999,
            background: 'rgba(0,0,0,0.88)',
            backdropFilter: 'blur(18px)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            padding: '12px',
          }}
          onClick={() => setIsDateChatPickerOpen(false)}
        >
          <div
            onClick={(e) => e.stopPropagation()}
            style={{
              width: '100%',
              maxWidth: '480px',
              maxHeight: '80vh',
              background: '#121212',
              borderRadius: '24px',
              display: 'flex',
              flexDirection: 'column',
              overflow: 'hidden',
              border: '1px solid rgba(255,45,85,0.2)',
            }}
          >
            <div style={{ padding: '18px 20px 14px', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <h2 style={{ margin: 0, fontSize: '19px', fontWeight: 800, color: '#fff' }}>
                Plan a <span style={{ color: '#ff2d55' }}>Date</span>
              </h2>
              <button
                onClick={() => setIsDateChatPickerOpen(false)}
                style={{ background: 'transparent', border: 'none', color: '#fff', cursor: 'pointer' }}
              >
                <X size={20} />
              </button>
            </div>
            <p style={{ padding: '0 20px', margin: 0, fontSize: '13px', color: '#9ca3af' }}>Pick a chat to plan a date with:</p>
            <div style={{ flex: 1, overflowY: 'auto', padding: '12px' }}>
              {filteredConversations.map((conv) => (
                <button
                  key={conv.id}
                  onClick={() => {
                    setIsDateChatPickerOpen(false);
                    setDatePlannerConv(conv);
                  }}
                  style={{
                    width: '100%',
                    display: 'flex',
                    alignItems: 'center',
                    gap: '12px',
                    padding: '10px 12px',
                    background: 'transparent',
                    border: 'none',
                    color: '#fff',
                    cursor: 'pointer',
                    textAlign: 'left',
                  }}
                >
                  <img
                    src={conv.counterpart.avatar}
                    alt={conv.counterpart.nickname}
                    style={{ width: '44px', height: '44px', borderRadius: '50%' }}
                  />
                  <span style={{ flex: 1 }}>{conv.counterpart.nickname}</span>
                  <Calendar size={16} color="#ffd700" />
                </button>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
</file>

<file path="src/modules/chat/DatePlannerModal.tsx">
import React, { useState } from 'react';
import { useChat } from './ChatContext';
import { Shield } from 'lucide-react';
import {
  planDateTheme,
  Header,
  PartnerCard,
  DateModeCard,
  DateTypeCard,
  VIRTUAL_DATE_TYPES,
  OFFLINE_DATE_TYPES,
  TodosCard,
  NotesCard,
  SplitBillCard,
  AboutPlanDateCard,
  CTAButton,
  MeetupSpotCard,
  DressCodeNotesCard,
  DateProposedScreen,
  AfterTheDateScreen,
  CombinedDateTimeDurationCard,
  DateMode,
  Partner,
  TodoItem,
} from './plan-date';

export const DatePlannerModal: React.FC = () => {
  const { datePlannerConv, setDatePlannerConv, sendMessage, showToast } = useChat();

  // View state
  const [view, setView] = useState<'planning' | 'proposed' | 'after'>('planning');

  // Form state
  const [mode, setMode] = useState<DateMode>('virtual');
  const [partnerSearch, setPartnerSearch] = useState('');
  const [selectedType, setSelectedType] = useState(VIRTUAL_DATE_TYPES[0].id);
  const [selectedDate, setSelectedDate] = useState(new Date());
  const [timeHour, setTimeHour] = useState(19);
  const [timeMinute, setTimeMinute] = useState(30);
  const [timePeriod, setTimePeriod] = useState<'AM' | 'PM'>('PM');
  const [duration, setDuration] = useState(60);
  const [todos, setTodos] = useState<TodoItem[]>([
    { id: 1, text: 'Pick a movie', done: true },
    { id: 2, text: 'Order popcorn', done: false },
    { id: 3, text: 'Set up online game', done: false },
  ]);
  const [proposalNote, setProposalNote] = useState('');
  const [partnerNote, setPartnerNote] = useState('');
  const [yourShare, setYourShare] = useState(50);
  const [selectedSpot, setSelectedSpot] = useState<any>(null);
  const [selectedDressCode, setSelectedDressCode] = useState('Smart casual');

  if (!datePlannerConv) return null;

  const partner: Partner = {
    id: datePlannerConv.counterpart.id,
    name: datePlannerConv.counterpart.nickname,
    avatar: datePlannerConv.counterpart.avatar,
    isOnline: true,
  };

  const partnerNameFirst = datePlannerConv.counterpart.nickname.split(' ')[0];

  const handleModeChange = (newMode: DateMode) => {
    setMode(newMode);
    // Only change toggle and hint text as per requirements - don't reset other values
    // Optional: suggest different to-dos for offline
    if (newMode === 'offline' && todos.some(t => t.text === 'Set up online game')) {
      setTodos([
        { id: 1, text: 'Book a table', done: false },
        { id: 2, text: 'Choose a place', done: false },
        ...todos.filter(t => t.text !== 'Set up online game')
      ]);
    }
  };

  const handleSend = () => {
    if (!partner || !selectedType || !selectedDate) {
      return;
    }

    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'];
    const dateStr = `${monthNames[selectedDate.getMonth()]} ${selectedDate.getDate()}, ${selectedDate.getFullYear()}`;
    const timeStr = `${timeHour}:${timeMinute.toString().padStart(2, '0')} ${timePeriod}`;
    
    const types = mode === 'virtual' ? VIRTUAL_DATE_TYPES : OFFLINE_DATE_TYPES;
    const selectedTypeObj = types.find(t => t.id === selectedType);
    
    const res = sendMessage(datePlannerConv.id, {
      type: 'date_invite',
      body: `Date Invitation: ${selectedTypeObj?.label || selectedType} on ${dateStr} at ${timeStr}`,
      date_invite: {
        id: `date-${Date.now()}`,
        activity: selectedTypeObj?.label || selectedType,
        date: dateStr,
        time: timeStr,
        location: mode === 'virtual' ? 'Virtual' : (selectedSpot?.name || 'To be decided'),
        status: 'pending',
      },
    });
    
    if (res.success) {
      setView('proposed');
    }
  };

  const handleBackToChat = () => {
    showToast({ type: 'success', text: `Date plan sent to ${datePlannerConv.counterpart.nickname}!` });
    setDatePlannerConv(null);
    setView('planning');
  };

  const handleViewAfterDate = () => {
    setView('after');
  };

  const handleBackFromAfter = () => {
    setView('proposed');
  };

  const isDisabled = !partner || !selectedType || !selectedDate;

  if (view === 'proposed') {
    const types = mode === 'virtual' ? VIRTUAL_DATE_TYPES : OFFLINE_DATE_TYPES;
    const selectedTypeObj = types.find(t => t.id === selectedType);
    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'];
    const dateStr = `${monthNames[selectedDate.getMonth()]} ${selectedDate.getDate()}, ${selectedDate.getFullYear()}`;
    const timeStr = `${timeHour}:${timeMinute.toString().padStart(2, '0')} ${timePeriod}`;
    
    return (
      <DateProposedScreen
        partnerName={partnerNameFirst}
        mode={mode}
        dateType={selectedTypeObj?.label || selectedType}
        spotName={selectedSpot?.name}
        date={dateStr}
        time={timeStr}
        duration={duration}
        split={mode === 'virtual' ? `${yourShare}% / ${100-yourShare}%` : `${yourShare}% / ${100-yourShare}%`}
        cost={150}
        onBackToChat={handleBackToChat}
        onViewAfterDate={handleViewAfterDate}
      />
    );
  }

  if (view === 'after') {
    const types = mode === 'virtual' ? VIRTUAL_DATE_TYPES : OFFLINE_DATE_TYPES;
    const selectedTypeObj = types.find(t => t.id === selectedType);
    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'];
    const dateInfo = `${monthNames[selectedDate.getMonth()]} ${selectedDate.getDate()} · ${timeHour}:${timeMinute.toString().padStart(2, '0')} ${timePeriod} · ${duration} min`;
    
    return (
      <AfterTheDateScreen
        mode={mode}
        dateType={selectedTypeObj?.label || selectedType}
        spotName={selectedSpot?.name}
        dateInfo={dateInfo}
        onBack={handleBackFromAfter}
        partnerName={partnerNameFirst}
      />
    );
  }

  const currentTypes = mode === 'virtual' ? VIRTUAL_DATE_TYPES : OFFLINE_DATE_TYPES;

  return (
    <div
      style={{
        position: 'fixed',
        inset: 0,
        zIndex: 9999,
        backgroundColor: 'rgba(0, 0, 0, 0.8)',
        backdropFilter: 'blur(10px)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        padding: '10px',
        fontFamily: planDateTheme.typography.fontFamily,
      }}
      onClick={() => setDatePlannerConv(null)}
    >
      <div
        onClick={(e) => e.stopPropagation()}
        style={{
          width: '100%',
          maxWidth: '390px',
          maxHeight: '95vh',
          backgroundColor: '#0e0a14',
          backgroundImage: `radial-gradient(ellipse 60% 40% at 90% 0%, rgba(233,30,140,0.15) 0%, transparent 60%)`,
          backgroundPosition: 'top right',
          backgroundRepeat: 'no-repeat',
          borderRadius: '18px',
          display: 'flex',
          flexDirection: 'column',
          overflow: 'hidden',
          border: `1px solid #2a2234`,
        }}
      >
        <div style={{ padding: `${planDateTheme.spacing.screenPadding}px ${planDateTheme.spacing.screenPadding}px 0` }}>
          <Header onClose={() => setDatePlannerConv(null)} />
        </div>

        <div
          style={{
            flex: 1,
            overflowY: 'auto',
            overflowX: 'hidden',
            padding: `0 16px`,
            display: 'flex',
            flexDirection: 'column',
            gap: '14px',
          }}
        >
          <PartnerCard
            partner={partner}
            searchValue={partnerSearch}
            onSearchChange={setPartnerSearch}
          />

          <DateModeCard mode={mode} onModeChange={handleModeChange} />

          <DateTypeCard
            types={currentTypes}
            selectedType={selectedType}
            onTypeSelect={setSelectedType}
          />

          {mode === 'offline' && (
            <MeetupSpotCard
              selectedSpot={selectedSpot}
              onSpotSelect={setSelectedSpot}
            />
          )}

          <CombinedDateTimeDurationCard
            selectedDate={selectedDate}
            onDateChange={setSelectedDate}
            hour={timeHour}
            minute={timeMinute}
            period={timePeriod}
            onHourChange={setTimeHour}
            onMinuteChange={setTimeMinute}
            onPeriodChange={setTimePeriod}
            duration={duration}
            onDurationChange={setDuration}
          />

          {mode === 'offline' ? (
            <DressCodeNotesCard
              proposalNote={proposalNote}
              partnerNote={partnerNote}
              onProposalNoteChange={setProposalNote}
              onPartnerNoteChange={setPartnerNote}
              selectedDressCode={selectedDressCode}
              onDressCodeChange={setSelectedDressCode}
            />
          ) : (
            <TodosCard todos={todos} onTodosChange={setTodos} />
          )}

          {mode === 'virtual' && (
            <NotesCard
              proposalNote={proposalNote}
              partnerNote={partnerNote}
              onProposalNoteChange={setProposalNote}
              onPartnerNoteChange={setPartnerNote}
            />
          )}

          {mode === 'offline' && (
            <TodosCard todos={todos} onTodosChange={setTodos} />
          )}

          <SplitBillCard
            yourShare={yourShare}
            onYourShareChange={setYourShare}
            partnerName={partnerNameFirst}
          />
        </div>

        <div style={{ padding: '12px 16px 16px', borderTop: `1px solid #2a2234` }}>
          <CTAButton
            onClick={handleSend}
            cost={150}
            disabled={isDisabled}
            partnerName={partnerNameFirst}
          />
        </div>
      </div>
    </div>
  );
};
</file>

<file path="src/modules/chat/IcebreakerModal.tsx">
import React from 'react';
import { X, Sparkles, Send, Edit3 } from 'lucide-react';
import { useChat } from './ChatContext';
import { ICEBREAKER_PROMPTS } from './mockData';

interface IcebreakerModalProps {
  onInsertToInput: (prompt: string) => void;
}

export const IcebreakerModal: React.FC<IcebreakerModalProps> = ({ onInsertToInput }) => {
  const { icebreakerConv, setIcebreakerConv, sendMessage, showToast } = useChat();

  if (!icebreakerConv) return null;

  const handleSelectPrompt = (prompt: string, sendDirectly: boolean) => {
    if (sendDirectly) {
      const res = sendMessage(icebreakerConv.id, {
        type: 'icebreaker',
        body: prompt,
        icebreaker_prompt: {
          question: prompt,
        },
      });
      if (res.success) {
        showToast({
          type: 'success',
          text: `Icebreaker prompt sent to ${icebreakerConv.counterpart.nickname}!`,
        });
      }
    } else {
      onInsertToInput(prompt);
      showToast({
        type: 'info',
        text: 'Prompt inserted into message composer.',
      });
    }
    setIcebreakerConv(null);
  };

  return (
    <div
      style={{
        position: 'fixed',
        inset: 0,
        zIndex: 9999,
        background: 'rgba(5, 6, 12, 0.85)',
        backdropFilter: 'blur(20px)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        padding: '16px',
      }}
      onClick={() => setIcebreakerConv(null)}
    >
      <div
        className="glass-panel"
        style={{
          width: '100%',
          maxWidth: '500px',
          maxHeight: '85vh',
          borderRadius: 'var(--radius-lg)',
          display: 'flex',
          flexDirection: 'column',
          overflow: 'hidden',
          border: '1px solid var(--border-glass)',
        }}
        onClick={(e) => e.stopPropagation()}
      >
        {/* Header */}
        <div
          style={{
            padding: '16px 20px',
            background: 'var(--bg-dark)',
            borderBottom: '1px solid var(--border-glass)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
            <div
              style={{
                width: '36px',
                height: '36px',
                borderRadius: '50%',
                background: 'rgba(0, 229, 255, 0.15)',
                color: '#00e5ff',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <Sparkles size={18} />
            </div>
            <div>
              <h2 style={{ fontSize: '18px', fontWeight: 800 }}>Dating Icebreakers</h2>
              <p style={{ fontSize: '11px', color: 'var(--text-secondary)' }}>
                Spark engaging conversations with {icebreakerConv.counterpart.nickname}
              </p>
            </div>
          </div>

          <button
            onClick={() => setIcebreakerConv(null)}
            style={{
              background: 'transparent',
              border: 'none',
              color: 'var(--text-secondary)',
              cursor: 'pointer',
            }}
          >
            <X size={20} />
          </button>
        </div>

        {/* Prompt List */}
        <div style={{ flex: 1, overflowY: 'auto', padding: '16px 20px', display: 'flex', flexDirection: 'column', gap: '10px' }}>
          {ICEBREAKER_PROMPTS.map((prompt, index) => (
            <div
              key={index}
              style={{
                padding: '14px 16px',
                borderRadius: 'var(--radius-md)',
                background: 'var(--surface-faint)',
                border: '1px solid var(--border-glass)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'space-between',
                gap: '12px',
                transition: 'all var(--transition-fast)',
              }}
            >
              <div style={{ fontSize: '13.5px', fontWeight: 600, color: 'var(--text-primary)', flex: 1 }}>
                "{prompt}"
              </div>

              <div style={{ display: 'flex', gap: '6px' }}>
                <button
                  onClick={() => handleSelectPrompt(prompt, false)}
                  className="btn-ghost"
