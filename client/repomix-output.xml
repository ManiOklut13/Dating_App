            }}
          >
            <button
              onClick={() => {
                setProfilePreviewUser(null);
                setDatePlannerConv(targetConv);
              }}
              style={{
                ...ACTION_BUTTON_STYLE,
                background: 'rgba(255, 45, 85, 0.14)',
