                  fontWeight: 800,
                  fontSize: '16px',
                  color: '#F5F2F7',
                  whiteSpace: 'nowrap',
                  overflow: 'hidden',
                  textOverflow: 'ellipsis',
                }}
              >
                {conversation.counterpart.nickname}
              </span>
              {conversation.counterpart.is_verified && <span className="badge-blue-tick" style={{ flexShrink: 0 }}>✓</span>}
            </div>
            <div style={{ fontSize: '12px', color: '#B3AEC0', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
              {getStatus(conversation.counterpart.id) === 'online' ? 'Online' : (conversation.counterpart.last_seen ? `Last seen ${conversation.counterpart.last_seen}` : 'Last seen recently')}
            </div>
          </div>
        </div>

        {/* Right: Call and Calendar buttons */}
        <div style={{ display: 'flex', alignItems: 'center', gap: '8px', flexShrink: 0 }}>
          <button
            onClick={() => navigateCalls({ name: 'calls' })}
            style={{
              width: '44px',
              height: '44px',
              borderRadius: '50%',
              background: '#1A1722',
              border: 'none',
              color: '#4ADE80',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              cursor: 'pointer',
            }}
            title="Call"
            aria-label="Call"
          >
            <PhoneCall size={20} />
          </button>

          <button
            onClick={() => setDatePlannerConv(conversation)}
            style={{
              width: '44px',
              height: '44px',
              borderRadius: '50%',
              background: '#1A1722',
              border: 'none',
              color: '#FFC93C',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              cursor: 'pointer',
            }}
            title="Plan a Date"
            aria-label="Plan a date"
          >
            <Calendar size={20} />
          </button>

          <button
            onClick={() => setIsMenuOpen(true)}
            style={{
              width: '44px',
              height: '44px',
              borderRadius: '50%',
              background: '#1A1722',
              border: 'none',
              color: '#F5F2F7',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              cursor: 'pointer',
            }}
            title="More"
            aria-label="More options"
          >
            <MoreVertical size={20} />
          </button>
        </div>
      </div>

      {/* ================= SECURITY GUARD RIBBON ================= */}
      <div style={{ padding: '8px 14px', flexShrink: 0 }}>
        <div
          style={{
            padding: '8px 12px',
            background: '#2A1220',
            borderRadius: '12px',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            gap: '8px',
            fontSize: '11px',
            color: '#FFB3C7',
            fontFamily: "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif",
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', minWidth: 0 }}>
            <Shield size={16} color="#FF3D77" style={{ flexShrink: 0 }} />
            <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
              Trust Guard: Stay safe while chatting
            </span>
          </div>

          <button
            onClick={() => setIsScreenshotModalOpen(true)}
            style={{
              background: 'rgba(255, 61, 119, 0.2)',
              border: '1px solid rgba(255, 61, 119, 0.4)',
              color: '#FFB3C7',
              padding: '4px 8px',
              borderRadius: '999px',
              fontSize: '10px',
              fontWeight: 700,
              cursor: 'pointer',
              flexShrink: 0,
              whiteSpace: 'nowrap',
            }}
            title="Screenshot Guard"
          >
            Screenshot Guard
          </button>
        </div>
      </div>

      {/* ================= MESSAGES STREAM ================= */}
      <div
        onClick={() => {
          if (activePickerTab !== 'none') {
            setActivePickerTab('none');
            return;
          }
          inputRef.current?.focus();
        }}
        style={{
          flex: 1,
          minHeight: 0,
          overflowY: 'auto',
          overflowX: 'hidden',
          padding: '16px',
          display: 'flex',
          flexDirection: 'column',
          gap: '12px',
          WebkitOverflowScrolling: 'touch',
        }}
      >
        {activeMessages.map((msg) => {
          const isMe = msg.sender_id === 'me';
          const isSystem = msg.sender_id === 'system';

          // System message banner (e.g. It's a match!)
          if (isSystem) {
            return (
              <div
                key={msg.id}
                style={{
                  alignSelf: 'center',
                  maxWidth: 'min(85%, 560px)',
                  padding: '10px 18px',
                  borderRadius: 'var(--radius-full)',
                  background: 'rgba(255, 45, 85, 0.12)',
                  border: '1px solid rgba(255, 45, 85, 0.35)',
                  color: 'var(--text-primary)',
                  fontSize: '12px',
                  fontWeight: 600,
                  textAlign: 'center',
                  margin: '8px 0',
                  boxShadow: 'var(--shadow-sm)',
                }}
              >
                {msg.body}
              </div>
            );
          }

          return (
            <div
              key={msg.id}
              style={{
                alignSelf: isMe ? 'flex-end' : 'flex-start',
                maxWidth: 'min(80%, 520px)',
                minWidth: 0,
                display: 'flex',
                flexDirection: 'column',
                alignItems: isMe ? 'flex-end' : 'flex-start',
              }}
            >
              {/* Message Bubble Container */}
              <div
                style={{
                  borderRadius: '18px',
                  borderTopRightRadius: isMe ? '6px' : '18px',
                  borderTopLeftRadius: !isMe ? '6px' : '18px',
                  background: isMe
                    ? 'linear-gradient(135deg, #FF3D77 0%, #B45CFF 100%)'
                    : '#1E1A28',
                  color: '#F5F2F7',
                  fontSize: '14px',
                  lineHeight: 1.4,
                  padding: msg.type === 'image' ? '4px' : '10px 14px',
                  overflow: 'hidden',
                  maxWidth: '75%',
                  minWidth: 0,
                  overflowWrap: 'anywhere',
                  wordBreak: 'break-word',
                }}
              >
                {/* 1. TEXT */}
                {msg.type === 'text' && <div>{msg.body}</div>}

                {/* 2. IMAGE */}
                {msg.type === 'image' && (
                  <div>
                    <img
                      src={msg.media_url}
                      alt="Shared media"
                      style={{
                        width: '100%',
                        maxHeight: '260px',
                        objectFit: 'cover',
                        borderRadius: '14px',
                        display: 'block',
                      }}
                    />
                    {msg.body && msg.body !== 'Shared a photo' && (
                      <div style={{ padding: '8px 10px', fontSize: '13px' }}>{msg.body}</div>
                    )}
                  </div>
                )}

                {/* 3. GIF */}
                {msg.type === 'gif' && (
                  <div style={{ position: 'relative' }}>
                    <img
                      src={msg.media_url}
                      alt="GIF"
                      style={{
                        width: '100%',
                        maxHeight: '220px',
                        objectFit: 'cover',
                        borderRadius: '14px',
                        display: 'block',
                      }}
                    />
                    <div
                      style={{
                        position: 'absolute',
                        bottom: '6px',
                        left: '6px',
                        background: 'rgba(0,0,0,0.6)',
                        padding: '2px 6px',
                        borderRadius: '4px',
                        fontSize: '9px',
                        fontWeight: 700,
                      }}
                    >
                      GIF
                    </div>
                  </div>
                )}

                {/* 4. VOICE NOTE */}
                {msg.type === 'audio' && (
                  <div
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '10px',
                      minWidth: 'min(260px, 72vw)',
                      padding: '4px 2px',
                    }}
                  >
                    {/* Avatar */}
                    <div
                      style={{
                        width: '34px',
                        height: '34px',
                        borderRadius: '50%',
                        flexShrink: 0,
                        overflow: 'hidden',
                        border: `2px solid ${isMe ? 'rgba(255,255,255,0.4)' : 'var(--border-glass)'}`,
                      }}
                    >
                      <img
                        src={isMe ? '/aditya.jpg' : conversation.counterpart.avatar}
                        alt=""
                        style={{ width: '100%', height: '100%', objectFit: 'cover' }}
                      />
                    </div>

                    {/* Play / Pause */}
                    <button
                      onClick={() => handleTogglePlayAudio(msg.id)}
                      style={{
                        width: '36px',
                        height: '36px',
                        borderRadius: '50%',
                        background: isMe ? '#ffffff' : 'var(--gradient-flame)',
                        color: isMe ? '#ff2d55' : '#ffffff',
                        border: 'none',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        cursor: 'pointer',
                        flexShrink: 0,
                        boxShadow: isMe ? '0 2px 6px rgba(0,0,0,0.25)' : 'var(--shadow-glow)',
                      }}
                    >
                      {playingAudioId === msg.id ? <Pause size={16} /> : <Play size={16} style={{ marginLeft: '2px' }} />}
                    </button>

                    {/* Waveform + duration */}
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div
                        style={{
                          display: 'flex',
                          alignItems: 'center',
                          gap: '2px',
                          height: '24px',
                          cursor: 'pointer',
                        }}
                        onClick={(e) => {
                          const rect = e.currentTarget.getBoundingClientRect();
                          const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                          setAudioProgress((prev) => ({ ...prev, [msg.id]: ratio }));
                          if (playingAudioId !== msg.id) handleTogglePlayAudio(msg.id);
                        }}
                      >
                        {[8, 14, 18, 12, 16, 9, 14, 17, 10, 13, 8, 15, 11, 19, 7].map((h, i, arr) => {
                          const progress = audioProgress[msg.id] ?? 0;
                          const filled = i / arr.length <= progress;
                          return (
                            <span
                              key={i}
                              style={{
                                flex: 1,
                                height: `${playingAudioId === msg.id ? Math.max(6, h + (i % 3) * 3) : h}px`,
                                borderRadius: '2px',
                                background: filled
                                  ? isMe
                                    ? 'rgba(255,255,255,0.95)'
                                    : '#ffffff'
                                  : isMe
                                    ? 'rgba(255,255,255,0.35)'
                                    : 'rgba(255,255,255,0.3)',
                                transition: 'background 0.15s ease, height 0.15s ease',
                              }}
                            />
                          );
                        })}
                      </div>
                      <div style={{ fontSize: '10px', opacity: 0.85, marginTop: '3px', fontFamily: 'monospace' }}>
                        {playingAudioId === msg.id
                          ? `${formatAudioTime((audioProgress[msg.id] ?? 0) * parseDuration(msg.audio_duration))} / ${msg.audio_duration || '0:14'}`
                          : msg.audio_duration || '0:14'}
                      </div>
                    </div>

                    {/* Playback speed */}
                    <button
                      onClick={() =>
                        setAudioSpeed((prev) => {
                          const cur = prev[msg.id] || '1x';
                          const next = cur === '1x' ? '1.5x' : cur === '1.5x' ? '2x' : '1x';
                          return { ...prev, [msg.id]: next };
                        })
                      }
                      style={{
                        fontSize: '10px',
                        fontWeight: 800,
                        color: isMe ? '#ff2d55' : '#ffffff',
                        background: isMe ? 'rgba(255,255,255,0.85)' : 'rgba(255,255,255,0.15)',
                        border: 'none',
                        borderRadius: 'var(--radius-full)',
                        padding: '3px 6px',
                        cursor: 'pointer',
                        flexShrink: 0,
                      }}
                    >
                      {audioSpeed[msg.id] || '1x'}
                    </button>
                  </div>
                )}

                {/* 5. STICKER */}
                {msg.type === 'sticker' && (
                  <div style={{ padding: '4px 6px', textAlign: 'center' }}>
                    <div style={{ fontSize: '38px', marginBottom: '4px' }}>
                      {msg.media_url || '💖'}
                    </div>
                    <div style={{ fontSize: '12px', fontWeight: 700 }}>{msg.body}</div>
                  </div>
                )}

                {/* 6. ICEBREAKER CARD */}
                {msg.type === 'icebreaker' && (
                  <div style={{ padding: '4px' }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: '4px', fontSize: '10px', color: '#ffd700', fontWeight: 700, textTransform: 'uppercase', marginBottom: '4px' }}>
                      <Sparkles size={12} />
                      <span>Icebreaker Prompt</span>
                    </div>
                    <div style={{ fontSize: '13px', fontWeight: 700, marginBottom: '6px' }}>
                      "{msg.icebreaker_prompt?.question || msg.body}"
                    </div>
                    {msg.icebreaker_prompt?.answer && (
                      <div
                        style={{
                          fontSize: '12px',
                          color: 'rgba(255,255,255,0.9)',
                          background: 'rgba(0,0,0,0.2)',
                          padding: '6px 8px',
                          borderRadius: '8px',
                        }}
                      >
                        {msg.icebreaker_prompt.answer}
                      </div>
                    )}
                  </div>
                )}

                {/* 7. DATE INVITATION CARD */}
                {msg.type === 'date_invite' && msg.date_invite && (
                  <div style={{ minWidth: 'min(220px, 72vw)', padding: '6px 2px' }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: '6px', fontSize: '11px', color: '#ffd700', fontWeight: 800, textTransform: 'uppercase', marginBottom: '6px' }}>
                      <Calendar size={13} />
                      <span>Official Date Invitation</span>
                    </div>

                    <div style={{ fontSize: '14px', fontWeight: 800, marginBottom: '4px' }}>
                      {msg.date_invite.activity}
                    </div>

                    <div style={{ fontSize: '12px', color: 'rgba(255,255,255,0.85)', marginBottom: '2px' }}>
                      📅 {msg.date_invite.date} • ⏰ {msg.date_invite.time}
                    </div>

                    {msg.date_invite.location && (
                      <div style={{ fontSize: '11px', color: 'var(--cyan-vibe)', marginBottom: '10px' }}>
                        📍 {msg.date_invite.location}
                      </div>
                    )}

                    {/* Status / Response Buttons */}
                    {msg.date_invite.status === 'accepted' ? (
                      <div
                        style={{
                          background: 'rgba(0, 230, 118, 0.2)',
                          border: '1px solid #00e676',
                          color: '#00e676',
                          padding: '6px 10px',
                          borderRadius: 'var(--radius-sm)',
                          fontSize: '11px',
                          fontWeight: 700,
                          textAlign: 'center',
                        }}
                      >
                        ✓ Date Confirmed & Accepted! 🎉
                      </div>
                    ) : msg.date_invite.status === 'declined' ? (
                      <div
                        style={{
                          background: 'rgba(255, 71, 87, 0.2)',
                          border: '1px solid #ff4757',
                          color: '#ff4757',
                          padding: '6px 10px',
                          borderRadius: 'var(--radius-sm)',
                          fontSize: '11px',
                          fontWeight: 700,
                          textAlign: 'center',
                        }}
                      >
                        Date Declined
                      </div>
                    ) : (
                      <div style={{ display: 'flex', gap: '6px', marginTop: '8px' }}>
                        <button
                          onClick={() => respondToDateInvite(conversation.id, msg.id, true)}
                          style={{
                            flex: 1,
                            background: '#00e676',
                            border: 'none',
                            color: '#000000',
                            padding: '6px',
                            borderRadius: 'var(--radius-sm)',
                            fontSize: '11px',
                            fontWeight: 700,
                            cursor: 'pointer',
                          }}
                        >
                          Accept Date 🎉
                        </button>
                        <button
                          onClick={() => respondToDateInvite(conversation.id, msg.id, false)}
                          style={{
                            background: 'var(--surface-hover)',
                            border: '1px solid var(--border-glass)',
                            color: 'var(--text-primary)',
                            padding: '6px 10px',
                            borderRadius: 'var(--radius-sm)',
                            fontSize: '11px',
                            cursor: 'pointer',
                          }}
                        >
                          Decline
                        </button>
                      </div>
                    )}
                  </div>
                )}
              </div>

              {/* Timestamp & Read Receipts */}
              <div
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: '4px',
                  marginTop: '4px',
                  fontSize: '10px',
                  color: 'var(--text-muted)',
                }}
              >
                <span>
                  {new Date(msg.created_at).toLocaleTimeString([], {
                    hour: '2-digit',
                    minute: '2-digit',
                  })}
                </span>
                {isMe && (
                  <span>
                    {msg.status === 'read' ? (
                      <CheckCheck size={12} color="#00e5ff" />
                    ) : (
                      <Check size={12} />
                    )}
                  </span>
                )}
                {msg.vanish_seconds && (
                  <span style={{ color: '#ff2d55', display: 'flex', alignItems: 'center', gap: '2px' }}>
                    <Flame size={10} /> vanish
                  </span>
                )}
              </div>
            </div>
          );
        })}
        <div ref={messagesEndRef} />
      </div>

      {/* ================= IMAGE PREVIEW MODAL BEFORE SEND ================= */}
      {pendingImages.length > 0 && (
        <div
          style={{
            position: 'absolute',
            inset: 0,
            background: 'var(--bg-dark)',
            zIndex: 40,
            display: 'flex',
            flexDirection: 'column',
            justifyContent: 'space-between',
            padding: '20px',
          }}
        >
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <span style={{ fontSize: '15px', fontWeight: 700 }}>
              Preview Photos
              <span style={{ marginLeft: '8px', fontSize: '12px', color: 'var(--text-muted)' }}>
                {pendingImages.length}/{MAX_PHOTOS}
              </span>
            </span>
            <button
              onClick={() => {
                setPendingImages([]);
                setImageCaption('');
              }}
              style={{ background: 'transparent', border: 'none', color: 'var(--text-primary)', cursor: 'pointer' }}
            >
              <X size={20} />
            </button>
          </div>

          <div
            style={{
              flex: 1,
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              padding: '16px',
              minHeight: 0,
            }}
          >
            <div
              style={{
                display: 'grid',
                gridTemplateColumns: pendingImages.length === 1 ? '1fr' : 'repeat(2, 1fr)',
                gap: '10px',
                width: '100%',
                maxWidth: '420px',
                maxHeight: '60vh',
                overflowY: 'auto',
              }}
            >
              {pendingImages.map((img, index) => (
                <div
                  key={img.url}
                  style={{ position: 'relative', borderRadius: 'var(--radius-md)', overflow: 'hidden', aspectRatio: '1 / 1' }}
                >
                  <img
                    src={img.url}
                    alt={`Preview ${index + 1}`}
                    style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }}
                  />
                  <button
                    type="button"
                    onClick={() => handleRemovePendingImage(index)}
                    aria-label={`Remove photo ${index + 1}`}
                    style={{
                      position: 'absolute',
                      top: '6px',
                      right: '6px',
                      width: '24px',
                      height: '24px',
                      borderRadius: '50%',
                      background: 'rgba(0, 0, 0, 0.65)',
                      border: '1px solid rgba(255, 255, 255, 0.25)',
                      color: '#ffffff',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      cursor: 'pointer',
                      padding: 0,
                    }}
                  >
                    <X size={13} />
                  </button>
                </div>
              ))}
            </div>
          </div>

          <div style={{ display: 'flex', gap: '10px' }}>
            <input
              type="text"
              value={imageCaption}
              onChange={(e) => setImageCaption(e.target.value)}
              placeholder="Add a caption..."
              style={{
                flex: 1,
                padding: '12px 16px',
                borderRadius: 'var(--radius-full)',
                background: 'var(--surface-strong)',
                border: '1px solid var(--border-glass)',
                color: 'var(--text-primary)',
                outline: 'none',
                fontSize: '13px',
              }}
            />
            <button
              onClick={handleConfirmImageUpload}
              className="btn-primary"
              style={{ padding: '12px 20px', borderRadius: 'var(--radius-full)', whiteSpace: 'nowrap' }}
            >
              <Send size={16} />
              Send {pendingImages.length === 1 ? 'Photo' : `${pendingImages.length} Photos`}
            </button>
          </div>
        </div>
      )}

      {/* ================= VOICE RECORDING BAR SIMULATION ================= */}
      {isRecording && (
        <div
          style={{
            padding: '12px 16px',
            background: 'rgba(255, 45, 85, 0.15)',
            borderTop: '1px solid #ff2d55',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            zIndex: 30,
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
            <div
              style={{
                width: '12px',
                height: '12px',
                borderRadius: '50%',
                background: '#ff2d55',
                animation: 'pulseGlow 1s infinite ease-in-out',
              }}
            />
            <span style={{ fontSize: '13px', fontWeight: 700, color: 'var(--text-primary)' }}>
              Recording Audio Note: 0:{recordingSeconds < 10 ? '0' : ''}{recordingSeconds}
            </span>
          </div>

          <div style={{ display: 'flex', gap: '8px' }}>
            <button
              onClick={() => setIsRecording(false)}
              className="btn-ghost"
              style={{ padding: '6px 12px', fontSize: '12px' }}
            >
              Cancel
            </button>
            <button
              onClick={handleSendVoiceNote}
              className="btn-primary"
              style={{ padding: '6px 16px', fontSize: '12px', gap: '4px' }}
            >
              <Send size={13} />
              Send
            </button>
          </div>
        </div>
      )}

      {/* Attachment Menu */}
      {isAttachMenuOpen && (
        <>
          <div
            onClick={() => setIsAttachMenuOpen(false)}
            style={{
              position: 'absolute',
              inset: 0,
              background: 'rgba(0,0,0,0.5)',
              zIndex: 40,
            }}
          />
          <div
            style={{
              position: 'absolute',
              left: 0,
              right: 0,
              bottom: 0,
              background: '#12101A',
              borderTop: '1px solid #26212F',
              borderRadius: '20px 20px 0 0',
              padding: '16px',
              display: 'flex',
              flexDirection: 'column',
              gap: '10px',
              zIndex: 50,
