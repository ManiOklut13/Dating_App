// ─────────────────────────────────────────────────────────────────────────────
// Video Tab
// ─────────────────────────────────────────────────────────────────────────────
class _VideoTab extends StatelessWidget {
  const _VideoTab();

  void _startVideoCall(BuildContext context, CallUser user) {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => VideoCallScreen(user: user),
        fullscreenDialog: true,
      ),
    );
  }

  @override
