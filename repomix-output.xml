  Widget _buildAboutMeCard(
    BuildContext context,
    UserProfileModel profile,
    YoUnMeThemeExtension theme,
    bool isDark,
  ) {
    return _buildCardWrapper(
      title: 'About Me',
      icon: Icons.person_outline,
