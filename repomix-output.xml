}

.btn-snooze {
  color: #70a1ff;
  border-color: rgba(112, 161, 255, 0.3);
}

/* Badges */
.badge-blue-tick {
  background: #1da1f2;
  color: white;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
