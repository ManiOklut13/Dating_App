 * Aligned strictly with PostgreSQL schema tables "meetup" and "date_memories".
 */

export type MeetupStatus =
  | 'pending'
  | 'scheduled'
  | 'completed'
  | 'cancelled'
  | 'declined'
  | 'missed'
  | 'reported';

