# ─────────────────────────────────────────────────────────────────────────────
# YoUnMe — Worker Environment Variables (.env.example)
# Copy this file to .env and fill in real values.
# The .env file is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev (default): redis://localhost:6379
# Cloud Run + Memorystore: redis://<PRIVATE_IP>:6379
REDIS_URL=redis://localhost:6379

# ── Supabase (Server-Side Only) ───────────────────────────────────────────────
# Obtain from: Supabase Dashboard → Project → API Settings
# The service-role key bypasses RLS. Keep it strictly server-side.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Supabase Storage SSRF Guard ───────────────────────────────────────────────
# Only image URLs starting with this prefix will be accepted for Vision scanning.
# Example: https://your-project-id.supabase.co/storage/v1/object/public/media/
SUPABASE_STORAGE_BUCKET_PREFIX=https://your-project-id.supabase.co/storage/v1/object/public/media/

# ── Google Cloud Vision API ───────────────────────────────────────────────────
# Option A: Path to a service-account JSON key file (dev/local)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# Option B: On Cloud Run with Workload Identity, omit GOOGLE_APPLICATION_CREDENTIALS
# and assign the "Cloud Vision API User" IAM role to the Cloud Run service account.

# Your GCP project ID (used for Vision API client init)
GCLOUD_PROJECT_ID=your-gcp-project-id

# ── Firebase Cloud Messaging (FCM) ────────────────────────────────────────────
# Used exclusively for mobile push delivery (FCM v1).
# Option A: Path to service account JSON, or raw JSON string, or base64 JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=your-firebase-service-account-key-json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Option B: On Cloud Run with Workload Identity or GOOGLE_APPLICATION_CREDENTIALS,
# the Firebase Admin SDK can use Application Default Credentials automatically.

# ── Worker Tuning ─────────────────────────────────────────────────────────────
# Number of jobs processed concurrently per queue (default: 3)
WORKER_CONCURRENCY=3

# Maximum Vision API retries before job moves to failed state (default: 3)
VISION_MAX_RETRIES=3

# Maximum FCM Push Delivery retries (default: 3)
PUSH_MAX_RETRIES=3

NODE_ENV=development
</file>

<file path="Dockerfile">
# ─────────────────────────────────────────────────────────────────────────────
# YoUnMe — Background Worker Dockerfile
# Target: Google Cloud Run (asia-south1 Mumbai)
# Config: 1 vCPU, 512 MiB RAM, min-instances=1 (avoids cold-start on first job)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first (layer-caching)
COPY package*.json ./
RUN npm ci --include=dev

# Copy source and compile TypeScript
COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build

# ── Stage 2: Production image ─────────────────────────────────────────────────
FROM node:20-alpine AS production

# Non-root user for Cloud Run security best practices
RUN addgroup -S worker && adduser -S worker -G worker

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy compiled output from builder stage
COPY --from=builder /app/dist ./dist

# Do NOT copy src/ or tsconfig.json into the production image

USER worker

ENV NODE_ENV=production

# Cloud Run supplies PORT; this worker does not listen on a port but the
# variable is here for health-check compatibility if a /health endpoint
# is added later.
ENV PORT=8082

# Structured log output (single-line JSON is preferred by Cloud Logging)
ENV NODE_OPTIONS="--enable-source-maps"

# The worker process must not exit after processing a single job.
# It stays alive waiting for new Redis jobs until SIGTERM is received.
CMD ["node", "dist/index.js"]
</file>

<file path="jest.resolver.cjs">
/**
 * Custom Jest resolver for ESM TypeScript projects.
 * Remaps .js imports to .ts so jest finds TypeScript source files.
 * Must be CommonJS (.cjs).
 */

const path = require('path');

module.exports = (request, options) => {
  // Remap relative .js imports → .ts
  if (request.startsWith('.') && request.endsWith('.js')) {
    const tsRequest = request.slice(0, -3) + '.ts';
    try {
      return options.defaultResolver(tsRequest, options);
    } catch {
      // .ts not found — fall through to try original .js
    }
  }
  return options.defaultResolver(request, options);
};
</file>

