    // Deduct 20 coin fee for AI sticker generation
    const debitResult = await this.walletService.executeAtomicLedgerTransaction(
      userId,
      'outgoing',
      'sparks_coins_spent',
      STICKER_GENERATION_COIN_FEE,
    );

    // Find the targeted memory
    let memoryRow: any = null;
