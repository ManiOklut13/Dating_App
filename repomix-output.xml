  console.log(`      • Balance After:  ${afterCoins} (Expected: ${initialCoins + 100})`);
  console.log(`      • Live SQL Match: ${afterCoins === initialCoins + 100 ? 'YES ✅' : 'NO ❌'}`);

  // Also verify transaction logged in wallet_transactions table
