  // --------------------------------------------------------------------------
  // TEST SCENARIO B: Meetup / Dating (POST -> PUT -> GET + Direct DB Query)
  // --------------------------------------------------------------------------
  console.log('\n--- [SCENARIO 2] MEETUP REAL-LIFE DATES: POST -> PUT -> GET ---');

  const uniqueVenue = `Starbucks Reserve #${Date.now().toString().slice(-4)}`;

