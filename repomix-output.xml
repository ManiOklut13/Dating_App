import {
  Controller,
  Get,
  Post,
  Body,
  Query,
  UseGuards,
  UsePipes,
  ValidationPipe,
} from '@nestjs/common';
import { HomeService } from './home.service.js';
import { SupabaseAuthGuard } from '../../common/guards/supabase-auth.guard.js';
