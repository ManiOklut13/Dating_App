                              color: PDColors.textViolet, size: 20),
                        ),
                      ),
                    ),
                  ),
                  // OSM Attribution
                  const Positioned(
                    bottom: 4,
                    left: 0,
                    right: 0,
                    child: Center(
                      child: Text(
