/**
 * YoUnMe Dating App — Master Database Service & PostGIS Adapter
 * Supports both Live Supabase PostgreSQL + PostGIS and In-Memory PostGIS Engine.
 */

export interface User {
  id: string;
  phone: string;
  email?: string;
  google_id?: string;
  dob?: string;
  gender: string;
  is_verified: boolean;
  status: 'active' | 'suspended' | 'pending_otp';
  created_at: string;
