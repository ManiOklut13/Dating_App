  List<ChatConversationModel> get conversations => _conversations;

  void markAsRead(String conversationId) {
    _conversations = _conversations.map((c) {
      if (c.id == conversationId) {
        return c.copyWith(unreadCount: 0);
      }
      return c;
    }).toList();
    notifyListeners();
  }

  void sendMessage(
    String conversationId,
    String text, {
    String type = 'text',
    String? mediaUrl,
  }) {
    if (text.trim().isEmpty && mediaUrl == null) return;

    final newMsg = ChatMessageModel(
      id: 'msg-${DateTime.now().millisecondsSinceEpoch}',
      senderId: 'me',
      body: text.trim(),
      timestamp: 'Just now',
      isMe: true,
      type: type,
      mediaUrl: mediaUrl,
    );

    _conversations = _conversations.map((c) {
      if (c.id == conversationId) {
        final updatedMsgs = List<ChatMessageModel>.from(c.messages)..add(newMsg);
        return c.copyWith(
          messages: updatedMsgs,
          lastMessage: type == 'sticker'
              ? 'Sticker sent'
              : (type == 'image'
                  ? 'Photo sent'
                  : (type == 'date_plan' ? 'Date Invitation sent' : text.trim())),
          timestamp: 'Just now',
        );
      }
      return c;
    }).toList();
    notifyListeners();
