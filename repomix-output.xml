<file path="src/processors/contact-guard.processor.ts">
/**
 * YoUnMe Worker — Contact Guard Audit Processor
 *
 * Responsibility: Write an immutable, deduplicated audit record for every
 * Contact Guard violation that was blocked in the NestJS REST layer or the
 * Go real-time layer.
 *
 * This worker does NOT perform contact detection — that is the responsibility
 * of the NestJS chat.controller.ts and Go guard/link_guard.go which act
 * in-flight before message delivery. This processor only persists the audit
 * trail so violations survive process restarts and are queryable.
 *
 * Strike accumulation logic (suspension thresholds, cooldowns) lives in
 * the NestJS API layer where it is authoritative. This processor only writes
 * to the audit table.
 *
 * Idempotency: The `idempotency_key` field maps to a UNIQUE constraint on
 * `contact_guard_audits.idempotency_key`. A duplicate enqueue is silently
 * ignored (no double-strike).
 */

import { z } from 'zod';
import { getSupabaseClient } from '../supabase.js';

// ─── Payload Validation ──────────────────────────────────────────────────────

export const ContactGuardAuditJobSchema = z.object({
  user_id: z.string().uuid('user_id must be a valid UUID'),
  conversation_id: z.string().uuid('conversation_id must be a valid UUID'),
  detected_type: z.enum(['phone_number', 'social_handle', 'external_url']),
  /**
   * Normalised excerpt from the NestJS producer.
   * Must NOT contain raw phone numbers or personal data.
   * Max 200 chars enforced here as a safety net.
   */
  normalised_excerpt: z.string().max(200),
  idempotency_key: z.string().min(1).max(128),
});

export type ContactGuardAuditJob = z.infer<typeof ContactGuardAuditJobSchema>;

// ─── Result ──────────────────────────────────────────────────────────────────

export interface AuditResult {
  idempotency_key: string;
  duplicate: boolean;
  persisted: boolean;
}

// ─── Main Processor ──────────────────────────────────────────────────────────

export async function processContactGuardAudit(rawJob: unknown): Promise<AuditResult> {
  // 1. Validate payload
  const parseResult = ContactGuardAuditJobSchema.safeParse(rawJob);
  if (!parseResult.success) {
    const issues = parseResult.error.issues.map((i) => i.message).join('; ');
    throw new Error(`[ContactGuard] Invalid job payload: ${issues}`);
  }
  const job: ContactGuardAuditJob = parseResult.data;

  console.log(
    `[ContactGuard] Audit — user=${job.user_id} conv=${job.conversation_id} ` +
      `type=${job.detected_type} key=${job.idempotency_key}`,
  );

  const supabase = getSupabaseClient();

  if (!supabase) {
    // No Supabase in dev/test — log only
    console.log(
      `[ContactGuard] Supabase not configured. Audit record NOT persisted. ` +
        `key=${job.idempotency_key}`,
    );
    return { idempotency_key: job.idempotency_key, duplicate: false, persisted: false };
  }

  // 2. Check for existing record (idempotency)
  const { data: existing, error: selectError } = await supabase
    .from('contact_guard_audits')
    .select('idempotency_key')
    .eq('idempotency_key', job.idempotency_key)
    .maybeSingle();

  if (selectError) {
    throw new Error(`[ContactGuard] DB read error: ${selectError.message}`);
  }

  if (existing) {
    console.log(`[ContactGuard] Duplicate audit — key=${job.idempotency_key} ignored.`);
    return { idempotency_key: job.idempotency_key, duplicate: true, persisted: false };
  }

  // 3. Insert audit record
  const { error: insertError } = await supabase.from('contact_guard_audits').insert({
    user_id: job.user_id,
    conversation_id: job.conversation_id,
    detected_type: job.detected_type,
    normalised_excerpt: job.normalised_excerpt,
    idempotency_key: job.idempotency_key,
    created_at: new Date().toISOString(),
  });

  if (insertError) {
    // Unique constraint violation = race-condition duplicate → treat as idempotent
    if (insertError.code === '23505') {
      return { idempotency_key: job.idempotency_key, duplicate: true, persisted: false };
    }
    throw new Error(`[ContactGuard] DB insert error: ${insertError.message}`);
  }

  console.log(`[ContactGuard] Audit persisted — key=${job.idempotency_key}`);
  return { idempotency_key: job.idempotency_key, duplicate: false, persisted: true };
}
</file>

<file path="src/processors/notification.processor.ts">
/**
 * YoUnMe Worker — Notification Processor
 *
 * Handles NotificationJob:
 *  1. Persists an in-app notification record to Supabase `notifications` table
 *     (which Supabase Realtime broadcasts to connected Flutter clients).
 *  2. Enqueues native mobile push delivery to the `younme:push-delivery` queue
 *     via Firebase Cloud Messaging (FCM).
 *
 * Decoupled Architecture:
 *  - Failure isolation: In-app persistence is guaranteed even if Redis or FCM
 *    has transient delivery issues.
 *  - Independent retries: Push delivery retries in its own queue without
 *    re-inserting duplicate database rows.
 */

import { z } from 'zod';
import { getSupabaseClient } from '../supabase.js';
import { enqueuePushDelivery } from '../queue-producer.js';
import type { NotificationResult } from '../types.js';

// ─── Payload Validation ──────────────────────────────────────────────────────

export const NotificationJobSchema = z.object({
  recipient_id: z.string().uuid('recipient_id must be a valid UUID'),
  category: z.enum(['match', 'message', 'call', 'system']),
  title: z.string().min(1).max(128),
  body: z.string().min(1).max(512),
  data: z.record(z.string()).default({}),
});

export type NotificationJob = z.infer<typeof NotificationJobSchema>;

// ─── Main Processor ──────────────────────────────────────────────────────────

export async function processNotification(rawJob: unknown): Promise<NotificationResult> {
  // 1. Validate payload
  const parseResult = NotificationJobSchema.safeParse(rawJob);
  if (!parseResult.success) {
    const issues = parseResult.error.issues.map((i) => i.message).join('; ');
    throw new Error(`[Notification] Invalid job payload: ${issues}`);
  }
  const job: NotificationJob = parseResult.data;

  // Log category and recipient only — do NOT log body content (privacy)
  console.log(
    `[Notification] Processing — recipient=${job.recipient_id} category=${job.category}`,
  );

  const supabase = getSupabaseClient();

  if (!supabase) {
    console.log(
      `[Notification] Supabase not configured. Notification NOT persisted. ` +
        `recipient=${job.recipient_id}`,
    );
    return {
      recipient_id: job.recipient_id,
      notification_id: null,
      in_app_delivered: false,
      push_enqueued: false,
    };
  }

  // 2. Persist in-app notification (Realtime will broadcast to connected client)
  const { data, error } = await supabase
    .from('notifications')
    .insert({
      recipient_id: job.recipient_id,
      category: job.category,
      title: job.title,
      body: job.body,
      data: job.data,
      is_read: false,
      created_at: new Date().toISOString(),
    })
    .select('id')
    .single();

  if (error) {
    throw new Error(`[Notification] DB insert error: ${error.message}`);
  }

  const notificationId: string = data?.id ?? null;

  console.log(
    `[Notification] Persisted — id=${notificationId} recipient=${job.recipient_id} ` +
      `category=${job.category}`,
  );

  // 3. Enqueue native push delivery to the push-delivery queue
  let pushEnqueued = false;
  try {
    await enqueuePushDelivery({
      recipient_id: job.recipient_id,
      category: job.category,
      title: job.title,
      body: job.body,
      data: job.data,
      notification_id: notificationId,
    });
    pushEnqueued = true;
    console.log(
      `[Notification] Enqueued push delivery — recipient=${job.recipient_id} notif_id=${notificationId}`,
    );
  } catch (pushErr: unknown) {
    const msg = pushErr instanceof Error ? pushErr.message : String(pushErr);
    console.warn(
      `[Notification] Failed to enqueue push delivery for recipient=${job.recipient_id}: ${msg}`,
    );
  }

  return {
    recipient_id: job.recipient_id,
    notification_id: notificationId,
    in_app_delivered: true,
    push_enqueued: pushEnqueued,
  };
}
</file>

<file path="src/processors/push-delivery.processor.ts">
/**
 * YoUnMe Worker — Firebase Cloud Messaging (FCM) Push Delivery Processor
 *
 * Responsibilities:
 *  1. Validates PushDeliveryJob payload.
 *  2. Looks up recipient's active device tokens from Supabase `device_tokens` table.
 *  3. Constructs privacy-preserving, categorized FCM push payloads.
 *  4. Dispatches multicast notifications using Firebase Admin SDK `sendEachForMulticast`.
 *  5. Automatically prunes unregistered or invalid tokens from Supabase.
 *  6. Distinguishes permanent errors from transient FCM server errors (for BullMQ retries).
 *
 * Security & Privacy:
 *  - Device registration tokens and private message bodies are NEVER logged.
 *  - Service account credentials remain strictly server-side.
 */

import { z } from 'zod';
import { getMessagingClient } from '../fcm.js';
import { getSupabaseClient } from '../supabase.js';
import type { PushDeliveryJob, PushDeliveryResult } from '../types.js';

// ─── Payload Validation ──────────────────────────────────────────────────────

export const PushDeliveryJobSchema = z.object({
  recipient_id: z.string().uuid('recipient_id must be a valid UUID'),
  category: z.enum(['match', 'message', 'call', 'system']),
  title: z.string().min(1).max(128),
  body: z.string().min(1).max(512),
  data: z.record(z.string()).default({}),
  notification_id: z.string().uuid().optional(),
});

// Stale token error codes defined by Firebase Cloud Messaging
const STALE_TOKEN_CODES = new Set([
  'messaging/registration-token-not-registered',
  'messaging/invalid-registration-token',
]);

// Transient error codes that warrant BullMQ backoff retry
const RETRYABLE_FCM_CODES = new Set([
  'messaging/server-unavailable',
  'messaging/internal-error',
  'messaging/quota-exceeded',
  'messaging/device-message-rate-exceeded',
]);

// ─── Main Processor ──────────────────────────────────────────────────────────

export async function processPushDelivery(rawJob: unknown): Promise<PushDeliveryResult> {
  // 1. Validate payload
  const parseResult = PushDeliveryJobSchema.safeParse(rawJob);
  if (!parseResult.success) {
    const issues = parseResult.error.issues.map((i) => i.message).join('; ');
    throw new Error(`[PushDelivery] Invalid job payload: ${issues}`);
  }
  const job: PushDeliveryJob = parseResult.data;

  console.log(
    `[PushDelivery] Processing — recipient=${job.recipient_id} category=${job.category}` +
      (job.notification_id ? ` notif_id=${job.notification_id}` : ''),
  );

  const supabase = getSupabaseClient();
  if (!supabase) {
    console.log(
      `[PushDelivery] Supabase not configured. Push delivery skipped. recipient=${job.recipient_id}`,
    );
    return {
      recipient_id: job.recipient_id,
      delivered_count: 0,
      failed_count: 0,
      pruned_tokens: 0,
      reason: 'supabase_not_configured',
    };
  }

  // 2. Query active device tokens for the recipient
  const { data: tokenRows, error: tokenError } = await supabase
    .from('device_tokens')
    .select('token, platform')
    .eq('user_id', job.recipient_id);

  if (tokenError) {
    throw new Error(`[PushDelivery] Failed to query device tokens: ${tokenError.message}`);
  }

  if (!tokenRows || tokenRows.length === 0) {
    console.log(
      `[PushDelivery] No registered device tokens for recipient=${job.recipient_id}. Skipping FCM dispatch.`,
    );
    return {
      recipient_id: job.recipient_id,
      delivered_count: 0,
      failed_count: 0,
      pruned_tokens: 0,
      reason: 'no_tokens',
    };
  }

  // 3. Obtain Firebase Messaging client
  const messaging = getMessagingClient();
  if (!messaging) {
    console.warn(
      `[PushDelivery] FCM not configured. Cannot dispatch push to ${tokenRows.length} device(s) ` +
        `for recipient=${job.recipient_id}. Set FIREBASE_SERVICE_ACCOUNT_KEY to enable.`,
    );
    return {
      recipient_id: job.recipient_id,
      delivered_count: 0,
      failed_count: 0,
      pruned_tokens: 0,
      reason: 'fcm_not_configured',
    };
  }

  // 4. Construct payload and dispatch multicast message
  const tokens = tokenRows.map((r) => r.token);
  const dataPayload: Record<string, string> = {
    ...job.data,
    category: job.category,
    ...(job.notification_id ? { notification_id: job.notification_id } : {}),
  };

  let response;
  try {
    response = await messaging.sendEachForMulticast({
      tokens,
      notification: {
        title: job.title,
        body: job.body,
      },
      data: dataPayload,
      android: {
        priority: job.category === 'call' ? 'high' : 'normal',
        notification: {
          channelId: `younme_${job.category}`,
        },
      },
      apns: {
        payload: {
          aps: {
            sound: 'default',
            badge: 1,
          },
        },
      },
    });
  } catch (err: unknown) {
    const msg = err instanceof Error ? err.message : String(err);
    throw new Error(`[PushDelivery] FCM multicast transport error (will retry): ${msg}`);
  }

  // 5. Evaluate response & prune invalid tokens
  const staleTokens: string[] = [];
  let retryableCount = 0;

  response.responses.forEach((res, idx) => {
    if (!res.success && res.error) {
      const code = res.error.code;
      if (STALE_TOKEN_CODES.has(code)) {
        staleTokens.push(tokens[idx]);
      } else if (RETRYABLE_FCM_CODES.has(code)) {
        retryableCount++;
      }
    }
  });

  // Prune stale tokens from Supabase asynchronously
  if (staleTokens.length > 0) {
    const { error: pruneError } = await supabase
      .from('device_tokens')
      .delete()
      .in('token', staleTokens);

    if (pruneError) {
      console.error(`[PushDelivery] Failed to prune stale tokens: ${pruneError.message}`);
    } else {
      console.log(
        `[PushDelivery] Pruned ${staleTokens.length} unregistered/invalid token(s) ` +
          `for recipient=${job.recipient_id}`,
      );
    }
  }

  console.log(
    `[PushDelivery] Dispatched — recipient=${job.recipient_id} ` +
      `success=${response.successCount} failure=${response.failureCount}`,
  );

  // If ALL targeted tokens failed and failures were retryable, trigger BullMQ backoff retry
  if (response.successCount === 0 && retryableCount > 0 && retryableCount === response.failureCount) {
    throw new Error(
      `[PushDelivery] All FCM targets experienced retryable provider errors (${retryableCount} failed)`,
    );
  }

  return {
    recipient_id: job.recipient_id,
    delivered_count: response.successCount,
    failed_count: response.failureCount,
    pruned_tokens: staleTokens.length,
  };
}
</file>

<file path="src/processors/vision.processor.ts">
/**
 * YoUnMe Worker — Google Cloud Vision Processor
 *
 * Handles VisionScanJob:
 *  1. Validates and authorises image_url (SSRF guard).
 *  2. Calls Vision API: SafeSearch + TEXT_DETECTION.
 *  3. Applies contact-detection to OCR output (mirrors Go/NestJS logic).
 *  4. Persists moderation outcome to Supabase `media_moderation` table.
 *  5. Returns a structured result that the BullMQ worker logs.
 *
 * Design rules:
 *  - Never logs raw image URLs or raw OCR text (privacy).
 *  - On transient Vision API errors → throws (BullMQ retries with backoff).
 *  - On permanent failures (bad URL, invalid image) → marks as blocked with
 *    status 'pending_review' so a human can decide.
 *  - Never auto-approves if Vision API fails.
 */

import vision from '@google-cloud/vision';
import type { ImageAnnotatorClient, protos } from '@google-cloud/vision';
import { z } from 'zod';
import { env, visionConfigured, supabaseConfigured } from '../config.js';
import { getSupabaseClient } from '../supabase.js';
import type { VisionScanJob, ModerationOutcome } from '../types.js';

// ─── Payload Validation ──────────────────────────────────────────────────────

export const VisionScanJobSchema = z.object({
  asset_id: z.string().uuid('asset_id must be a valid UUID'),
  user_id: z.string().uuid('user_id must be a valid UUID'),
  image_url: z.string().url('image_url must be a valid URL'),
  type: z.enum(['profile_photo', 'chat_media', 'video_call_preview']),
});

// ─── Safe-Search Likelihood mapping ─────────────────────────────────────────

type Likelihood = 'UNKNOWN' | 'VERY_UNLIKELY' | 'UNLIKELY' | 'POSSIBLE' | 'LIKELY' | 'VERY_LIKELY';

const LIKELIHOOD_NAMES: Record<number, Likelihood> = {
  0: 'UNKNOWN',
  1: 'VERY_UNLIKELY',
  2: 'UNLIKELY',
  3: 'POSSIBLE',
  4: 'LIKELY',
  5: 'VERY_LIKELY',
};

function normalizeLikelihood(val: unknown): Likelihood {
  if (typeof val === 'number') {
    return LIKELIHOOD_NAMES[val] ?? 'UNKNOWN';
  }
  if (typeof val === 'string') {
    return val as Likelihood;
  }
  return 'UNKNOWN';
}

const BLOCK_THRESHOLDS: Record<string, readonly Likelihood[]> = {
  adult: ['LIKELY', 'VERY_LIKELY'],
  racy: ['VERY_LIKELY'],
  violence: ['LIKELY', 'VERY_LIKELY'],
};

function exceedsThreshold(likelihood: unknown, category: string): boolean {
  const norm = normalizeLikelihood(likelihood);
  const thresholds = BLOCK_THRESHOLDS[category] ?? [];
  return thresholds.includes(norm);
}

// ─── OCR Contact Detection ────────────────────────────────────────────────────
// Mirror of the Go NormalizeText + phone/social regex logic.

const PHONE_DIGIT_REGEX = /\d{10,}/;
const PHONE_SPACED_REGEX = /\+?\d[\d\s\-().]{8,}\d/;
const SOCIAL_HANDLE_REGEX =
  /(insta|ig|telegram|snap|snapchat|t\.me|wa\.me|whatsapp|sc)\s*[:\s_-]*@?[a-zA-Z0-9_.]{3,}/i;

function detectContactInOcr(texts: string[]): boolean {
  for (const text of texts) {
    const digitsOnly = text.replace(/\D/g, '');
    if (PHONE_DIGIT_REGEX.test(digitsOnly)) return true;
    if (PHONE_SPACED_REGEX.test(text)) return true;
    if (SOCIAL_HANDLE_REGEX.test(text)) return true;
  }
  return false;
}

// ─── URL Allowlist Guard (SSRF prevention) ────────────────────────────────────

function isAllowedImageUrl(url: string): boolean {
  if (!env.SUPABASE_STORAGE_BUCKET_PREFIX) {
    // In development, allow any HTTPS URL; log a warning.
    if (!url.startsWith('https://')) {
      return false;
    }
    return true;
  }
  return url.startsWith(env.SUPABASE_STORAGE_BUCKET_PREFIX);
}

// ─── Vision Client (lazy) ────────────────────────────────────────────────────

let _visionClient: ImageAnnotatorClient | null = null;

function getVisionClient(): ImageAnnotatorClient {
  if (_visionClient) return _visionClient;
  _visionClient = new vision.ImageAnnotatorClient({
    ...(env.GCLOUD_PROJECT_ID ? { projectId: env.GCLOUD_PROJECT_ID } : {}),
    // GOOGLE_APPLICATION_CREDENTIALS is read automatically from the environment.
  });
  return _visionClient;
}

// ─── Supabase Persistence ─────────────────────────────────────────────────────

async function persistOutcome(outcome: ModerationOutcome): Promise<void> {
  const supabase = getSupabaseClient();
  if (!supabase) {
    // No Supabase client in dev/test — log only.
    console.log(
      `[Vision] Supabase not configured. Outcome for asset ${outcome.asset_id}: ${outcome.status}`,
    );
    return;
  }

  const { error } = await supabase.from('media_moderation').upsert(
    {
      asset_id: outcome.asset_id,
      user_id: outcome.user_id,
      status: outcome.status,
      safe_search_adult: outcome.safe_search_adult,
      safe_search_racy: outcome.safe_search_racy,
      safe_search_violence: outcome.safe_search_violence,
      contact_detected: outcome.contact_detected,
      action_taken: outcome.action_taken,
      reviewed_at: outcome.reviewed_at,
    },
    { onConflict: 'asset_id' }, // idempotent upsert
  );

  if (error) {
    // Surface to BullMQ for retry if it's a transient DB error.
    throw new Error(`[Vision] Failed to persist moderation outcome: ${error.message}`);
  }
}

// ─── Main Processor ──────────────────────────────────────────────────────────

export async function processVisionScan(rawJob: unknown): Promise<ModerationOutcome> {
  // 1. Validate payload
  const parseResult = VisionScanJobSchema.safeParse(rawJob);
  if (!parseResult.success) {
    const issues = parseResult.error.issues.map((i) => i.message).join('; ');
    throw new Error(`[Vision] Invalid job payload: ${issues}`);
  }
  const job: VisionScanJob = parseResult.data;

  // 2. SSRF guard: validate image URL is within approved storage
  if (!isAllowedImageUrl(job.image_url)) {
    const outcome: ModerationOutcome = {
      asset_id: job.asset_id,
      user_id: job.user_id,
      status: 'blocked',
      safe_search_adult: 'UNKNOWN',
      safe_search_racy: 'UNKNOWN',
      safe_search_violence: 'UNKNOWN',
      contact_detected: false,
      action_taken: 'REJECTED_DISALLOWED_URL',
      reviewed_at: new Date().toISOString(),
    };
    await persistOutcome(outcome);
    return outcome;
  }

  // 3. If Vision API not configured, mark pending_review (do NOT auto-approve)
  if (!visionConfigured) {
    console.warn(
      `[Vision] Google Cloud credentials not configured. ` +
        `Marking asset ${job.asset_id} as pending_review. ` +
        `Set GOOGLE_APPLICATION_CREDENTIALS or GCLOUD_PROJECT_ID to enable real scanning.`,
    );
    const outcome: ModerationOutcome = {
      asset_id: job.asset_id,
      user_id: job.user_id,
      status: 'pending_review',
      safe_search_adult: 'UNKNOWN',
      safe_search_racy: 'UNKNOWN',
      safe_search_violence: 'UNKNOWN',
      contact_detected: false,
      action_taken: 'PENDING_VISION_NOT_CONFIGURED',
      reviewed_at: new Date().toISOString(),
    };
    await persistOutcome(outcome);
    return outcome;
  }

  // 4. Call Google Cloud Vision API
  let safeSearchAnnotation: protos.google.cloud.vision.v1.ISafeSearchAnnotation | null = null;
  let ocrTexts: string[] = [];

  try {
    const client = getVisionClient();
    const [response] = await client.annotateImage({
      image: { source: { imageUri: job.image_url } },
      features: [
        { type: 'SAFE_SEARCH_DETECTION' },
        { type: 'TEXT_DETECTION' },
      ],
    });

    safeSearchAnnotation = response.safeSearchAnnotation ?? null;
    ocrTexts = (response.textAnnotations ?? [])
      .slice(0, 1) // first annotation is the full-image text block
      .map((a: protos.google.cloud.vision.v1.IEntityAnnotation) => a.description ?? '');
  } catch (err: unknown) {
    // Transient Vision API error — rethrow so BullMQ retries with backoff
    const msg = err instanceof Error ? err.message : String(err);
    throw new Error(`[Vision] Transient Vision API error (will retry): ${msg}`);
  }

  // 5. Apply moderation rules
  const adult = normalizeLikelihood(safeSearchAnnotation?.adult);
  const racy = normalizeLikelihood(safeSearchAnnotation?.racy);
  const violence = normalizeLikelihood(safeSearchAnnotation?.violence);

  const isExplicit =
    exceedsThreshold(adult, 'adult') ||
    exceedsThreshold(racy, 'racy') ||
    exceedsThreshold(violence, 'violence');

  const contactDetected = detectContactInOcr(ocrTexts);

  let status: ModerationOutcome['status'];
  let actionTaken: string;

  if (isExplicit) {
    status = 'blocked';
    actionTaken = 'BLOCKED_EXPLICIT_CONTENT';
  } else if (contactDetected) {
    status = 'blocked';
    actionTaken = 'BLOCKED_OCR_CONTACT_DETECTED';
  } else {
    status = 'approved';
    actionTaken = 'APPROVED';
  }

  const outcome: ModerationOutcome = {
    asset_id: job.asset_id,
    user_id: job.user_id,
    status,
    safe_search_adult: adult,
    safe_search_racy: racy,
    safe_search_violence: violence,
    contact_detected: contactDetected,
    action_taken: actionTaken,
    reviewed_at: new Date().toISOString(),
  };

  // 6. Persist (idempotent upsert)
  await persistOutcome(outcome);

  // Log only non-sensitive summary (no URLs, no OCR text)
  console.log(
    `[Vision] asset=${job.asset_id} type=${job.type} ` +
      `status=${status} action=${actionTaken}`,
  );

  return outcome;
}
</file>

<file path="src/config.ts">
/**
 * YoUnMe Worker — Environment Configuration
 *
 * All secrets come from environment variables. Never hardcode credentials.
 * Fails fast at startup with clear error messages if required vars are absent.
 */

import { z } from 'zod';

const envSchema = z.object({
  // ── Redis ────────────────────────────────────────────────────────────────
  REDIS_URL: z
    .string()
    .url('REDIS_URL must be a valid URL, e.g. redis://localhost:6379')
    .default('redis://localhost:6379'),

  // ── Supabase ─────────────────────────────────────────────────────────────
  SUPABASE_URL: z.string().url('SUPABASE_URL must be a valid URL').optional(),
  /**
   * Service-role key — grants privileged write access.
   * Keep strictly server-side. Never expose to clients.
   */
  SUPABASE_SERVICE_ROLE_KEY: z
    .string()
    .min(1, 'SUPABASE_SERVICE_ROLE_KEY must not be empty')
    .optional(),

  // ── Google Cloud Vision ──────────────────────────────────────────────────
  /**
   * Path to a Google Cloud service-account JSON key file.
   * Alternatively, set GOOGLE_APPLICATION_CREDENTIALS in the environment.
   * When deployed to Cloud Run with Workload Identity, omit this variable
   * and assign the Vision API role to the Cloud Run service account instead.
   */
  GOOGLE_APPLICATION_CREDENTIALS: z.string().optional(),
  GCLOUD_PROJECT_ID: z.string().optional(),

  // ── Supabase Storage Bucket ──────────────────────────────────────────────
  /**
   * Allowed Supabase Storage bucket URL prefix.
   * The worker rejects any image_url that does not start with this value,
   * preventing server-side request forgery via enqueued jobs.
   */
  SUPABASE_STORAGE_BUCKET_PREFIX: z.string().optional(),

  // ── Firebase Cloud Messaging (FCM) ──────────────────────────────────────
  /**
   * Firebase Service Account Key as a JSON string, base64-encoded string,
   * or path to a credentials file. In Cloud Run with Workload Identity,
   * this can be omitted if GOOGLE_APPLICATION_CREDENTIALS or ADC is present.
   */
  FIREBASE_SERVICE_ACCOUNT_KEY: z.string().optional(),
  FIREBASE_PROJECT_ID: z.string().optional(),

  // ── Worker Tuning ────────────────────────────────────────────────────────
  /** Number of jobs processed concurrently per queue. Default: 3 */
  WORKER_CONCURRENCY: z.coerce.number().int().positive().default(3),
  /** Maximum Vision API retries before a job moves to failed state */
  VISION_MAX_RETRIES: z.coerce.number().int().nonnegative().default(3),
  /** Maximum FCM Push Delivery retries before moving to failed state */
  PUSH_MAX_RETRIES: z.coerce.number().int().nonnegative().default(3),

  NODE_ENV: z.enum(['development', 'production', 'test']).default('development'),
});

type Env = z.infer<typeof envSchema>;

function loadEnv(): Env {
  const parsed = envSchema.safeParse(process.env);
  if (!parsed.success) {
    const issues = parsed.error.issues
      .map((i) => `  • ${i.path.join('.')}: ${i.message}`)
      .join('\n');
    console.error(`[Worker] ❌ Invalid environment configuration:\n${issues}`);
    process.exit(1);
  }
  return parsed.data;
}

export const env = loadEnv();

/** True when Supabase credentials are fully configured */
export const supabaseConfigured =
  Boolean(env.SUPABASE_URL) && Boolean(env.SUPABASE_SERVICE_ROLE_KEY);

/** True when Google Cloud Vision is likely configured */
export const visionConfigured = Boolean(
  env.GOOGLE_APPLICATION_CREDENTIALS || env.GCLOUD_PROJECT_ID,
);

/** True when Firebase Cloud Messaging is likely configured */
export const fcmConfigured = Boolean(
  env.FIREBASE_SERVICE_ACCOUNT_KEY ||
  env.FIREBASE_PROJECT_ID ||
  env.GOOGLE_APPLICATION_CREDENTIALS,
);
</file>

<file path="src/fcm.ts">
/**
 * YoUnMe Worker — Firebase Cloud Messaging (FCM) Client Singleton
 *
 * Exclusively handles mobile push notification dispatch via Firebase Admin SDK.
 * Does NOT initialize Firebase Authentication or Firebase Realtime/Firestore DB.
 *
 * Follows Cloud Run best practices:
 *  - Initialized safely and only once per process.
 *  - Credentials loaded from Secret Manager (FIREBASE_SERVICE_ACCOUNT_KEY) or
 *    Google Cloud Workload Identity / Application Default Credentials.
 *  - Fails safely without crashing if credentials are not configured in dev/test.
 *  - Secrets and access tokens are never logged.
 */

import { initializeApp, getApps, cert, applicationDefault } from 'firebase-admin/app';
import { getMessaging, type Messaging } from 'firebase-admin/messaging';
import { env, fcmConfigured } from './config.js';

let _messaging: Messaging | null = null;

/**
 * Obtain the initialized Firebase Messaging singleton.
 * Returns null if credentials are not configured (graceful degradation).
 */
export function getMessagingClient(): Messaging | null {
  if (_messaging) return _messaging;

  if (!fcmConfigured) {
    return null;
  }

  if (getApps().length === 0) {
    let credential;

    if (env.FIREBASE_SERVICE_ACCOUNT_KEY) {
      const raw = env.FIREBASE_SERVICE_ACCOUNT_KEY.trim();
      try {
        if (raw.startsWith('{')) {
          credential = cert(JSON.parse(raw));
        } else {
          // Check for base64 encoded JSON
          const decoded = Buffer.from(raw, 'base64').toString('utf8');
          if (decoded.trim().startsWith('{')) {
            credential = cert(JSON.parse(decoded));
          } else {
            // Assume file path
            credential = cert(raw);
          }
        }
      } catch (err) {
        console.warn(
          `[FCM] Failed to parse FIREBASE_SERVICE_ACCOUNT_KEY as JSON or base64. ` +
            `Falling back to applicationDefault credentials. Error: ${err instanceof Error ? err.message : String(err)}`,
        );
        credential = applicationDefault();
      }
    } else {
      credential = applicationDefault();
    }

    initializeApp({
      credential,
      ...(env.FIREBASE_PROJECT_ID ? { projectId: env.FIREBASE_PROJECT_ID } : {}),
    });
  }

  _messaging = getMessaging();
  return _messaging;
}
</file>

<file path="src/index.ts">
/**
 * YoUnMe Worker — Main Worker Entry Point
 *
 * Registers BullMQ workers for all supported job queues:
 *   - younme:vision-scan       → Vision API moderation
 *   - younme:notification      → In-app notification persistence
 *   - younme:contact-guard-audit → Contact Guard violation audit trail
 *
 * Features:
 *  - Single IORedis connection shared across all workers (no per-worker connections)
 *  - Exponential backoff on all queues
 *  - QueueEvents listener for failed-job observability
 *  - Graceful shutdown on SIGTERM / SIGINT (Cloud Run termination signal)
 *  - Worker stays alive after processing (suitable for Cloud Run always-on or min-instances=1)
 */

import { Worker, QueueEvents, type Job } from 'bullmq';
import IORedis from 'ioredis';
import { env, fcmConfigured, visionConfigured, supabaseConfigured } from './config.js';
import {
  QUEUE_VISION_SCAN,
  QUEUE_NOTIFICATION,
  QUEUE_CONTACT_GUARD_AUDIT,
  QUEUE_PUSH_DELIVERY,
} from './types.js';
import { processVisionScan } from './processors/vision.processor.js';
import { processNotification } from './processors/notification.processor.js';
import { processContactGuardAudit } from './processors/contact-guard.processor.js';
import { processPushDelivery } from './processors/push-delivery.processor.js';

// ─── Redis Connection ─────────────────────────────────────────────────────────

const connection = new IORedis(env.REDIS_URL, {
  maxRetriesPerRequest: null, // required by BullMQ
  enableReadyCheck: false,
  lazyConnect: false,
  retryStrategy(times) {
    const delay = Math.min(times * 500, 10_000); // max 10s between retries
    console.warn(`[Worker] Redis reconnect attempt #${times}, waiting ${delay}ms`);
    return delay;
  },
});

connection.on('connect', () => console.log('[Worker] Redis connected.'));
connection.on('error', (err) => console.error('[Worker] Redis error:', err.message));

// ─── Generic Job Runner ───────────────────────────────────────────────────────

async function runJob<T>(
  job: Job,
  processor: (data: unknown) => Promise<T>,
  label: string,
): Promise<T> {
  const start = Date.now();
  console.log(`[Worker] ▶ job_id=${job.id} queue=${job.queueName} attempt=${job.attemptsMade + 1}`);

  try {
    const result = await processor(job.data);
    const ms = Date.now() - start;
    console.log(`[Worker] ✅ job_id=${job.id} queue=${label} duration=${ms}ms`);
    return result;
  } catch (err) {
    const ms = Date.now() - start;
    const msg = err instanceof Error ? err.message : String(err);
    console.error(
      `[Worker] ❌ job_id=${job.id} queue=${label} attempt=${job.attemptsMade + 1} ` +
        `duration=${ms}ms error="${msg}"`,
    );
    throw err; // rethrow so BullMQ applies retry/backoff
  }
}

// ─── Queue Workers ────────────────────────────────────────────────────────────

const visionWorker = new Worker(
  QUEUE_VISION_SCAN,
  (job) => runJob(job, processVisionScan, 'vision-scan'),
  {
    connection,
    concurrency: env.WORKER_CONCURRENCY,
  },
);

const notificationWorker = new Worker(
  QUEUE_NOTIFICATION,
  (job) => runJob(job, processNotification, 'notification'),
  {
    connection,
    concurrency: env.WORKER_CONCURRENCY,
  },
);

const contactGuardWorker = new Worker(
  QUEUE_CONTACT_GUARD_AUDIT,
  (job) => runJob(job, processContactGuardAudit, 'contact-guard-audit'),
  {
    connection,
    concurrency: env.WORKER_CONCURRENCY,
  },
);

const pushDeliveryWorker = new Worker(
  QUEUE_PUSH_DELIVERY,
  (job) => runJob(job, processPushDelivery, 'push-delivery'),
  {
    connection,
    concurrency: env.WORKER_CONCURRENCY,
  },
);

const allWorkers = [visionWorker, notificationWorker, contactGuardWorker, pushDeliveryWorker];

// ─── QueueEvents — Failed Job Observability ───────────────────────────────────

function attachQueueEvents(queueName: string): void {
  const events = new QueueEvents(queueName, { connection });
  events.on('failed', ({ jobId, failedReason }) => {
    console.error(
      `[Worker] ☠ PERMANENTLY FAILED job_id=${jobId} queue=${queueName} reason="${failedReason}"`,
    );
    // In production: send alert to Sentry / Cloud Logging / PagerDuty here.
  });
  events.on('stalled', ({ jobId }) => {
    console.warn(`[Worker] ⚠ STALLED job_id=${jobId} queue=${queueName} — will be retried`);
  });
}

[
  QUEUE_VISION_SCAN,
  QUEUE_NOTIFICATION,
  QUEUE_CONTACT_GUARD_AUDIT,
  QUEUE_PUSH_DELIVERY,
].forEach(attachQueueEvents);

// ─── Startup Banner ───────────────────────────────────────────────────────────

console.log('================================================================');
console.log('🔧 YoUnMe Background Worker v2.0 — Starting');
console.log(
  `📍 Queues: ${QUEUE_VISION_SCAN} | ${QUEUE_NOTIFICATION} | ` +
    `${QUEUE_CONTACT_GUARD_AUDIT} | ${QUEUE_PUSH_DELIVERY}`,
);
console.log(`🔗 Redis: ${env.REDIS_URL.replace(/:\/\/.*@/, '://<credentials>@')}`);
console.log(`⚙  Concurrency: ${env.WORKER_CONCURRENCY}`);
console.log(
  `🛡  Services: Supabase=${supabaseConfigured ? '✅' : '⚠️ disabled'} | ` +
    `Vision=${visionConfigured ? '✅' : '⚠️ disabled'} | ` +
    `FCM=${fcmConfigured ? '✅' : '⚠️ disabled'}`,
);
console.log('================================================================');

// ─── Graceful Shutdown ────────────────────────────────────────────────────────

let isShuttingDown = false;

async function shutdown(signal: string): Promise<void> {
  if (isShuttingDown) return;
  isShuttingDown = true;

  console.log(`\n[Worker] ${signal} received — graceful shutdown starting…`);

  // Close workers (finish current jobs, reject new ones)
  await Promise.allSettled(allWorkers.map((w) => w.close()));

  // Close Redis
  await connection.quit().catch(() => connection.disconnect());

  console.log('[Worker] Shutdown complete. Exiting.');
  process.exit(0);
}

process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));
process.on('uncaughtException', (err) => {
  console.error('[Worker] Uncaught exception:', err);
  shutdown('uncaughtException').catch(() => process.exit(1));
});
process.on('unhandledRejection', (reason) => {
  console.error('[Worker] Unhandled rejection:', reason);
});
</file>

<file path="src/queue-producer.ts">
/**
 * YoUnMe — BullMQ Queue Producer Helper for NestJS
 *
 * Import this module from any NestJS controller or service to enqueue jobs
 * to the background worker. This is the correct pattern for production.
 *
 * Usage in NestJS:
 *
 *   import { enqueueVisionScan, enqueueNotification } from '../../worker-bullmq/src/queue-producer.js';
 *
 *   // After user uploads a photo:
 *   await enqueueVisionScan({ asset_id, user_id, image_url, type: 'profile_photo' });
 *
 *   // After a match is created:
 *   await enqueueNotification({
 *     recipient_id: otherUserId,
 *     category: 'match',
 *     title: 'You have a new match! 🔥',
 *     body: 'Start a conversation now.',
 *     data: { match_id: matchId },
 *   });
 *
 * The producer uses the same Redis connection string as the worker.
 * In production both services point to the same Redis instance.
 */

import { Queue, type JobsOptions } from 'bullmq';
import IORedis from 'ioredis';
import {
  QUEUE_VISION_SCAN,
  QUEUE_NOTIFICATION,
  QUEUE_CONTACT_GUARD_AUDIT,
  QUEUE_PUSH_DELIVERY,
  type VisionScanJob,
  type NotificationJob,
  type ContactGuardAuditJob,
  type PushDeliveryJob,
} from './types.js';

// ─── Shared Redis Connection for Producers ────────────────────────────────────

const REDIS_URL = process.env.REDIS_URL ?? 'redis://localhost:6379';

const producerConnection = new IORedis(REDIS_URL, {
  maxRetriesPerRequest: null,
  enableReadyCheck: false,
  lazyConnect: true,
});

// ─── Queue Instances ──────────────────────────────────────────────────────────

const visionQueue = new Queue(QUEUE_VISION_SCAN, { connection: producerConnection });
const notificationQueue = new Queue(QUEUE_NOTIFICATION, { connection: producerConnection });
const contactGuardQueue = new Queue(QUEUE_CONTACT_GUARD_AUDIT, { connection: producerConnection });
const pushDeliveryQueue = new Queue(QUEUE_PUSH_DELIVERY, { connection: producerConnection });

// ─── Default Job Options ──────────────────────────────────────────────────────

const defaultOpts: JobsOptions = {
  attempts: 4,
  backoff: { type: 'exponential', delay: 2000 },
  removeOnComplete: { age: 3600 }, // keep completed jobs for 1h for debugging
  removeOnFail: { age: 86400 },   // keep failed jobs for 24h for ops review
};

// ─── Producer Functions ───────────────────────────────────────────────────────

/**
 * Enqueue an image moderation job.
 * Call this immediately after a user uploads media to Supabase Storage.
 */
export async function enqueueVisionScan(job: VisionScanJob): Promise<string | undefined> {
  const added = await visionQueue.add('vision-scan', job, {
    ...defaultOpts,
    // asset_id as job ID ensures only one scan per asset (deduplication)
    jobId: `vision:${job.asset_id}`,
  });
  return added.id;
}

/**
 * Enqueue an in-app notification.
 * The worker persists the record to Supabase; Realtime delivers it to Flutter.
 */
export async function enqueueNotification(job: NotificationJob): Promise<string | undefined> {
  const added = await notificationQueue.add('notification', job, defaultOpts);
  return added.id;
}

/**
 * Enqueue a Contact Guard audit record.
 * Call this from chat.controller.ts when a message is blocked.
 * The `idempotency_key` must be unique per blocking event.
 */
export async function enqueueContactGuardAudit(
  job: ContactGuardAuditJob,
): Promise<string | undefined> {
  const added = await contactGuardQueue.add('contact-guard-audit', job, {
    ...defaultOpts,
    jobId: `guard:${job.idempotency_key}`, // BullMQ-level deduplication
  });
  return added.id;
}

/**
 * Enqueue a native mobile push notification via Firebase Cloud Messaging.
 * Call this directly for push notifications or let `enqueueNotification` fan out automatically.
 */
export async function enqueuePushDelivery(
  job: PushDeliveryJob,
): Promise<string | undefined> {
  const added = await pushDeliveryQueue.add('push-delivery', job, {
    ...defaultOpts,
    attempts: 5, // extra retries for mobile push network resilience
    jobId: job.notification_id
      ? `push:${job.notification_id}`
      : `push:${job.recipient_id}:${Date.now()}`,
  });
  return added.id;
}
</file>

<file path="src/supabase.ts">
/**
 * YoUnMe Worker — Supabase Client (Service-Role)
 *
 * This client uses the service-role key and must remain strictly server-side.
 * It is used only for persisting moderation outcomes and audit records.
 *
 * If Supabase credentials are not configured (dev/test without creds),
 * the client is null and processors fall back to logging-only mode.
 */

import { createClient, type SupabaseClient } from '@supabase/supabase-js';
import { env, supabaseConfigured } from './config.js';

let _supabase: SupabaseClient | null = null;

export function getSupabaseClient(): SupabaseClient | null {
  if (_supabase) return _supabase;

  if (!supabaseConfigured) {
    return null;
  }

  _supabase = createClient(env.SUPABASE_URL!, env.SUPABASE_SERVICE_ROLE_KEY!, {
    auth: {
      // Service-role clients must not use session-based auth
      persistSession: false,
      autoRefreshToken: false,
      detectSessionInUrl: false,
    },
  });

  return _supabase;
}
</file>

