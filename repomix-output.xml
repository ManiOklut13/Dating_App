/// App-wide theme palette tokens adhering to the YoUnMe design specification.
/// Supports both Light Mode and Cyber Luxe Dark Mode.
class AppColors {
  AppColors._();

  // Core brand accents
  static const Color flamePink = Color(0xFFFF2D55);
