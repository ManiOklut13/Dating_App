   ========================================================================== */

:root {
  --font-heading: 'Outfit', sans-serif;
  --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

  /* Color Palette */
  --bg-dark: #080a10;
  --bg-surface: #0f121d;
  --bg-card: rgba(20, 24, 38, 0.75);
  --bg-glass: rgba(255, 255, 255, 0.04);
  --border-glass: rgba(255, 255, 255, 0.09);
  --border-glow: rgba(255, 51, 102, 0.3);

  /* Primary Brand Gradients */
  --flame-pink: #ff2d55;
  --flame-purple: #9b51e0;
  --flame-gold: #ff9900;
  --cyan-vibe: #00e5ff;
  --emerald-live: #00e676;

  --gradient-flame: linear-gradient(135deg, #ff2d55 0%, #ff6b8b 50%, #9b51e0 100%);
  --gradient-spark: linear-gradient(135deg, #ff9900 0%, #ff5e3a 100%);
  --gradient-gold: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  --gradient-cyan: linear-gradient(135deg, #00e5ff 0%, #1e88e5 100%);
  --gradient-card-overlay: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(10,12,20,0.85) 75%, #080a10 100%);

  /* Typography */
  --text-primary: #ffffff;
  --text-secondary: #9aa2bc;
  --text-muted: #5e6682;

  /* Elevation */
  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.25);
  --shadow-lg: 0 16px 36px rgba(0, 0, 0, 0.45);
  --shadow-glow: 0 0 24px rgba(255, 45, 85, 0.35);
  --shadow-gold: 0 0 20px rgba(255, 170, 0, 0.4);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 24px;
  --radius-full: 9999px;

  --transition-fast: 0.18s cubic-bezier(0.4, 0, 0.2, 1);
