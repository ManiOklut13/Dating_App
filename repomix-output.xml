import 'package:flutter/material.dart';
import '../../models/call_user.dart';
import '../../services/call_history_service.dart';
import 'audio_call_screen.dart';
import 'video_call_screen.dart';

// ─────────────────────────────────────────────────────────────────────────────
// Main Calls Screen — three tabs: Audio · Video · History
// ─────────────────────────────────────────────────────────────────────────────
class CallsScreen extends StatefulWidget {
  const CallsScreen({super.key});

  @override
  State<CallsScreen> createState() => _CallsScreenState();
}

class _CallsScreenState extends State<CallsScreen>
    with SingleTickerProviderStateMixin {
  late TabController _tabController;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 3, vsync: this, initialIndex: 0);
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        // ── Tab bar ────────────────────────────────────────────────────────
        Container(
          color: const Color(0xFF0F121D),
          child: TabBar(
            controller: _tabController,
            indicatorColor: const Color(0xFFFF2D55),
            indicatorWeight: 3,
            labelColor: const Color(0xFFFF2D55),
            unselectedLabelColor: Colors.white38,
            labelStyle: const TextStyle(
              fontWeight: FontWeight.w700,
              fontSize: 14,
              letterSpacing: 0.3,
            ),
            unselectedLabelStyle: const TextStyle(
              fontWeight: FontWeight.w500,
              fontSize: 14,
            ),
            tabs: const [
              Tab(
                icon: Icon(Icons.phone_outlined, size: 20),
                text: 'Audio',
              ),
              Tab(
                icon: Icon(Icons.videocam_outlined, size: 20),
                text: 'Video',
              ),
              Tab(
                icon: Icon(Icons.history, size: 20),
                text: 'History',
              ),
            ],
          ),
        ),

        // ── Tab views ──────────────────────────────────────────────────────
        Expanded(
          child: TabBarView(
            controller: _tabController,
            children: const [
              _AudioTab(),
              _VideoTab(),
              _HistoryTab(),
            ],
          ),
        ),
      ],
    );
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared contact-list tile
// ─────────────────────────────────────────────────────────────────────────────
class _ContactTile extends StatelessWidget {
  final CallUser user;
  final VoidCallback onAudioCall;
  final VoidCallback onVideoCall;
  final bool showBothButtons;
  final bool isForVideo;

  const _ContactTile({
