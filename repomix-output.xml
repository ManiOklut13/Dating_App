  coins_debited?: number;
  debit_tx_id?: string;
  refunded?: boolean;
  refund_status?: string;
  refund_tx_id?: string;
  refund_amount?: number;
  cancellation_fee?: number;
  reschedule_penalties?: Array<{
    user_id: string;
    penalty_coins: number;
    tx_id: string;
    timestamp: string;
  }>;
}

export interface MeetupItem {
