              style: TextStyle(fontSize: 12.5, color: Color(0xFFE2C0CE)),
            ),
          ],
        ),
        const SizedBox(height: 20),

        // Sign in button
        GestureDetector(
          onTap: _isSubmitting ? null : _handleLogin,
          child: Container(
            height: 52,
            decoration: BoxDecoration(
