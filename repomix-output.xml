  padding: 4px 10px;
  border-radius: var(--radius-full);
  font-size: 12px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

/* Animations */
@keyframes pulseGlow {
  0% { box-shadow: 0 0 10px rgba(255, 45, 85, 0.3); }
  50% { box-shadow: 0 0 25px rgba(255, 45, 85, 0.6); }
  100% { box-shadow: 0 0 10px rgba(255, 45, 85, 0.3); }
}

.pulse-glow {
  animation: pulseGlow 2.5s infinite ease-in-out;
}

@keyframes radarSweep {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.radar-spinner {
