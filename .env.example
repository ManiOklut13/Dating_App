# ========================================================
# YoUnMe Platform — Root Environment Configuration Example
# Copy this file to .env and configure local settings.
# ========================================================

PORT=8080
NODE_ENV=development

# --------------------------------------------------------
# Supabase (Authentication + Managed PostgreSQL + PostGIS)
# Supabase Auth replaces Firebase Auth. User access tokens
# are HS256 JWTs signed with SUPABASE_JWT_SECRET, and token
# verification is enforced for `role: authenticated` only.
# --------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Email Confirmation Redirect URL (allowed in Supabase Dashboard > Authentication > URL Configuration > Redirect URLs)
# E.g. http://localhost:8080/v1/auth/confirm or younme://login-callback
EMAIL_CONFIRM_REDIRECT_URL=http://localhost:8080/v1/auth/confirm

# --------------------------------------------------------
# Supabase PostgreSQL connection (session pooler on 5432)
# The password must be URL-encoded (e.g. '@' -> %40).
# --------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# # LiveKit Configuration
LIVEKIT_URL=wss://your-project-name.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_HOST=your_livekit_api_secret_here