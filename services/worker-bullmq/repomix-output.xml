<file path="src/config.ts">
/**
 * YoUnMe Worker — Environment Configuration
 *
 * All secrets come from environment variables. Never hardcode credentials.
 * Fails fast at startup with clear error messages if required vars are absent.
 */

import { z } from 'zod';

const envSchema = z.object({
  // ── Redis ────────────────────────────────────────────────────────────────
  REDIS_URL: z
    .string()
    .url('REDIS_URL must be a valid URL, e.g. redis://localhost:6379')
    .default('redis://localhost:6379'),

  // ── Supabase ─────────────────────────────────────────────────────────────
  SUPABASE_URL: z.string().url('SUPABASE_URL must be a valid URL').optional(),
  /**
   * Service-role key — grants privileged write access.
   * Keep strictly server-side. Never expose to clients.
   */
  SUPABASE_SERVICE_ROLE_KEY: z
    .string()
    .min(1, 'SUPABASE_SERVICE_ROLE_KEY must not be empty')
    .optional(),

  // ── Google Cloud Vision ──────────────────────────────────────────────────
  /**
   * Path to a Google Cloud service-account JSON key file.
   * Alternatively, set GOOGLE_APPLICATION_CREDENTIALS in the environment.
   * When deployed to Cloud Run with Workload Identity, omit this variable
   * and assign the Vision API role to the Cloud Run service account instead.
   */
  GOOGLE_APPLICATION_CREDENTIALS: z.string().optional(),
  GCLOUD_PROJECT_ID: z.string().optional(),

  // ── Supabase Storage Bucket ──────────────────────────────────────────────
  /**
   * Allowed Supabase Storage bucket URL prefix.
   * The worker rejects any image_url that does not start with this value,
   * preventing server-side request forgery via enqueued jobs.
   */
  SUPABASE_STORAGE_BUCKET_PREFIX: z.string().optional(),

  // ── Firebase Cloud Messaging (FCM) ──────────────────────────────────────
  /**
   * Firebase Service Account Key as a JSON string, base64-encoded string,
   * or path to a credentials file. In Cloud Run with Workload Identity,
   * this can be omitted if GOOGLE_APPLICATION_CREDENTIALS or ADC is present.
   */
  FIREBASE_SERVICE_ACCOUNT_KEY: z.string().optional(),
  FIREBASE_PROJECT_ID: z.string().optional(),

  // ── Worker Tuning ────────────────────────────────────────────────────────
  /** Number of jobs processed concurrently per queue. Default: 3 */
  WORKER_CONCURRENCY: z.coerce.number().int().positive().default(3),
  /** Maximum Vision API retries before a job moves to failed state */
  VISION_MAX_RETRIES: z.coerce.number().int().nonnegative().default(3),
  /** Maximum FCM Push Delivery retries before moving to failed state */
  PUSH_MAX_RETRIES: z.coerce.number().int().nonnegative().default(3),

  NODE_ENV: z.enum(['development', 'production', 'test']).default('development'),
});

type Env = z.infer<typeof envSchema>;

function loadEnv(): Env {
  const parsed = envSchema.safeParse(process.env);
  if (!parsed.success) {
    const issues = parsed.error.issues
      .map((i) => `  • ${i.path.join('.')}: ${i.message}`)
      .join('\n');
    console.error(`[Worker] ❌ Invalid environment configuration:\n${issues}`);
    process.exit(1);
  }
  return parsed.data;
}

export const env = loadEnv();

/** True when Supabase credentials are fully configured */
export const supabaseConfigured =
  Boolean(env.SUPABASE_URL) && Boolean(env.SUPABASE_SERVICE_ROLE_KEY);

/** True when Google Cloud Vision is likely configured */
export const visionConfigured = Boolean(
  env.GOOGLE_APPLICATION_CREDENTIALS || env.GCLOUD_PROJECT_ID,
);

/** True when Firebase Cloud Messaging is likely configured */
export const fcmConfigured = Boolean(
  env.FIREBASE_SERVICE_ACCOUNT_KEY ||
  env.FIREBASE_PROJECT_ID ||
  env.GOOGLE_APPLICATION_CREDENTIALS,
);
</file>

<file path="src/fcm.ts">
/**
 * YoUnMe Worker — Firebase Cloud Messaging (FCM) Client Singleton
 *
 * Exclusively handles mobile push notification dispatch via Firebase Admin SDK.
 * Does NOT initialize Firebase Authentication or Firebase Realtime/Firestore DB.
 *
 * Follows Cloud Run best practices:
 *  - Initialized safely and only once per process.
 *  - Credentials loaded from Secret Manager (FIREBASE_SERVICE_ACCOUNT_KEY) or
 *    Google Cloud Workload Identity / Application Default Credentials.
 *  - Fails safely without crashing if credentials are not configured in dev/test.
 *  - Secrets and access tokens are never logged.
 */

import { initializeApp, getApps, cert, applicationDefault } from 'firebase-admin/app';
import { getMessaging, type Messaging } from 'firebase-admin/messaging';
import { env, fcmConfigured } from './config.js';

let _messaging: Messaging | null = null;

/**
 * Obtain the initialized Firebase Messaging singleton.
 * Returns null if credentials are not configured (graceful degradation).
 */
export function getMessagingClient(): Messaging | null {
  if (_messaging) return _messaging;

  if (!fcmConfigured) {
    return null;
  }

  if (getApps().length === 0) {
    let credential;

    if (env.FIREBASE_SERVICE_ACCOUNT_KEY) {
      const raw = env.FIREBASE_SERVICE_ACCOUNT_KEY.trim();
      try {
        if (raw.startsWith('{')) {
          credential = cert(JSON.parse(raw));
        } else {
          // Check for base64 encoded JSON
          const decoded = Buffer.from(raw, 'base64').toString('utf8');
          if (decoded.trim().startsWith('{')) {
            credential = cert(JSON.parse(decoded));
          } else {
            // Assume file path
            credential = cert(raw);
          }
        }
      } catch (err) {
        console.warn(
          `[FCM] Failed to parse FIREBASE_SERVICE_ACCOUNT_KEY as JSON or base64. ` +
            `Falling back to applicationDefault credentials. Error: ${err instanceof Error ? err.message : String(err)}`,
        );
        credential = applicationDefault();
      }
    } else {
      credential = applicationDefault();
    }

    initializeApp({
      credential,
      ...(env.FIREBASE_PROJECT_ID ? { projectId: env.FIREBASE_PROJECT_ID } : {}),
    });
  }

  _messaging = getMessaging();
  return _messaging;
}
</file>

<file path="src/index.ts">
/**
 * YoUnMe Worker — Main Worker Entry Point
 *
 * Registers BullMQ workers for all supported job queues:
 *   - younme:vision-scan       → Vision API moderation
 *   - younme:notification      → In-app notification persistence
 *   - younme:contact-guard-audit → Contact Guard violation audit trail
 *
 * Features:
 *  - Single IORedis connection shared across all workers (no per-worker connections)
 *  - Exponential backoff on all queues
 *  - QueueEvents listener for failed-job observability
 *  - Graceful shutdown on SIGTERM / SIGINT (Cloud Run termination signal)
 *  - Worker stays alive after processing (suitable for Cloud Run always-on or min-instances=1)
 */

import { Worker, QueueEvents, type Job } from 'bullmq';
import IORedis from 'ioredis';
import { env, fcmConfigured, visionConfigured, supabaseConfigured } from './config.js';
import {
  QUEUE_VISION_SCAN,
  QUEUE_NOTIFICATION,
  QUEUE_CONTACT_GUARD_AUDIT,
  QUEUE_PUSH_DELIVERY,
} from './types.js';
import { processVisionScan } from './processors/vision.processor.js';
import { processNotification } from './processors/notification.processor.js';
import { processContactGuardAudit } from './processors/contact-guard.processor.js';
import { processPushDelivery } from './processors/push-delivery.processor.js';

// ─── Redis Connection ─────────────────────────────────────────────────────────

const connection = new IORedis(env.REDIS_URL, {
  maxRetriesPerRequest: null, // required by BullMQ
  enableReadyCheck: false,
  lazyConnect: false,
  retryStrategy(times) {
    const delay = Math.min(times * 500, 10_000); // max 10s between retries
    console.warn(`[Worker] Redis reconnect attempt #${times}, waiting ${delay}ms`);
    return delay;
  },
});

connection.on('connect', () => console.log('[Worker] Redis connected.'));
connection.on('error', (err) => console.error('[Worker] Redis error:', err.message));

// ─── Generic Job Runner ───────────────────────────────────────────────────────

async function runJob<T>(
  job: Job,
  processor: (data: unknown) => Promise<T>,
  label: string,
): Promise<T> {
  const start = Date.now();
  console.log(`[Worker] ▶ job_id=${job.id} queue=${job.queueName} attempt=${job.attemptsMade + 1}`);

  try {
    const result = await processor(job.data);
    const ms = Date.now() - start;
    console.log(`[Worker] ✅ job_id=${job.id} queue=${label} duration=${ms}ms`);
    return result;
  } catch (err) {
    const ms = Date.now() - start;
    const msg = err instanceof Error ? err.message : String(err);
    console.error(
      `[Worker] ❌ job_id=${job.id} queue=${label} attempt=${job.attemptsMade + 1} ` +
        `duration=${ms}ms error="${msg}"`,
    );
    throw err; // rethrow so BullMQ applies retry/backoff
  }
}

// ─── Queue Workers ────────────────────────────────────────────────────────────

const visionWorker = new Worker(
  QUEUE_VISION_SCAN,
  (job) => runJob(job, processVisionScan, 'vision-scan'),
  {
    connection,
    concurrency: env.WORKER_CONCURRENCY,
  },
);

const notificationWorker = new Worker(
  QUEUE_NOTIFICATION,
  (job) => runJob(job, processNotification, 'notification'),
  {
    connection,
    concurrency: env.WORKER_CONCURRENCY,
  },
);

const contactGuardWorker = new Worker(
  QUEUE_CONTACT_GUARD_AUDIT,
  (job) => runJob(job, processContactGuardAudit, 'contact-guard-audit'),
  {
    connection,
    concurrency: env.WORKER_CONCURRENCY,
  },
);

const pushDeliveryWorker = new Worker(
  QUEUE_PUSH_DELIVERY,
  (job) => runJob(job, processPushDelivery, 'push-delivery'),
  {
    connection,
    concurrency: env.WORKER_CONCURRENCY,
  },
);

const allWorkers = [visionWorker, notificationWorker, contactGuardWorker, pushDeliveryWorker];

// ─── QueueEvents — Failed Job Observability ───────────────────────────────────

function attachQueueEvents(queueName: string): void {
  const events = new QueueEvents(queueName, { connection });
  events.on('failed', ({ jobId, failedReason }) => {
    console.error(
      `[Worker] ☠ PERMANENTLY FAILED job_id=${jobId} queue=${queueName} reason="${failedReason}"`,
    );
    // In production: send alert to Sentry / Cloud Logging / PagerDuty here.
  });
  events.on('stalled', ({ jobId }) => {
    console.warn(`[Worker] ⚠ STALLED job_id=${jobId} queue=${queueName} — will be retried`);
  });
}

[
  QUEUE_VISION_SCAN,
  QUEUE_NOTIFICATION,
  QUEUE_CONTACT_GUARD_AUDIT,
  QUEUE_PUSH_DELIVERY,
].forEach(attachQueueEvents);

// ─── Startup Banner ───────────────────────────────────────────────────────────

console.log('================================================================');
console.log('🔧 YoUnMe Background Worker v2.0 — Starting');
console.log(
  `📍 Queues: ${QUEUE_VISION_SCAN} | ${QUEUE_NOTIFICATION} | ` +
    `${QUEUE_CONTACT_GUARD_AUDIT} | ${QUEUE_PUSH_DELIVERY}`,
);
console.log(`🔗 Redis: ${env.REDIS_URL.replace(/:\/\/.*@/, '://<credentials>@')}`);
console.log(`⚙  Concurrency: ${env.WORKER_CONCURRENCY}`);
console.log(
  `🛡  Services: Supabase=${supabaseConfigured ? '✅' : '⚠️ disabled'} | ` +
    `Vision=${visionConfigured ? '✅' : '⚠️ disabled'} | ` +
    `FCM=${fcmConfigured ? '✅' : '⚠️ disabled'}`,
);
console.log('================================================================');

// ─── Graceful Shutdown ────────────────────────────────────────────────────────

let isShuttingDown = false;

async function shutdown(signal: string): Promise<void> {
  if (isShuttingDown) return;
  isShuttingDown = true;

  console.log(`\n[Worker] ${signal} received — graceful shutdown starting…`);

  // Close workers (finish current jobs, reject new ones)
  await Promise.allSettled(allWorkers.map((w) => w.close()));

  // Close Redis
  await connection.quit().catch(() => connection.disconnect());

  console.log('[Worker] Shutdown complete. Exiting.');
  process.exit(0);
}

process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));
process.on('uncaughtException', (err) => {
  console.error('[Worker] Uncaught exception:', err);
  shutdown('uncaughtException').catch(() => process.exit(1));
});
process.on('unhandledRejection', (reason) => {
  console.error('[Worker] Unhandled rejection:', reason);
});
</file>

<file path="src/queue-producer.ts">
/**
 * YoUnMe — BullMQ Queue Producer Helper for NestJS
 *
 * Import this module from any NestJS controller or service to enqueue jobs
 * to the background worker. This is the correct pattern for production.
 *
 * Usage in NestJS:
 *
 *   import { enqueueVisionScan, enqueueNotification } from '../../worker-bullmq/src/queue-producer.js';
 *
 *   // After user uploads a photo:
 *   await enqueueVisionScan({ asset_id, user_id, image_url, type: 'profile_photo' });
 *
 *   // After a match is created:
 *   await enqueueNotification({
 *     recipient_id: otherUserId,
 *     category: 'match',
 *     title: 'You have a new match! 🔥',
 *     body: 'Start a conversation now.',
 *     data: { match_id: matchId },
 *   });
 *
 * The producer uses the same Redis connection string as the worker.
 * In production both services point to the same Redis instance.
 */

import { Queue, type JobsOptions } from 'bullmq';
import IORedis from 'ioredis';
import {
  QUEUE_VISION_SCAN,
  QUEUE_NOTIFICATION,
  QUEUE_CONTACT_GUARD_AUDIT,
  QUEUE_PUSH_DELIVERY,
  type VisionScanJob,
  type NotificationJob,
  type ContactGuardAuditJob,
  type PushDeliveryJob,
} from './types.js';

// ─── Shared Redis Connection for Producers ────────────────────────────────────

const REDIS_URL = process.env.REDIS_URL ?? 'redis://localhost:6379';

const producerConnection = new IORedis(REDIS_URL, {
  maxRetriesPerRequest: null,
  enableReadyCheck: false,
  lazyConnect: true,
});

// ─── Queue Instances ──────────────────────────────────────────────────────────

const visionQueue = new Queue(QUEUE_VISION_SCAN, { connection: producerConnection });
const notificationQueue = new Queue(QUEUE_NOTIFICATION, { connection: producerConnection });
const contactGuardQueue = new Queue(QUEUE_CONTACT_GUARD_AUDIT, { connection: producerConnection });
const pushDeliveryQueue = new Queue(QUEUE_PUSH_DELIVERY, { connection: producerConnection });

// ─── Default Job Options ──────────────────────────────────────────────────────

const defaultOpts: JobsOptions = {
  attempts: 4,
  backoff: { type: 'exponential', delay: 2000 },
  removeOnComplete: { age: 3600 }, // keep completed jobs for 1h for debugging
  removeOnFail: { age: 86400 },   // keep failed jobs for 24h for ops review
};

// ─── Producer Functions ───────────────────────────────────────────────────────

/**
 * Enqueue an image moderation job.
 * Call this immediately after a user uploads media to Supabase Storage.
 */
export async function enqueueVisionScan(job: VisionScanJob): Promise<string | undefined> {
  const added = await visionQueue.add('vision-scan', job, {
    ...defaultOpts,
    // asset_id as job ID ensures only one scan per asset (deduplication)
    jobId: `vision:${job.asset_id}`,
  });
  return added.id;
}

/**
 * Enqueue an in-app notification.
 * The worker persists the record to Supabase; Realtime delivers it to Flutter.
 */
export async function enqueueNotification(job: NotificationJob): Promise<string | undefined> {
  const added = await notificationQueue.add('notification', job, defaultOpts);
  return added.id;
}

/**
 * Enqueue a Contact Guard audit record.
 * Call this from chat.controller.ts when a message is blocked.
 * The `idempotency_key` must be unique per blocking event.
 */
export async function enqueueContactGuardAudit(
  job: ContactGuardAuditJob,
): Promise<string | undefined> {
  const added = await contactGuardQueue.add('contact-guard-audit', job, {
    ...defaultOpts,
    jobId: `guard:${job.idempotency_key}`, // BullMQ-level deduplication
  });
  return added.id;
}

/**
 * Enqueue a native mobile push notification via Firebase Cloud Messaging.
 * Call this directly for push notifications or let `enqueueNotification` fan out automatically.
 */
export async function enqueuePushDelivery(
  job: PushDeliveryJob,
): Promise<string | undefined> {
  const added = await pushDeliveryQueue.add('push-delivery', job, {
    ...defaultOpts,
    attempts: 5, // extra retries for mobile push network resilience
    jobId: job.notification_id
      ? `push:${job.notification_id}`
      : `push:${job.recipient_id}:${Date.now()}`,
  });
  return added.id;
}
</file>

