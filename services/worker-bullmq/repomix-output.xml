# ─────────────────────────────────────────────────────────────────────────────
# YoUnMe — Worker Environment Variables (.env.example)
# Copy this file to .env and fill in real values.
# The .env file is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev (default): redis://localhost:6379
# Cloud Run + Memorystore: redis://<PRIVATE_IP>:6379
REDIS_URL=redis://localhost:6379

# ── Supabase (Server-Side Only) ───────────────────────────────────────────────
# Obtain from: Supabase Dashboard → Project → API Settings
# The service-role key bypasses RLS. Keep it strictly server-side.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Supabase Storage SSRF Guard ───────────────────────────────────────────────
# Only image URLs starting with this prefix will be accepted for Vision scanning.
# Example: https://your-project-id.supabase.co/storage/v1/object/public/media/
SUPABASE_STORAGE_BUCKET_PREFIX=https://your-project-id.supabase.co/storage/v1/object/public/media/

# ── Google Cloud Vision API ───────────────────────────────────────────────────
# Option A: Path to a service-account JSON key file (dev/local)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# Option B: On Cloud Run with Workload Identity, omit GOOGLE_APPLICATION_CREDENTIALS
# and assign the "Cloud Vision API User" IAM role to the Cloud Run service account.

# Your GCP project ID (used for Vision API client init)
GCLOUD_PROJECT_ID=your-gcp-project-id

# ── Firebase Cloud Messaging (FCM) ────────────────────────────────────────────
# Used exclusively for mobile push delivery (FCM v1).
# Option A: Path to service account JSON, or raw JSON string, or base64 JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=your-firebase-service-account-key-json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Option B: On Cloud Run with Workload Identity or GOOGLE_APPLICATION_CREDENTIALS,
# the Firebase Admin SDK can use Application Default Credentials automatically.

# ── Worker Tuning ─────────────────────────────────────────────────────────────
# Number of jobs processed concurrently per queue (default: 3)
WORKER_CONCURRENCY=3

# Maximum Vision API retries before job moves to failed state (default: 3)
VISION_MAX_RETRIES=3

# Maximum FCM Push Delivery retries (default: 3)
PUSH_MAX_RETRIES=3

NODE_ENV=development
