# ==============================================================================
# THE REAL-TIME WEBSOCKET ENGINE CONFIGURATION
# Copy this file to .env or supply these variables in your deployment environment.
# NEVER commit real credentials to version control!
# ==============================================================================

# Server Port (Default: 8081)
PORT=8081

# Allowed Origins (comma-separated, or leave empty for permissive dev mode)
# Example: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Supabase Authentication (GoTrue) — replaces the Firebase Admin SDK
# ------------------------------------------------------------------------------
# Asymmetric ES256 tokens are verified using the project's public keys fetched
# from the JWKS endpoint (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
# Legacy HS256 tokens signed with SUPABASE_JWT_SECRET are also supported.
# The `anon` / `service_role` API keys are rejected via SUPABASE_REQUIRED_ROLE
# (default: `authenticated`) to keep API keys out of user sessions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# SUPABASE_ALLOW_LEGACY_HS256=true
# SUPABASE_REQUIRED_ROLE=authenticated

# ------------------------------------------------------------------------------
# Database Connection (Optional / Forward-Compatible)
# Matches the PostgreSQL/PostGIS configuration of the NestJS API backend.
# Session pooler on 5432 — the password must be URL-encoded.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
