# ========================================================
# YoUnMe API Backend — Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# NEVER commit real credentials to version control!
# ========================================================

PORT=8080
NODE_ENV=development

# --------------------------------------------------------
# Firebase Admin SDK Configuration
# --------------------------------------------------------
# Option 1: Explicit Service Account Credentials (recommended)
FIREBASE_PROJECT_ID=younme-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@younme-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to Google Application Default Credentials JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
