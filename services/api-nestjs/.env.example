# ==============================================================================
# YoUnMe API Backend — Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# NEVER commit real credentials to version control!
# ==============================================================================

PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------
# Supabase Authentication (GoTrue) — replaces Firebase Auth
# ------------------------------------------------------------------
# SUPABASE_JWT_SECRET signs every user access token (HS256). Verification
# accepts only `role: authenticated` tokens, so the anon and service_role
# API keys can never be used as a Bearer token.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# SUPABASE_REQUIRED_ROLE=authenticated

# ------------------------------------------------------------------
# Supabase PostgreSQL connection (session pooler on port 5432)
# The password must be URL-encoded (e.g. '@' -> %40).
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres
