# Multi-stage Dockerfile for NestJS on Google Cloud Run (asia-south1)
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json tsconfig.json ./
RUN npm ci
COPY src ./src
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY --from=builder /app/dist ./dist

EXPOSE 8080
ENV PORT=8080
ENV NODE_ENV=production

CMD ["npm", "start"]
</file>

<file path="inspect-meetup.mjs">
import pg from 'pg';
import dotenv from 'dotenv';
dotenv.config();

const { Pool } = pg;
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false },
});

async function main() {
  try {
    const cols = await pool.query(`
      SELECT column_name, data_type, udt_name 
      FROM information_schema.columns 
      WHERE table_name = 'meetup' 
      ORDER BY ordinal_position
    `);
    console.log('MEETUP COLS:');
    for (const c of cols.rows) {
      console.log(` - ${c.column_name} (${c.data_type} / ${c.udt_name})`);
    }

    const cons = await pool.query(`
      SELECT conname, pg_get_constraintdef(c.oid) as def 
      FROM pg_constraint c 
      WHERE conrelid = 'meetup'::regclass
    `);
    console.log('\nMEETUP CONSTRAINTS:');
    for (const cn of cons.rows) {
      console.log(` - ${cn.conname}: ${cn.def}`);
    }

    const dateMemoriesCols = await pool.query(`
      SELECT column_name, data_type, udt_name 
      FROM information_schema.columns 
      WHERE table_name = 'date_memories' 
      ORDER BY ordinal_position
    `);
    console.log('\nDATE_MEMORIES COLS:');
    for (const c of dateMemoriesCols.rows) {
      console.log(` - ${c.column_name} (${c.data_type} / ${c.udt_name})`);
    }

    const walletCons = await pool.query(`
      SELECT conname, pg_get_constraintdef(c.oid) as def 
      FROM pg_constraint c 
      WHERE conrelid = 'wallet_transactions'::regclass
    `);
    console.log('\nWALLET_TRANSACTIONS CONSTRAINTS:');
    for (const c of walletCons.rows) {
      console.log(` - ${c.conname}: ${c.def}`);
    }

  } catch (e) {
    console.error('ERROR:', e.message);
  } finally {
    await pool.end();
  }
}

main();
</file>

<file path="jest.config.cjs">
/**
 * Jest configuration for the YoUnMe NestJS API.
 * Sources are ESM-style TypeScript (package "type": "module", NodeNext,
 * .js import suffixes), so tests run through Jest's native ESM loader
 * (enabled via --experimental-vm-modules in the npm test script) and
 * relative .js suffixes are mapped back to their .ts sources.
 */
module.exports = {
  testEnvironment: 'node',
  roots: ['<rootDir>/src'],
  testMatch: ['**/*.spec.ts'],
  moduleFileExtensions: ['ts', 'js', 'json'],
  extensionsToTreatAsEsm: ['.ts'],
  transform: {
    '^.+\\.ts$': [
      'ts-jest',
      {
        tsconfig: '<rootDir>/tsconfig.spec.json',
        useESM: true,
        // TS151002: hybrid module kind (NodeNext) requires isolatedModules.
        // The suite intentionally keeps full type-checking, so the advisory is ignored.
        diagnostics: { ignoreCodes: [151002] },
      },
    ],
  },
  moduleNameMapper: {
    '^(\\.{1,2}/.*)\\.js$': '$1',
  },
};
</file>

<file path="migrate-meetup.mjs">
import pg from 'pg';
import dotenv from 'dotenv';
dotenv.config();

const { Pool } = pg;
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false },
});

async function main() {
  try {
    console.log('Running migration on meetup table...');
    await pool.query(`ALTER TABLE meetup ADD COLUMN IF NOT EXISTS theme_id VARCHAR(32) DEFAULT 'default'`);
    await pool.query(`ALTER TABLE meetup DROP CONSTRAINT IF EXISTS meetup_status_check`);
    await pool.query(`ALTER TABLE meetup ADD CONSTRAINT meetup_status_check CHECK (status IN ('pending', 'scheduled', 'completed', 'cancelled', 'declined', 'missed', 'reported'))`);
    await pool.query(`ALTER TABLE meetup ALTER COLUMN status SET DEFAULT 'pending'`);
    console.log('✅ MEETUP TABLE MIGRATED SUCCESSFULLY!');

    const cons = await pool.query(`
      SELECT conname, pg_get_constraintdef(c.oid) as def 
      FROM pg_constraint c 
      WHERE conrelid = 'meetup'::regclass AND conname = 'meetup_status_check'
    `);
    console.log('New constraint:', cons.rows[0]);
  } catch (err) {
    console.error('Migration failed:', err.message);
  } finally {
    await pool.end();
  }
}

main();
</file>

