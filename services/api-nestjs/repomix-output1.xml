/**
 * YoUnMe Dating App — In-Memory Database Adapter
 * Mirrors the 24-table PostgreSQL schema (v3.2) for local dev / fallback mode.
 * Table mapping:
 *   app_users           → AppUser
 *   user_profiles       → UserProfile
 *   swipes_interactions → SwipeInteraction
 *   matches             → Match
 *   chat_rooms          → ChatRoom
 *   chat_messages       → ChatMessage
 *   user_wallets        → UserWallet
 *   wallet_transactions → WalletTransaction
 */

// ==========================================
// 1. app_users
// ==========================================
export interface AppUser {
  id: string;
  authentication_uid: string;              // Supabase Auth UID
  email: string;
  email_verified: boolean;
  phone_country_code: string;
  phone_number: string;
  full_phone_number: string;
  phone_verified: boolean;
  google_sso_id?: string;
  apple_sso_id?: string;
  password_hash?: string;
  account_status: 'active' | 'deactivated' | 'restricted' | 'suspended' | 'deletion_pending' | 'deleted';
  deactivation_reason?: string;
  deletion_reason?: string;
  deactivated_at?: string;
  deletion_scheduled_at?: string;
  reactivate_after?: string;
  role: 'user' | 'moderator' | 'admin';
  referral_code?: string;
  referred_by_user_id?: string;
  created_at: string;
  updated_at: string;
  deleted_at?: string;
}

// ==========================================
// 2. user_profiles
// ==========================================
export interface UserProfile {
  user_id: string;
  first_name?: string;
  nickname: string;
  date_of_birth?: string;
  gender?: 'male' | 'female' | 'non_binary' | 'other';
  sexual_orientations: string[];
  looking_for: string[];
  languages: string[];
  interests: string[];
  bio?: string;
  profession?: string;
  education?: string;
  city?: string;
  country_code?: string;
  avatar_object_key?: string;
  random_avatar_object_key?: string;
  app_language: string;
  app_theme: string;
